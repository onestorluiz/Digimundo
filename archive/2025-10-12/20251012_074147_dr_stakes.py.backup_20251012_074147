    def _calculate_overall_stakes_quality(self, profile: StakesProfile) -> float:
        """Calculate overall stakes quality score."""
        scores = [
            1.0 if profile.stakes_clear else 0.3,
            1.0 if profile.stakes_established_early else 0.5,
            1.0 if profile.personal_stakes_present else 0.4,
            1.0 if profile.external_stakes_present else 0.7,  # Not always needed
            1.0 if profile.emotional_stakes_present else 0.6,
            profile.stakes_escalation,
            1.0 if profile.life_death_stakes else 0.7,  # Not always needed
            1.0 if profile.stakes_consequences_clear else 0.4,
            profile.audience_investment,
            1.0 if profile.stakes_reinforced else 0.6,
            1.0 if profile.stakes_maximized_at_climax else 0.4,
            0.0 if profile.low_stakes_detected else 1.0,  # PENALTY
            0.0 if profile.unclear_stakes_detected else 1.0,  # PENALTY
            0.0 if profile.non_escalating_stakes else 1.0  # PENALTY
        ]

        # Average
        overall = sum(scores) / len(scores)

        return max(0.0, min(1.0, overall))

    def _check_stakes_rules(self, profile: StakesProfile, stakes_clear: Dict,
                           stakes_early: Dict, personal_stakes: Dict,
                           external_stakes: Dict, emotional_stakes: Dict,
                           stakes_escalation: Dict, life_death_stakes: Dict,
                           consequences: Dict, audience_investment: Dict,
                           stakes_reinforced: Dict, climax_stakes: Dict,
                           low_stakes: Dict, unclear_stakes: Dict,
                           non_escalating: Dict) -> List[Dict]:
        """Check stakes against rules."""
        violations = []

        for rule in self.rules.get("rules", []):
            if rule["id"] == "STAKES.R001":
                # Stakes Clear
                if not profile.stakes_clear:
                    violations.append({
                        "rule_id": rule["id"],
                        "title": rule["title"],
                        "severity": rule["severity"],
                        "message": "Stakes unclear - audience doesn't know what's at risk",
                        "fix": rule["fix"]
                    })

            elif rule["id"] == "STAKES.R002":
                # Stakes Established Early
                if not profile.stakes_established_early:
                    violations.append({
                        "rule_id": rule["id"],
                        "title": rule["title"],
                        "severity": rule["severity"],
                        "message": "Stakes not established in first 15-20 pages",
                        "fix": rule["fix"]
                    })

            elif rule["id"] == "STAKES.R003":
                # Personal Stakes Present
                if not profile.personal_stakes_present:
                    violations.append({
                        "rule_id": rule["id"],
                        "title": rule["title"],
                        "severity": rule["severity"],
                        "message": "Personal stakes weak - protagonist has little personal investment",
                        "fix": rule["fix"]
                    })

            elif rule["id"] == "STAKES.R004":
                # Emotional Stakes Present
                if not profile.emotional_stakes_present:
                    violations.append({
                        "rule_id": rule["id"],
                        "title": rule["title"],
                        "severity": rule["severity"],
                        "message": "Emotional stakes weak - relationships not at risk",
                        "fix": rule["fix"]
                    })

            elif rule["id"] == "STAKES.R005":
                # Stakes Escalation
                if profile.stakes_escalation < 0.5:
                    violations.append({
                        "rule_id": rule["id"],
                        "title": rule["title"],
                        "severity": rule["severity"],
                        "message": f"Stakes escalation weak ({profile.stakes_escalation:.1f}/1.0) - stakes not progressively raised",
                        "fix": rule["fix"]
                    })

            elif rule["id"] == "STAKES.R006":
                # Consequences Clear
                if not profile.stakes_consequences_clear:
                    violations.append({
                        "rule_id": rule["id"],
                        "title": rule["title"],
                        "severity": rule["severity"],
                        "message": "Consequences unclear - audience doesn't know what happens if protagonist fails",
                        "fix": rule["fix"]
                    })

            elif rule["id"] == "STAKES.R007":
                # Audience Investment
                if profile.audience_investment < 0.5:
                    violations.append({
                        "rule_id": rule["id"],
                        "title": rule["title"],
                        "severity": rule["severity"],
                        "message": f"Audience investment low ({profile.audience_investment:.1f}/1.0) - protagonist doesn't care enough",
                        "fix": rule["fix"]
                    })

            elif rule["id"] == "STAKES.R008":
                # Stakes Reinforced
                if not profile.stakes_reinforced:
                    violations.append({
                        "rule_id": rule["id"],
                        "title": rule["title"],
                        "severity": rule["severity"],
                        "message": "Stakes not reinforced throughout - audience forgets what's at risk",
                        "fix": rule["fix"]
                    })

            elif rule["id"] == "STAKES.R009":
                # Stakes Maximized at Climax
                if not profile.stakes_maximized_at_climax:
                    violations.append({
                        "rule_id": rule["id"],
                        "title": rule["title"],
                        "severity": rule["severity"],
                        "message": "Stakes not maximized at climax - everything should be at risk",
                        "fix": rule["fix"]
                    })

            elif rule["id"] == "STAKES.R010":
                # Avoid Low Stakes
                if profile.low_stakes_detected:
                    violations.append({
                        "rule_id": rule["id"],
                        "title": rule["title"],
                        "severity": rule["severity"],
                        "message": "Low stakes detected - nothing meaningful at risk",
                        "fix": rule["fix"]
                    })

            elif rule["id"] == "STAKES.R011":
                # Avoid Unclear Stakes
                if profile.unclear_stakes_detected:
                    violations.append({
                        "rule_id": rule["id"],
                        "title": rule["title"],
                        "severity": rule["severity"],
                        "message": "Unclear stakes detected - audience doesn't know what's at risk",
                        "fix": rule["fix"]
                    })

            elif rule["id"] == "STAKES.R012":
                # Avoid Non-Escalating Stakes
                if profile.non_escalating_stakes:
                    violations.append({
                        "rule_id": rule["id"],
                        "title": rule["title"],
                        "severity": rule["severity"],
                        "message": "Non-escalating stakes - stakes remain flat throughout",
                        "fix": rule["fix"]
                    })

            elif rule["id"] == "STAKES.R013":
                # Multiple Stakes Layers
                layers = sum([
                    profile.personal_stakes_present,
                    profile.external_stakes_present,
                    profile.emotional_stakes_present
                ])
                if layers < 2:
                    violations.append({
                        "rule_id": rule["id"],
                        "title": rule["title"],
                        "severity": rule["severity"],
                        "message": f"Limited stakes layers ({layers}/3) - needs personal + emotional + external",
                        "fix": rule["fix"]
                    })

            elif rule["id"] == "STAKES.R014":
                # Stakes Proportional to Genre
                # Genre-specific check would require genre detection
                pass

            elif rule["id"] == "STAKES.R015":
                # External Stakes (if applicable)
                # Optional check - not all stories need external stakes
                pass

        return violations

    def _calculate_stakes_score(self, profile: StakesProfile, violations: List) -> float:
        """Calculate overall stakes score."""
        # Start at 90
        score = 90.0

        # Deduct for violations
        for violation in violations:
            if violation["severity"] == "critical":
                score -= 20
            elif violation["severity"] == "high":
                score -= 15
            elif violation["severity"] == "medium":
                score -= 8
            elif violation["severity"] == "low":
                score -= 5

        # Extra penalty for major issues
        if profile.low_stakes_detected:
            score -= 25  # critical penalty
        if profile.unclear_stakes_detected:
            score -= 20  # major penalty
        if profile.non_escalating_stakes:
            score -= 15

        # Bonus for excellence
        if profile.overall_stakes_quality > 0.85:
            score += 5
        elif profile.overall_stakes_quality > 0.75:
            score += 3

        if profile.stakes_clear and profile.stakes_established_early:
            score += 3

        if profile.stakes_escalation > 0.8:
            score += 3

        if profile.audience_investment > 0.8:
            score += 2

        if profile.stakes_maximized_at_climax:
            score += 2

        # Cap at 95
        return max(5.0, min(95.0, score))

    def _generate_diagnosis(self, score: float, profile: StakesProfile,
                          violations: List) -> str:
        """Generate stakes diagnosis summary."""
        if score >= 80:
            level = "EXCELLENT"
            summary = "Stakes clear and escalating with strong audience investment"
        elif score >= 60:
            level = "GOOD"
            summary = "Stakes present but could escalate more"
        elif score >= 40:
            level = "NEEDS WORK"
            summary = "Stakes problems - unclear or not escalating"
        else:
            level = "POOR"
            summary = "Major stakes problems - low stakes or flat"

        diagnosis = f"STAKES {level} ({score:.1f}/100): {summary}"

        # Add specific issues
        issues = []
        if not profile.stakes_clear:
            issues.append("unclear stakes")
        if not profile.stakes_established_early:
            issues.append("late stakes")
        if profile.low_stakes_detected:
            issues.append("low stakes")
        if profile.unclear_stakes_detected:
            issues.append("confusing")
        if profile.non_escalating_stakes:
            issues.append("flat stakes")
        if profile.stakes_escalation < 0.5:
            issues.append("weak escalation")

        if issues:
            diagnosis += f". Key issues: {', '.join(issues)}"

        return diagnosis

    def _generate_recommendations(self, score: float, violations: List,
                                 profile: StakesProfile) -> List[str]:
        """Generate specific stakes recommendations."""
        recommendations = []

        # Add recommendations based on violations
        for violation in violations[:3]:
            recommendations.append(f"[{violation['severity'].upper()}] {violation['fix']}")

        # Add specific recommendations
        if not profile.stakes_clear:
            recommendations.append("Clarify stakes - McKee/Field: 'Stakes must be clear - what does protagonist stand to lose/gain?' - establish what's at risk")

        if not profile.stakes_established_early:
            recommendations.append("Establish stakes early - Field: 'Stakes must be clear in first 15-20 pages' - don't wait to reveal what's at risk")

        if profile.low_stakes_detected:
            recommendations.append("Raise stakes - McKee: 'Nothing meaningful at risk = audience doesn't care' - increase consequences of failure")

        if profile.non_escalating_stakes:
            recommendations.append("Escalate stakes - Field: 'Stakes must progressively raise' - make things worse through Act 2, maximize at climax")

        if profile.audience_investment < 0.5:
            recommendations.append("Increase protagonist investment - McKee: 'Audience cares because protagonist cares' - show protagonist's deep personal investment")

        if not profile.stakes_maximized_at_climax:
            recommendations.append("Maximize stakes at climax - McKee: 'Everything protagonist has should be at risk at climax' - all or nothing moment")

        # General excellence recommendations
        if score < 40:
            recommendations.append("Study McKee's Story - stakes and consequences fundamental")
            recommendations.append("Study Field's Screenplay - stakes escalation essential")

        return recommendations[:5]

    def export_stakes_features(self, screenplay_text: str) -> Dict[str, Any]:
        """
        Export stakes features for correlation/analysis.

        Returns structured data with stakes metrics.
        """
        page_count = self._estimate_page_count(screenplay_text)
        opening_text = self._extract_pages(screenplay_text, 0, 20)
        stakes_clear = self._analyze_stakes_clear(screenplay_text, opening_text)
        personal_stakes = self._analyze_personal_stakes(screenplay_text)

        return {
            "stakes": {
                "clear": stakes_clear["clear"],
                "personal_present": personal_stakes["present"]
            },
            "meta": {
                "source": "DrStakes",
                "focus": "Stakes clarity and escalation"
            }
        }


