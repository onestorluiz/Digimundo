    stakes_established_early: bool  # First 15-20 pages
    personal_stakes_present: bool  # What protagonist stands to lose/gain personally
    external_stakes_present: bool  # What world/others stand to lose/gain
    emotional_stakes_present: bool  # Relationships at risk
    stakes_escalation: float  # 0-1 (stakes progressively raised)
    life_death_stakes: bool  # Survival stakes (highest stakes)
    stakes_consequences_clear: bool  # What happens if protagonist fails
    audience_investment: float  # 0-1 (we care because protagonist cares)
    stakes_reinforced: bool  # Stakes reminded throughout
    stakes_maximized_at_climax: bool  # Everything at risk at climax
    low_stakes_detected: bool  # PENALTY (nothing meaningful at risk)
    unclear_stakes_detected: bool  # PENALTY (audience doesn't know what's at risk)
    non_escalating_stakes: bool  # PENALTY (flat stakes throughout)
    overall_stakes_quality: float


