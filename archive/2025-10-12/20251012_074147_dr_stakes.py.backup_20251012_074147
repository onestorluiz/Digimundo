    def _load_rules(self) -> Dict:
        """Load rules from YAML file."""
        if self.rules_path.exists():
            with open(self.rules_path, 'r') as f:
                return yaml.safe_load(f)
        return {}

    def analyze(self, screenplay_text: str) -> Dict[str, Any]:
        """
        Analyze stakes in screenplay.

        Args:
            screenplay_text: The full screenplay text

        Returns:
            Complete stakes diagnostic report
        """
        # Extract page count and scenes
        page_count = self._estimate_page_count(screenplay_text)
        scenes = self._extract_scenes(screenplay_text)

        # Extract opening (first 15-20 pages) for stakes establishment
        opening_text = self._extract_pages(screenplay_text, 0, 20)

        # Extract Act 2 for stakes escalation
        act2_text = self._extract_pages(screenplay_text, int(page_count * 0.25), int(page_count * 0.75))

        # Extract climax (last 15 pages) for stakes maximization
        climax_text = self._extract_pages(screenplay_text, max(0, page_count - 15), page_count)

        # Analyze stakes clear (what's at risk)
        stakes_clear = self._analyze_stakes_clear(screenplay_text, opening_text)

        # Analyze stakes established early (first 15-20 pages)
        stakes_early = self._analyze_stakes_established_early(opening_text)

        # Analyze personal stakes (protagonist personal loss/gain)
        personal_stakes = self._analyze_personal_stakes(screenplay_text)

        # Analyze external stakes (world-level consequences)
        external_stakes = self._analyze_external_stakes(screenplay_text)

        # Analyze emotional stakes (relationships at risk)
        emotional_stakes = self._analyze_emotional_stakes(screenplay_text)

        # Analyze stakes escalation (progressive raising)
        stakes_escalation = self._analyze_stakes_escalation(act2_text, screenplay_text)

        # Analyze life/death stakes (survival stakes)
        life_death_stakes = self._analyze_life_death_stakes(screenplay_text)

        # Analyze consequences clear (what happens if fail)
        consequences = self._analyze_consequences_clear(screenplay_text)

        # Analyze audience investment (we care because protagonist cares)
        audience_investment = self._analyze_audience_investment(screenplay_text)

        # Analyze stakes reinforced (reminded throughout)
        stakes_reinforced = self._analyze_stakes_reinforced(screenplay_text)

        # Analyze stakes maximized at climax (everything at risk)
        climax_stakes = self._analyze_climax_stakes(climax_text)

        # Detect low stakes (PENALTY - nothing meaningful at risk)
        low_stakes = self._detect_low_stakes(screenplay_text)

        # Detect unclear stakes (PENALTY - audience doesn't know what's at risk)
        unclear_stakes = self._detect_unclear_stakes(screenplay_text)

        # Detect non-escalating stakes (PENALTY - flat stakes throughout)
