    def _estimate_page_count(self, screenplay: str) -> int:
        """Estimate page count from screenplay text."""
        lines = screenplay.split('\n')
        return max(1, len(lines) // 55)

    def _extract_scenes(self, screenplay: str) -> List[Dict]:
        """Extract all scenes from screenplay."""
        scenes = []
        lines = screenplay.split('\n')
        current_scene = None
        scene_number = 0

        for i, line in enumerate(lines):
            # Detect scene heading
            if re.match(r'^(INT\.|EXT\.)', line.strip()):
                # Save previous scene
                if current_scene:
                    current_scene['end_line'] = i - 1
                    current_scene['end_page'] = (i - 1) // 55
                    scenes.append(current_scene)

                # Start new scene
                scene_number += 1
                current_scene = {
                    'number': scene_number,
                    'heading': line.strip(),
                    'start_line': i,
                    'start_page': i // 55,
                    'content': []
                }
            elif current_scene:
                current_scene['content'].append(line)

        # Add last scene
        if current_scene:
            current_scene['end_line'] = len(lines) - 1
            current_scene['end_page'] = (len(lines) - 1) // 55
            scenes.append(current_scene)

        return scenes

    def _extract_pages(self, screenplay: str, start_page: int, end_page: int) -> str:
        """Extract specific page range from screenplay."""
        lines = screenplay.split('\n')
        start_line = start_page * 55
        end_line = end_page * 55
        return '\n'.join(lines[start_line:end_line])

    def _analyze_stakes_clear(self, screenplay: str, opening_text: str) -> Dict[str, Any]:
        """
        Analyze stakes clarity (what's at risk).

        McKee/Field: "Stakes must be clear - audience knows what protagonist stands to lose/gain."
        """
        clear = False

        # Check for stakes clear markers
        stakes_count = 0
        for marker in self.stakes_clear_markers:
            stakes_count += screenplay.lower().count(marker)

        if stakes_count >= 5:
            clear = True
        elif stakes_count >= 3:
            clear = True

        return {
            "clear": clear,
            "count": stakes_count
        }

    def _analyze_stakes_established_early(self, opening_text: str) -> Dict[str, Any]:
        """
        Analyze stakes established early (first 15-20 pages).

        Field/Snyder: "Stakes must be established early - first 15-20 pages."
        """
        established = False
        description = ""

        # Check for stakes markers in opening
        opening_stakes_count = 0
        for marker in self.stakes_clear_markers:
            opening_stakes_count += opening_text.lower().count(marker)

        if opening_stakes_count >= 3:
            established = True
            description = "Stakes clearly established in opening"
        elif opening_stakes_count >= 2:
            established = True
            description = "Stakes established but could be clearer"
        else:
            description = "Stakes not established in opening"

        return {
            "established": established,
            "count": opening_stakes_count,
            "description": description
        }

