        """
        Flag information dumps (PENALTY).

        McKee: "Exposition is dullest of all screen tasks - never stop action to explain."
        """
        count = 0
        examples = []

        for line in screenplay.split('\n'):
            # Check for info dump patterns
            for marker in self.info_dump_markers:
                if marker in line.lower():
                    count += 1
                    if len(examples) < 5:
                        examples.append(line.strip()[:100])
                    break

        # Penalty if present
        penalty = count >= 1

        return {
            "count": count,
            "penalty": penalty,
            "examples": examples
        }

    def _analyze_integrated_exposition(self, screenplay: str) -> Dict[str, Any]:
        """
        Analyze exposition through action/conflict.

        McKee: "Exposition must be dramatic, not expositional - integrated into action."
        """
        count = 0
        examples = []

        for line in screenplay.split('\n'):
            for marker in self.integrated_expo_markers:
                if marker in line.lower():
                    count += 1
                    if len(examples) < 5:
                        examples.append(line.strip()[:100])
                    break

        # Calculate score (0-1)
        score = min(1.0, count / 5.0)

        integrated = score >= 0.4

        return {
            "score": score,
            "integrated": integrated,
            "count": count,
            "examples": examples
        }

    def _analyze_backstory_revelation(self, screenplay: str) -> Dict[str, Any]:
        """
        Analyze strategic timing of backstory.

        Truby: "Backstory ghost revelation strategic timing - not dumped."
        """
        # Count backstory markers
        count = 0
        for marker in self.backstory_markers:
            count += screenplay.lower().count(marker)

        # Check for strategic placement
        strategic_markers = ["strategic", "earned", "forced to reveal", "under pressure"]
        strategic_count = sum(1 for marker in strategic_markers if marker in screenplay.lower())

        strategic = strategic_count >= 2 or (count > 0 and count <= 8)

        # Determine timing quality
        if count == 0:
            timing = "absent"
        elif count <= 5:
            timing = "strategic"
        elif count <= 10 and strategic_count >= 1:
            timing = "good"
        else:
            timing = "dumped"

        return {
            "strategic": strategic,
            "timing": timing,
            "count": count
        }

    def _analyze_expositional_dialogue(self, screenplay: str) -> Dict[str, Any]:
        """
        Flag 'as you know' dialogue (PENALTY).

        McKee Dialogue: "Characters telling each other what they already know is amateur."
        """
        count = 0
        examples = []

        for line in screenplay.split('\n'):
            # Check for expositional dialogue patterns
            for marker in self.expositional_dialogue_markers:
                if marker in line.lower():
                    count += 1
                    if len(examples) < 5:
                        examples.append(line.strip()[:100])
                    break

        # Penalty if excessive
        penalty = count >= 3

        return {
            "count": count,
            "penalty": penalty,
            "examples": examples
        }

    def _analyze_visual_exposition(self, screenplay: str) -> Dict[str, Any]:
        """
        Analyze show don't tell.

        Seger/Mackendrick: "Visual exposition - show through action, environment, objects."
        """
        count = 0
        examples = []

        for line in screenplay.split('\n'):
            for marker in self.visual_exposition_markers:
                if marker in line.lower():
                    count += 1
                    if len(examples) < 5:
                        examples.append(line.strip()[:100])
                    break

        # Calculate score (0-1)
        score = min(1.0, count / 8.0)

        present = count >= 3

        return {
            "score": score,
            "present": present,
            "count": count,
            "examples": examples
        }

    def _analyze_setup_payoff(self, screenplay: str) -> Dict[str, Any]:
        """
        Analyze information planting.

        Field/Snyder: "Plant and payoff - setup information before needed."
        """
        plant_count = 0
        payoff_count = 0

        # Count plants and payoffs
        plant_markers = ["plant", "setup", "foreshadow", "establish"]
        payoff_markers = ["payoff", "callback", "pays off", "established earlier"]

        for marker in plant_markers:
            plant_count += screenplay.lower().count(marker)

        for marker in payoff_markers:
            payoff_count += screenplay.lower().count(marker)

        # Calculate ratio (ideally 1:1 or plants slightly higher)
        if plant_count == 0:
            ratio = 0.0
        else:
            ratio = min(1.0, payoff_count / plant_count)

        balanced = (plant_count >= 2 and payoff_count >= 2 and ratio >= 0.5)

        return {
            "ratio": ratio,
            "plant_count": plant_count,
            "payoff_count": payoff_count,
            "balanced": balanced
        }

    def _analyze_world_building(self, screenplay: str) -> Dict[str, Any]:
        """
        Analyze context and rules clarity.

        Snyder: "Opening image establishes world - world-building."
        """
        count = 0

        for marker in self.world_building_markers:
            count += screenplay.lower().count(marker)

        # Calculate clarity (0-1)
        clarity = min(1.0, count / 5.0)

        clear = clarity >= 0.4
        present = count >= 2

        return {
            "clarity": clarity,
            "clear": clear,
            "present": present,
            "count": count
        }

    def _analyze_exposition_timing(self, screenplay: str) -> Dict[str, Any]:
        """
        Analyze need-to-know basis.

        Truby: "Strategic timing - reveal when audience needs to know."
        """
        # Check for timing markers
        timing_markers = ["need-to-know", "strategic timing", "reveals when needed", "just in time"]
        count = sum(1 for marker in timing_markers if marker in screenplay.lower())

        # Calculate score (0-1)
        score = min(1.0, count / 3.0)

        appropriate = score >= 0.3 or count >= 2

        return {
            "score": score,
            "appropriate": appropriate,
            "count": count
        }

    def _detect_confusion_risk(self, screenplay: str) -> Dict[str, Any]:
        """
        Detect too little exposition.

        Risk: Audience confusion from insufficient context.
        """
        count = 0

        for marker in self.confusion_markers:
            count += screenplay.lower().count(marker)

        # Risk if confusion markers present
        risk = count >= 3

        if count >= 5:
            severity = "high"
        elif count >= 3:
            severity = "medium"
        else:
            severity = "none"

        return {
            "risk": risk,
            "severity": severity,
            "count": count
        }

    def _detect_over_exposition(self, screenplay: str) -> Dict[str, Any]:
        """
        Detect too much exposition.

        Risk: Pacing drag from over-explanation.
        """
        # Count exposition-heavy indicators
        over_markers = ["too much", "over-explained", "explains everything", "stops to explain"]
        count = sum(1 for marker in over_markers if marker in screenplay.lower())

        # Also check total exposition moments
        total_expo = sum(1 for marker in self.exposition_markers if marker in screenplay.lower())

        # Risk if excessive
        risk = count >= 2 or total_expo > 20

        if count >= 3 or total_expo > 25:
            severity = "high"
        elif count >= 2 or total_expo > 20:
            severity = "medium"
        else:
            severity = "none"

        return {
            "risk": risk,
            "severity": severity,
            "count": count
        }

    def _analyze_earned_revelation(self, screenplay: str) -> Dict[str, Any]:
        """
        Analyze backstory earned through tension.

        McKee: "Backstory revealed when protagonist forced to confront past."
        """
        count = 0
        examples = []

        for line in screenplay.split('\n'):
            for marker in self.earned_revelation_markers:
                if marker in line.lower():
                    count += 1
                    if len(examples) < 5:
                        examples.append(line.strip()[:100])
                    break

        # Calculate score (0-1)
        score = min(1.0, count / 4.0)

        earned = score >= 0.5 or count >= 2

        return {
            "score": score,
            "earned": earned,
            "count": count,
            "examples": examples
        }

    def _assess_exposition_balance(self, screenplay: str) -> Dict[str, Any]:
        """
        Assess clarity vs mystery.

        McKee: "Balance between confusion and over-explanation."
        """
        # Count clarity indicators
        clarity_markers = ["clear", "understands", "establishes", "explains"]
        clarity_count = sum(1 for marker in clarity_markers if marker in screenplay.lower())

        # Count mystery indicators
        mystery_markers = ["mystery", "unknown", "hidden", "secret", "withholds"]
        mystery_count = sum(1 for marker in mystery_markers if marker in screenplay.lower())

        # Calculate balance (0-1, closer to 0.5 is better)
        total = clarity_count + mystery_count
        if total == 0:
            balance = 0.0
        else:
            # Ideal ratio is roughly 60/40 clarity/mystery
            clarity_ratio = clarity_count / total
            # Score closer to 0.6 is better
            balance = 1.0 - abs(clarity_ratio - 0.6)

        balanced = balance >= 0.5

        return {
            "balance": balance,
            "balanced": balanced,
            "clarity_count": clarity_count,
            "mystery_count": mystery_count
        }

    def _assess_exposition_pacing(self, screenplay: str, scenes: List[Dict]) -> Dict[str, Any]:
        """
        Assess impact on story flow.

        McKee: "Exposition is dullest of all screen tasks - minimize."
        """
        if not scenes:
            return {
                "score": 0.5,
                "impact": "neutral"
            }

        # Count exposition per scene
        expo_per_scene = []
        for scene in scenes:
            scene_text = '\n'.join(scene['content'])
            expo_count = sum(1 for marker in self.exposition_markers if marker in scene_text.lower())
            expo_per_scene.append(expo_count)

        # Calculate average
        avg_expo = sum(expo_per_scene) / len(expo_per_scene) if expo_per_scene else 0

        # Score based on average (0-2 is good, 3-5 is moderate, 6+ is drag)
        if avg_expo <= 2:
            score = 0.9
            impact = "minimal"
        elif avg_expo <= 5:
            score = 0.6
            impact = "moderate"
        else:
            score = 0.3
            impact = "drags"

        return {
            "score": score,
            "impact": impact,
            "avg_expo_per_scene": avg_expo
        }

    def _assess_audience_understanding(self, screenplay: str) -> Dict[str, Any]:
        """
        Assess information sufficiency.

        Fundamental: Audience must understand story.
        """
        # Count understanding indicators
        understanding_markers = [
            "clear motivation", "clear stakes", "understands", "context established",
            "audience knows", "establishes", "makes clear"
        ]
        count = sum(1 for marker in understanding_markers if marker in screenplay.lower())

        # Count confusion indicators (negative)
        confusion_count = sum(1 for marker in self.confusion_markers if marker in screenplay.lower())

        # Calculate score (0-1)
        positive = count
        negative = confusion_count
        score = min(1.0, max(0.0, (positive - negative) / 5.0))

        sufficient = score >= 0.4 and confusion_count < 3

        return {
            "score": score,
            "sufficient": sufficient,
            "understanding_count": count,
            "confusion_count": confusion_count
        }

    def _analyze_show_vs_tell(self, screenplay: str) -> Dict[str, Any]:
        """
        Analyze show vs tell ratio.

        Seger: "Show don't tell - visual medium demands visual exposition."
        """
        show_count = sum(1 for marker in self.show_markers if marker in screenplay.lower())
        tell_count = sum(1 for marker in self.tell_markers if marker in screenplay.lower())

        # Calculate ratio (show / total, higher is better)
        total = show_count + tell_count
        if total == 0:
            ratio = 0.5
        else:
            ratio = show_count / total

        shows_more = ratio >= 0.6

        return {
            "ratio": ratio,
            "shows_more": shows_more,
            "show_count": show_count,
            "tell_count": tell_count
        }

    def _analyze_exposition_through_conflict(self, screenplay: str) -> Dict[str, Any]:
        """
        Analyze exposition revealed through conflict.

        McKee: "Exposition through conflict not narration."
        """
        count = 0

        for marker in self.through_conflict_markers:
            count += screenplay.lower().count(marker)

        # Calculate score (0-1)
        score = min(1.0, count / 5.0)

        present = count >= 2

        return {
            "score": score,
            "present": present,
            "count": count
        }

    def _calculate_overall_exposition_quality(self, profile: ExpositionProfile) -> float:
        """Calculate overall exposition quality score."""
        scores = [
            1.0 if profile.exposition_moments_count >= 3 else 0.0,
            max(0.0, 1.0 - (profile.info_dump_count * 0.3)),  # PENALTY for info dumps
            profile.integrated_exposition_score,
            1.0 if profile.backstory_strategic else 0.5,
            max(0.0, 1.0 - (profile.expositional_dialogue_count * 0.2)),  # PENALTY
            profile.visual_exposition_score,
            profile.setup_payoff_ratio,
            profile.world_building_clarity,
            profile.need_to_know_timing_score,
            0.0 if profile.confusion_risk else 1.0,
            0.0 if profile.over_exposition_risk else 1.0,
            profile.earned_revelation_score,
            profile.clarity_vs_mystery_balance,
            profile.exposition_pacing_score,
            profile.audience_understanding_score,
            profile.show_vs_tell_ratio,
            profile.exposition_through_conflict_score
        ]

        # Average
        overall = sum(scores) / len(scores)

        return max(0.0, min(1.0, overall))

    def _calculate_exposition_richness(self, profile: ExpositionProfile) -> float:
        """Calculate exposition richness (variety of techniques used)."""
        techniques_used = 0

        if profile.exposition_moments_count >= 3:
            techniques_used += 1
        if profile.integrated_exposition_score >= 0.4:
            techniques_used += 1
        if profile.backstory_strategic:
            techniques_used += 1
        if profile.visual_exposition_score >= 0.4:
            techniques_used += 1
        if profile.setup_payoff_ratio >= 0.5:
            techniques_used += 1
        if profile.world_building_clarity >= 0.4:
            techniques_used += 1
        if profile.earned_revelation_score >= 0.5:
            techniques_used += 1
        if profile.clarity_vs_mystery_balance >= 0.5:
            techniques_used += 1
        if profile.show_vs_tell_ratio >= 0.6:
            techniques_used += 1
        if profile.exposition_through_conflict_score >= 0.4:
            techniques_used += 1

        # Richness = variety of techniques (0-1)
        richness = techniques_used / 10.0

        return max(0.0, min(1.0, richness))

    def _check_exposition_rules(self, profile: ExpositionProfile, exposition_moments: Dict,
                                info_dumps: Dict, expositional_dialogue: Dict,
                                integrated_exposition: Dict, backstory_revelation: Dict,
                                visual_exposition: Dict, earned_revelation: Dict,
                                exposition_balance: Dict, exposition_pacing: Dict,
                                audience_understanding: Dict) -> List[Dict]:
        """Check exposition against rules."""
        violations = []

        for rule in self.rules.get("rules", []):
            if rule["id"] == "EXPO.R001":
                # Exposition Present
                if profile.exposition_moments_count < 3:
                    violations.append({
                        "rule_id": rule["id"],
                        "title": rule["title"],
                        "severity": rule["severity"],
                        "message": "Essential exposition missing - audience confusion",
                        "fix": rule["fix"]
                    })

            elif rule["id"] == "EXPO.R002":
                # Avoid Info Dumps
                if profile.info_dump_count >= 1:
                    violations.append({
                        "rule_id": rule["id"],
                        "title": rule["title"],
                        "severity": rule["severity"],
                        "message": f"Info dumps present ({profile.info_dump_count}) - stops action to explain",
                        "fix": rule["fix"]
                    })

            elif rule["id"] == "EXPO.R003":
                # Integrated Exposition
                if profile.integrated_exposition_score < 0.4:
                    violations.append({
                        "rule_id": rule["id"],
                        "title": rule["title"],
                        "severity": rule["severity"],
                        "message": "Exposition not integrated - isolated from action",
                        "fix": rule["fix"]
                    })

            elif rule["id"] == "EXPO.R004":
                # Backstory Strategic
                if not profile.backstory_strategic:
                    violations.append({
                        "rule_id": rule["id"],
                        "title": rule["title"],
                        "severity": rule["severity"],
                        "message": "Backstory not strategic - dumped early or all at once",
                        "fix": rule["fix"]
                    })

            elif rule["id"] == "EXPO.R005":
                # Show Don't Tell
                if profile.show_vs_tell_ratio < 0.5:
                    violations.append({
                        "rule_id": rule["id"],
                        "title": rule["title"],
                        "severity": rule["severity"],
                        "message": "Too much telling - relies on dialogue/narration",
                        "fix": rule["fix"]
                    })

            elif rule["id"] == "EXPO.R006":
                # Exposition Through Conflict
                if profile.exposition_through_conflict_score < 0.4:
                    violations.append({
                        "rule_id": rule["id"],
                        "title": rule["title"],
                        "severity": rule["severity"],
                        "message": "Exposition without conflict - flat delivery",
                        "fix": rule["fix"]
                    })

            elif rule["id"] == "EXPO.R007":
                # Avoid Expositional Dialogue
                if profile.expositional_dialogue_count >= 3:
                    violations.append({
                        "rule_id": rule["id"],
                        "title": rule["title"],
                        "severity": rule["severity"],
                        "message": f"Expositional dialogue present ({profile.expositional_dialogue_count}) - 'as you know' dialogue",
                        "fix": rule["fix"]
                    })

            elif rule["id"] == "EXPO.R008":
                # Plant and Payoff
                if profile.setup_payoff_ratio < 0.3 or profile.plant_count < 2:
                    violations.append({
                        "rule_id": rule["id"],
                        "title": rule["title"],
                        "severity": rule["severity"],
                        "message": "Insufficient plant/payoff - information not setup",
                        "fix": rule["fix"]
                    })

            elif rule["id"] == "EXPO.R009":
                # World-Building Clarity
                if profile.world_building_clarity < 0.3:
                    violations.append({
                        "rule_id": rule["id"],
                        "title": rule["title"],
                        "severity": rule["severity"],
                        "message": "World-building unclear - rules confusing",
                        "fix": rule["fix"]
                    })

            elif rule["id"] == "EXPO.R010":
                # Need-to-Know Timing
                if profile.need_to_know_timing_score < 0.3:
                    violations.append({
                        "rule_id": rule["id"],
                        "title": rule["title"],
                        "severity": rule["severity"],
                        "message": "Information timing poor - revealed too early or too late",
                        "fix": rule["fix"]
                    })

            elif rule["id"] == "EXPO.R011":
                # Visual Exposition
                if profile.visual_exposition_score < 0.3:
                    violations.append({
                        "rule_id": rule["id"],
                        "title": rule["title"],
                        "severity": rule["severity"],
                        "message": "Visual exposition weak - relies on dialogue",
                        "fix": rule["fix"]
                    })

            elif rule["id"] == "EXPO.R012":
                # Earned Revelation
                if profile.earned_revelation_score < 0.5:
                    violations.append({
                        "rule_id": rule["id"],
                        "title": rule["title"],
                        "severity": rule["severity"],
                        "message": "Backstory not earned - revealed arbitrarily",
                        "fix": rule["fix"]
                    })

            elif rule["id"] == "EXPO.R013":
                # Balance Clarity vs Mystery
                if profile.clarity_vs_mystery_balance < 0.4:
                    violations.append({
                        "rule_id": rule["id"],
                        "title": rule["title"],
                        "severity": rule["severity"],
                        "message": "Imbalance - too much or too little exposition",
                        "fix": rule["fix"]
                    })

            elif rule["id"] == "EXPO.R014":
                # Exposition Pacing
                if profile.exposition_pacing_score < 0.4:
                    violations.append({
                        "rule_id": rule["id"],
                        "title": rule["title"],
                        "severity": rule["severity"],
                        "message": "Exposition drags pacing - slows story momentum",
                        "fix": rule["fix"]
                    })

            elif rule["id"] == "EXPO.R015":
                # Audience Understanding
                if profile.audience_understanding_score < 0.4 or profile.confusion_risk:
                    violations.append({
                        "rule_id": rule["id"],
                        "title": rule["title"],
                        "severity": rule["severity"],
                        "message": "Audience confusion risk - insufficient exposition",
                        "fix": rule["fix"]
                    })

        return violations

    def _calculate_exposition_score(self, profile: ExpositionProfile, violations: List) -> float:
        """Calculate overall exposition score."""
        # Start at 90
        score = 90.0

        # Deduct for violations
        for violation in violations:
            if violation["severity"] == "critical":
                score -= 20
            elif violation["severity"] == "high":
                score -= 15
            elif violation["severity"] == "medium":
                score -= 8
            elif violation["severity"] == "low":
                score -= 5

        # Extra penalty for info dumps
        if profile.info_dump_count >= 1:
            score -= profile.info_dump_count * 10  # -10 per info dump

        # Extra penalty for expositional dialogue
        if profile.expositional_dialogue_count >= 3:
            score -= (profile.expositional_dialogue_count - 2) * 3  # -3 per extra instance

        # Bonus for excellence
        if profile.overall_exposition_quality > 0.8:
            score += 5
        elif profile.overall_exposition_quality > 0.7:
            score += 3

        if profile.integrated_exposition_score > 0.7:
            score += 3

        if profile.visual_exposition_score > 0.6:
            score += 2

        if profile.backstory_strategic and profile.earned_revelation_score > 0.6:
            score += 3

        if profile.exposition_richness > 0.7:
            score += 2

        if profile.show_vs_tell_ratio > 0.7:
            score += 2

        # Cap at 95
        return max(5.0, min(95.0, score))

    def _generate_diagnosis(self, score: float, profile: ExpositionProfile,
                          violations: List) -> str:
        """Generate exposition diagnosis summary."""
        if score >= 80:
            level = "EXCELLENT"
            summary = "Exposition integrated dramatically - invisible and effective"
        elif score >= 60:
            level = "GOOD"
            summary = "Exposition present but could be better integrated"
        elif score >= 40:
            level = "NEEDS WORK"
            summary = "Exposition problems - info dumps or insufficient context"
        else:
            level = "POOR"
            summary = "Major exposition problems - stops action to explain or confusing"

        diagnosis = f"EXPOSITION {level} ({score:.1f}/100): {summary}"

        # Add specific issues
        issues = []
        if profile.info_dump_count >= 1:
            issues.append(f"info dumps ({profile.info_dump_count})")
        if profile.expositional_dialogue_count >= 3:
            issues.append(f"expositional dialogue ({profile.expositional_dialogue_count})")
        if not profile.backstory_strategic:
            issues.append("backstory dumped")
        if profile.confusion_risk:
            issues.append("audience confusion risk")
        if profile.over_exposition_risk:
            issues.append("over-exposition")

        if issues:
            diagnosis += f". Key issues: {', '.join(issues)}"

        return diagnosis

    def _generate_recommendations(self, score: float, violations: List,
                                 profile: ExpositionProfile) -> List[str]:
        """Generate specific exposition recommendations."""
        recommendations = []

        # Add recommendations based on violations
        for violation in violations[:3]:
            recommendations.append(f"[{violation['severity'].upper()}] {violation['fix']}")

        # Add specific recommendations
        if profile.info_dump_count >= 1:
            recommendations.append("Eliminate info dumps - McKee: 'Never stop action to explain' - spread information across scenes through conflict")

        if profile.expositional_dialogue_count >= 3:
            recommendations.append("Remove expositional dialogue - McKee: 'Characters telling each other what they know is amateur' - never 'as you know' dialogue")

        if not profile.backstory_strategic:
            recommendations.append("Reveal backstory strategically - Truby: 'Backstory ghost revelation strategic timing' - need-to-know basis")

        if profile.integrated_exposition_score < 0.4:
            recommendations.append("Integrate exposition into action - McKee: 'Exposition must be dramatic, not expositional' - reveal through conflict")

        if profile.visual_exposition_score < 0.3:
            recommendations.append("Use visual exposition - Seger/Mackendrick: 'Show don't tell' - visual medium demands visual storytelling")

        if profile.show_vs_tell_ratio < 0.5:
            recommendations.append("Show more, tell less - demonstrate through action rather than explaining through dialogue")

        if profile.earned_revelation_score < 0.5:
            recommendations.append("Earn revelations through tension - McKee: 'Backstory revealed when protagonist forced to confront past'")

        # General excellence recommendations
        if score < 40:
            recommendations.append("Study McKee's Story - exposition is necessary but must be dramatically integrated")
            recommendations.append("Study Seger's Making Good Script Great - exposition techniques, show don't tell")

        return recommendations[:5]

    def export_exposition_features(self, screenplay_text: str) -> Dict[str, Any]:
        """
        Export exposition features for correlation/analysis.

        Returns structured data with exposition metrics.
