    twist_present: bool  # Major revelation/reversal exists
    twist_effectiveness: bool  # Surprising yet inevitable (Aristotle)
    twist_timing: bool  # Optimal placement (Act 2 midpoint or Act 3)
    twist_setup: bool  # Properly foreshadowed, not random
    twist_impact: bool  # Changes everything, recontextualizes story
    red_herrings_present: bool  # Misdirection techniques used
    multiple_twists_handled: bool  # If multiple twists, each must land
    false_protagonist_twist: bool  # Psycho example - protagonist switch
    identity_twist: bool  # Character not who they seem
    reversal_of_fortune: bool  # Peripeteia (Aristotle)
