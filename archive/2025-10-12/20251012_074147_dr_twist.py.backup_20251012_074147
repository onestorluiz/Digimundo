    def _load_rules(self) -> Dict:
        """Load rules from YAML file."""
        if self.rules_path.exists():
            with open(self.rules_path, 'r') as f:
                return yaml.safe_load(f)
        return {}

    def analyze(self, screenplay_text: str) -> Dict[str, Any]:
        """
        Analyze twist and revelation in screenplay.

        Args:
            screenplay_text: The full screenplay text

        Returns:
            Complete twist diagnostic report
        """
        # Extract page count and scenes
        page_count = self._estimate_page_count(screenplay_text)
        scenes = self._extract_scenes(screenplay_text)

        # Extract Act 1 (first 25%)
        act1_text = self._extract_pages(screenplay_text, 0, int(page_count * 0.25))

        # Extract Act 2 (middle 50%)
        act2_text = self._extract_pages(screenplay_text, int(page_count * 0.25), int(page_count * 0.75))
        act2_midpoint_text = self._extract_pages(screenplay_text, int(page_count * 0.45), int(page_count * 0.55))

        # Extract Act 3 (final 25%)
        act3_text = self._extract_pages(screenplay_text, int(page_count * 0.75), page_count)

        # Analyze twist present (major revelation/reversal)
        twist_present = self._analyze_twist_present(screenplay_text)

        # Analyze twist effectiveness (surprising yet inevitable - Aristotle)
        twist_effectiveness = self._analyze_twist_effectiveness(screenplay_text)

        # Analyze twist timing (optimal placement)
        twist_timing = self._analyze_twist_timing(screenplay_text, page_count, act2_midpoint_text, act3_text)

        # Analyze twist setup (properly foreshadowed)
        twist_setup = self._analyze_twist_setup(screenplay_text, act1_text, act2_text)

        # Analyze twist impact (changes everything)
        twist_impact = self._analyze_twist_impact(screenplay_text)

        # Analyze red herrings (misdirection)
        red_herrings = self._analyze_red_herrings(screenplay_text)

        # Analyze multiple twists handling
        multiple_twists = self._analyze_multiple_twists(screenplay_text)

        # Analyze false protagonist twist (Psycho example)
        false_protagonist = self._analyze_false_protagonist(screenplay_text)

        # Analyze identity twist (character not who they seem)
        identity_twist = self._analyze_identity_twist(screenplay_text)

        # Analyze reversal of fortune (peripeteia - Aristotle)
        reversal_fortune = self._analyze_reversal_fortune(screenplay_text)

        # Analyze recognition moment (anagnorisis - Aristotle)
        recognition_moment = self._analyze_recognition_moment(screenplay_text)

        # Analyze twist earned (not cheap gimmick)
        twist_earned = self._analyze_twist_earned(screenplay_text, twist_setup)

        # Detect unearned twist (PENALTY - random, not foreshadowed)
        unearned_twist = self._detect_unearned_twist(screenplay_text, twist_setup)

        # Detect predictable twist (PENALTY - too obvious)
        predictable_twist = self._detect_predictable_twist(screenplay_text)

        # Detect twist overload (PENALTY - too many twists)
        twist_overload = self._detect_twist_overload(screenplay_text, multiple_twists)

        # Build twist profile
        twist_profile = TwistProfile(
            twist_present=twist_present["present"],
            twist_effectiveness=twist_effectiveness["effective"],
            twist_timing=twist_timing["good_timing"],
            twist_setup=twist_setup["properly_setup"],
            twist_impact=twist_impact["high_impact"],
            red_herrings_present=red_herrings["present"],
            multiple_twists_handled=multiple_twists["handled_well"],
            false_protagonist_twist=false_protagonist["present"],
            identity_twist=identity_twist["present"],
            reversal_of_fortune=reversal_fortune["present"],
            recognition_moment=recognition_moment["present"],
            twist_earned=twist_earned["earned"],
            unearned_twist_detected=unearned_twist["detected"],
            predictable_twist_detected=predictable_twist["detected"],
            twist_overload_detected=twist_overload["detected"],
            overall_twist_quality=0.0  # calculated below
        )

        # Calculate overall twist quality
        twist_profile.overall_twist_quality = self._calculate_overall_twist_quality(twist_profile)

        # Check against rules
        rule_violations = self._check_twist_rules(
            twist_profile, twist_present, twist_effectiveness, twist_timing,
            twist_setup, twist_impact, red_herrings, multiple_twists,
            false_protagonist, identity_twist, reversal_fortune, recognition_moment,
            twist_earned, unearned_twist, predictable_twist, twist_overload
        )

        # Calculate score
        score = self._calculate_twist_score(twist_profile, rule_violations)

        # Generate diagnosis
        diagnosis = self._generate_diagnosis(score, twist_profile, rule_violations)

        return {
            "specialist": {
                "name": self.name,
                "title": self.title,
                "specialty": self.specialty
            },
            "score": score,
            "twist_present": {
