    def _calculate_overall_twist_quality(self, profile: TwistProfile) -> float:
        """Calculate overall twist quality score."""
        scores = [
            1.0 if profile.twist_present else 0.4,  # Critical - twist makes story memorable
            1.0 if profile.twist_effectiveness else 0.5,  # Critical (Aristotle: surprise yet inevitable)
            1.0 if profile.twist_timing else 0.6,  # Important (Field/Snyder: midpoint or Act 3)
            1.0 if profile.twist_setup else 0.4,  # Critical (McKee: must be earned)
            1.0 if profile.twist_impact else 0.6,  # Important (changes everything)
            1.0 if profile.red_herrings_present else 0.8,  # Nice to have (sophisticated misdirection)
            1.0 if profile.multiple_twists_handled else 0.7,  # If multiple, must handle well
            1.0 if profile.false_protagonist_twist else 0.9,  # Rare but powerful (Psycho)
            1.0 if profile.identity_twist else 0.8,  # Common powerful twist type
            1.0 if profile.reversal_of_fortune else 0.7,  # Aristotle's peripeteia
            1.0 if profile.recognition_moment else 0.7,  # Aristotle's anagnorisis
            1.0 if profile.twist_earned else 0.3,  # Critical (McKee: earned not arbitrary)
            0.0 if profile.unearned_twist_detected else 1.0,  # PENALTY (critical violation)
            0.0 if profile.predictable_twist_detected else 1.0,  # PENALTY (loses surprise)
            0.0 if profile.twist_overload_detected else 1.0  # PENALTY (diminishing returns)
        ]

        # Average
        overall = sum(scores) / len(scores)

        return max(0.0, min(1.0, overall))

    def _check_twist_rules(self, profile: TwistProfile, twist_present: Dict,
                          twist_effectiveness: Dict, twist_timing: Dict,
                          twist_setup: Dict, twist_impact: Dict,
                          red_herrings: Dict, multiple_twists: Dict,
                          false_protagonist: Dict, identity_twist: Dict,
                          reversal_fortune: Dict, recognition_moment: Dict,
                          twist_earned: Dict, unearned_twist: Dict,
                          predictable_twist: Dict, twist_overload: Dict) -> List[Dict]:
        """Check twist against rules."""
        violations = []

        for rule in self.rules.get("rules", []):
            if rule["id"] == "TWIST.R001":
                # Twist Present
                if not profile.twist_present:
                    violations.append({
                        "rule_id": rule["id"],
                        "title": rule["title"],
                        "severity": rule["severity"],
                        "message": "Twist missing - no major revelation/reversal detected",
                        "fix": rule["fix"]
                    })

            elif rule["id"] == "TWIST.R002":
                # Twist Effectiveness (Surprise Yet Inevitable)
                if not profile.twist_effectiveness:
                    violations.append({
                        "rule_id": rule["id"],
                        "title": rule["title"],
                        "severity": rule["severity"],
                        "message": "Twist effectiveness weak - not surprising yet inevitable (Aristotle)",
                        "fix": rule["fix"]
                    })

            elif rule["id"] == "TWIST.R003":
                # Twist Timing Optimal
                if not profile.twist_timing:
                    violations.append({
                        "rule_id": rule["id"],
                        "title": rule["title"],
                        "severity": rule["severity"],
                        "message": "Twist timing suboptimal - not at Act 2 midpoint or Act 3",
                        "fix": rule["fix"]
                    })

            elif rule["id"] == "TWIST.R004":
                # Twist Setup Proper
                if not profile.twist_setup:
                    violations.append({
                        "rule_id": rule["id"],
                        "title": rule["title"],
                        "severity": rule["severity"],
                        "message": "Twist setup weak - not properly foreshadowed, appears random",
                        "fix": rule["fix"]
                    })

            elif rule["id"] == "TWIST.R005":
                # Twist Impact Significant
                if not profile.twist_impact:
                    violations.append({
                        "rule_id": rule["id"],
                        "title": rule["title"],
                        "severity": rule["severity"],
                        "message": "Twist impact weak - doesn't change everything or recontextualize story",
                        "fix": rule["fix"]
                    })

            elif rule["id"] == "TWIST.R006":
                # Red Herrings Present
                if not profile.red_herrings_present:
                    violations.append({
                        "rule_id": rule["id"],
                        "title": rule["title"],
                        "severity": rule["severity"],
                        "message": "Red herrings missing - no misdirection, twist too predictable",
                        "fix": rule["fix"]
                    })

            elif rule["id"] == "TWIST.R007":
                # Multiple Twists Handled Well
                if multiple_twists["present"] and not profile.multiple_twists_handled:
                    violations.append({
                        "rule_id": rule["id"],
                        "title": rule["title"],
                        "severity": rule["severity"],
                        "message": "Multiple twists poorly handled - overload, diminishing returns",
                        "fix": rule["fix"]
                    })

            elif rule["id"] == "TWIST.R008":
                # Identity Twist Effective
                if identity_twist["present"] and identity_twist["count"] < 3:
                    violations.append({
                        "rule_id": rule["id"],
                        "title": rule["title"],
                        "severity": rule["severity"],
                        "message": "Identity twist weak - not enough setup/impact",
                        "fix": rule["fix"]
                    })

            elif rule["id"] == "TWIST.R009":
                # Reversal of Fortune Present
                if not profile.reversal_of_fortune:
                    violations.append({
                        "rule_id": rule["id"],
                        "title": rule["title"],
                        "severity": rule["severity"],
                        "message": "Reversal of fortune missing - no peripeteia (Aristotle)",
                        "fix": rule["fix"]
                    })

            elif rule["id"] == "TWIST.R010":
                # Recognition Moment Present
                if not profile.recognition_moment:
                    violations.append({
                        "rule_id": rule["id"],
                        "title": rule["title"],
                        "severity": rule["severity"],
                        "message": "Recognition moment missing - no anagnorisis (Aristotle)",
                        "fix": rule["fix"]
                    })

            elif rule["id"] == "TWIST.R011":
                # Twist Earned
                if not profile.twist_earned:
                    violations.append({
                        "rule_id": rule["id"],
                        "title": rule["title"],
                        "severity": rule["severity"],
                        "message": "Twist not earned - cheap gimmick, not properly setup",
                        "fix": rule["fix"]
                    })

            elif rule["id"] == "TWIST.R012":
                # Avoid Unearned Twist
                if profile.unearned_twist_detected:
                    violations.append({
                        "rule_id": rule["id"],
                        "title": rule["title"],
                        "severity": rule["severity"],
                        "message": "Unearned twist detected - random, not foreshadowed, deus ex machina",
                        "fix": rule["fix"]
                    })

            elif rule["id"] == "TWIST.R013":
                # Avoid Predictable Twist
                if profile.predictable_twist_detected:
                    violations.append({
                        "rule_id": rule["id"],
                        "title": rule["title"],
                        "severity": rule["severity"],
                        "message": "Predictable twist detected - too obvious, telegraphed, no surprise",
                        "fix": rule["fix"]
                    })

            elif rule["id"] == "TWIST.R014":
                # Avoid Twist Overload
                if profile.twist_overload_detected:
                    violations.append({
                        "rule_id": rule["id"],
                        "title": rule["title"],
                        "severity": rule["severity"],
                        "message": "Twist overload detected - too many twists, diminishing returns",
                        "fix": rule["fix"]
                    })

            elif rule["id"] == "TWIST.R015":
                # Twist Surprise Balance
                if twist_effectiveness["surprise_count"] < 2 or twist_effectiveness["inevitable_count"] < 2:
                    violations.append({
                        "rule_id": rule["id"],
                        "title": rule["title"],
                        "severity": rule["severity"],
                        "message": "Twist surprise-inevitability balance weak - needs both elements",
                        "fix": rule["fix"]
                    })

        return violations

    def _calculate_twist_score(self, profile: TwistProfile, violations: List) -> float:
        """Calculate overall twist score."""
        # Start at 90
        score = 90.0

        # Deduct for violations
        for violation in violations:
            if violation["severity"] == "critical":
                score -= 20
            elif violation["severity"] == "high":
                score -= 15
            elif violation["severity"] == "medium":
                score -= 8
            elif violation["severity"] == "low":
                score -= 5

        # Extra penalty for major issues
        if profile.unearned_twist_detected:
            score -= 30  # Critical penalty (worst violation)
        if profile.predictable_twist_detected:
            score -= 20  # High penalty (loses surprise)
        if profile.twist_overload_detected:
            score -= 15  # High penalty (diminishing returns)

        # Bonus for excellence
        if profile.overall_twist_quality > 0.85:
            score += 5
        elif profile.overall_twist_quality > 0.75:
            score += 3

        if profile.twist_present and profile.twist_effectiveness:
            score += 5  # Aristotle's excellence (surprise yet inevitable)

        if profile.twist_earned and profile.twist_setup:
            score += 3  # McKee's sophisticated structure

        if profile.red_herrings_present:
            score += 2  # Sophisticated misdirection

        if profile.reversal_of_fortune and profile.recognition_moment:
            score += 3  # Aristotle's peripeteia + anagnorisis combo

        if profile.twist_impact:
            score += 2  # Changes everything

        # Cap at 95
        return max(5.0, min(95.0, score))

    def _generate_diagnosis(self, score: float, profile: TwistProfile,
                          violations: List) -> str:
        """Generate twist diagnosis summary."""
        if score >= 80:
            level = "EXCELLENT"
            summary = "Twist sophisticated with effective surprise-inevitability balance and proper setup"
        elif score >= 60:
            level = "GOOD"
            summary = "Twist present but could be more effective or better balanced"
        elif score >= 40:
            level = "NEEDS WORK"
            summary = "Twist problems - unearned, predictable, or poorly timed"
        else:
            level = "POOR"
            summary = "Major twist problems - unearned, predictable, or overload detected"

        diagnosis = f"TWIST {level} ({score:.1f}/100): {summary}"

        # Add specific issues
        issues = []
        if not profile.twist_present:
            issues.append("no twist")
        if not profile.twist_effectiveness:
            issues.append("weak effectiveness")
        if not profile.twist_setup:
            issues.append("poor setup")
        if profile.unearned_twist_detected:
            issues.append("unearned twist")
        if profile.predictable_twist_detected:
            issues.append("predictable twist")
        if profile.twist_overload_detected:
            issues.append("twist overload")
        if not profile.twist_timing:
            issues.append("poor timing")
        if not profile.twist_impact:
            issues.append("weak impact")

        if issues:
            diagnosis += f". Key issues: {', '.join(issues)}"

        return diagnosis

    def _generate_recommendations(self, score: float, violations: List,
                                 profile: TwistProfile) -> List[str]:
        """Generate specific twist recommendations."""
        recommendations = []

        # Add recommendations based on violations
        for violation in violations[:3]:
            recommendations.append(f"[{violation['severity'].upper()}] {violation['fix']}")

        # Add specific recommendations
        if not profile.twist_present:
            recommendations.append("Add major twist - McKee: 'Great stories have revelations that recontextualize everything seen before'")

        if not profile.twist_effectiveness:
            recommendations.append("Improve twist effectiveness - Aristotle: 'Best plots surprise audience yet feel inevitable in hindsight'")

        if not profile.twist_setup:
            recommendations.append("Strengthen twist setup - McKee: 'Twist must be earned - plant clues audience misses, surprise but inevitable'")

        if profile.unearned_twist_detected:
            recommendations.append("Eliminate unearned twist - Aristotle: 'Deus ex machina worst flaw - arbitrary resolution not earned through plot'")

        if profile.predictable_twist_detected:
            recommendations.append("Balance foreshadowing - Truby: 'Enough to feel earned, not so much it's obvious' - add misdirection, red herrings")

        if profile.twist_overload_detected:
            recommendations.append("Reduce twists - Snyder: 'One great twist better than three mediocre twists - focus impact'")

        if not profile.twist_timing:
            recommendations.append("Optimize twist timing - Field: 'Major twist at Act 2 midpoint (page 60) or Act 3 final reversal (page 85-95)'")

        if not profile.twist_impact:
            recommendations.append("Increase twist impact - McKee: 'Great twist recontextualizes everything - audience sees story in new light'")

        if not profile.red_herrings_present:
            recommendations.append("Add red herrings - McKee: 'Misdirection - plant false clues, hide truth in plain sight, surprise yet earned'")

        if not profile.reversal_of_fortune and not profile.recognition_moment:
            recommendations.append("Add Aristotelian elements - Aristotle: 'Peripeteia (reversal) + anagnorisis (recognition) most powerful plot elements'")

        # General excellence recommendations
        if score < 40:
            recommendations.append("Study McKee's Story - twist and revelation principles essential")
            recommendations.append("Study Aristotle's Poetics - peripeteia/anagnorisis foundation of great twists")

        return recommendations[:5]

    def export_twist_features(self, screenplay_text: str) -> Dict[str, Any]:
        """
        Export twist features for correlation/analysis.

        Returns structured data with twist metrics.
        """
        twist_present = self._analyze_twist_present(screenplay_text)
        twist_effectiveness = self._analyze_twist_effectiveness(screenplay_text)
        page_count = self._estimate_page_count(screenplay_text)
        act2_midpoint_text = self._extract_pages(screenplay_text, int(page_count * 0.45), int(page_count * 0.55))
        act3_text = self._extract_pages(screenplay_text, int(page_count * 0.75), page_count)
        twist_timing = self._analyze_twist_timing(screenplay_text, page_count, act2_midpoint_text, act3_text)

        return {
            "twist": {
                "twist_present": twist_present["present"],
                "twist_effectiveness": twist_effectiveness["effective"],
                "twist_timing": twist_timing["good_timing"],
                "twist_location": twist_timing["location"]
            },
            "meta": {
                "source": "DrTwist",
                "focus": "Twist and revelation analysis"
            }
        }


