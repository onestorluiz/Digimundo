@dataclass
class ToneProfile:
    """Overall tone analysis."""
    tone_established: bool  # Clear from opening
    tone_consistency: bool  # Maintained throughout
    mood_established: bool  # Emotional environment clear
    atmosphere_quality: bool  # Atmosphere supports story
    voice_consistency: bool  # Writer's distinctive style
    tone_genre_alignment: bool  # Tone appropriate to genre
    tonal_shifts_controlled: bool  # Intentional, not jarring
    dark_tone_present: bool  # If present, consistent
    light_tone_present: bool  # If present, consistent
    dramatic_tone_present: bool  # Dramatic/serious tone
    comic_tone_present: bool  # Comic/humorous tone
    ironic_tone_present: bool  # Ironic/satirical tone
    serious_tone_present: bool  # Serious/grave tone
    inconsistent_tone_detected: bool  # PENALTY (tone shifts randomly)
    tone_deaf_detected: bool  # PENALTY (inappropriate tone)
    unclear_tone_detected: bool  # PENALTY (audience confused)
    overall_tone_quality: float


@dataclass
class ToneAnalysisResults:
    """Complete tone analysis results."""
    tone_profile: ToneProfile
    tone_markers_list: List[str]  # Identified tone markers
    mood_markers_list: List[str]  # Mood/atmosphere markers
    voice_markers_list: List[str]  # Writer's voice markers
    tonal_shifts_list: List[str]  # Tonal shift moments
    inconsistent_tone_list: List[str]  # Inconsistent tone (PENALTY)
    tone_deaf_list: List[str]  # Tone-deaf moments (PENALTY)
    unclear_tone_list: List[str]  # Unclear tone (PENALTY)
    score: float
    diagnosis: str
    recommendations: List[str]


