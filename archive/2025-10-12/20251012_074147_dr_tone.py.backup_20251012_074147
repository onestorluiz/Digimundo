    def _load_rules(self) -> Dict:
        """Load rules from YAML file."""
        if self.rules_path.exists():
            with open(self.rules_path, 'r') as f:
                return yaml.safe_load(f)
        return {}

    def analyze(self, screenplay_text: str) -> Dict[str, Any]:
        """
        Analyze tone and atmosphere in screenplay.

        Args:
            screenplay_text: The full screenplay text

        Returns:
            Complete tone diagnostic report
        """
        # Extract page count and scenes
        page_count = self._estimate_page_count(screenplay_text)
        scenes = self._extract_scenes(screenplay_text)

        # Extract Act 1, 2, 3 for pattern analysis
        act1_text = self._extract_pages(screenplay_text, 0, int(page_count * 0.25))
        act2_text = self._extract_pages(screenplay_text, int(page_count * 0.25), int(page_count * 0.75))
        act3_text = self._extract_pages(screenplay_text, int(page_count * 0.75), page_count)

        # Extract opening (first 10 pages)
        opening_text = self._extract_pages(screenplay_text, 0, 10)

        # Analyze tone established (clear from opening)
        tone_established = self._analyze_tone_established(opening_text)

        # Analyze tone consistency (maintained throughout)
        tone_consistency = self._analyze_tone_consistency(screenplay_text, act1_text, act2_text, act3_text)

        # Analyze mood/atmosphere (emotional environment)
        mood_atmosphere = self._analyze_mood_atmosphere(screenplay_text)

        # Analyze voice consistency (writer's distinctive style)
        voice_consistency = self._analyze_voice_consistency(screenplay_text)

        # Analyze tone-genre alignment (tone appropriate to genre)
        tone_genre_alignment = self._analyze_tone_genre_alignment(screenplay_text)

        # Analyze tonal shifts (intentional, not jarring)
        tonal_shifts = self._analyze_tonal_shifts(screenplay_text)

        # Analyze dark tone (if present, consistent)
        dark_tone = self._analyze_dark_tone(screenplay_text)

        # Analyze light tone (if present, consistent)
        light_tone = self._analyze_light_tone(screenplay_text)

        # Analyze dramatic tone
        dramatic_tone = self._analyze_dramatic_tone(screenplay_text)

        # Analyze comic tone
        comic_tone = self._analyze_comic_tone(screenplay_text)

        # Analyze ironic tone
        ironic_tone = self._analyze_ironic_tone(screenplay_text)

        # Analyze serious tone
        serious_tone = self._analyze_serious_tone(screenplay_text)

        # Detect inconsistent tone (PENALTY - tone shifts randomly)
        inconsistent_tone = self._detect_inconsistent_tone(screenplay_text)

        # Detect tone-deaf moments (PENALTY - inappropriate tone)
        tone_deaf = self._detect_tone_deaf(screenplay_text)

        # Detect unclear tone (PENALTY - audience confused)
        unclear_tone = self._detect_unclear_tone(screenplay_text)

        # Build tone profile
        tone_profile = ToneProfile(
            tone_established=tone_established["established"],
            tone_consistency=tone_consistency["consistent"],
            mood_established=mood_atmosphere["established"],
            atmosphere_quality=mood_atmosphere["high_quality"],
            voice_consistency=voice_consistency["consistent"],
            tone_genre_alignment=tone_genre_alignment["aligned"],
            tonal_shifts_controlled=tonal_shifts["controlled"],
            dark_tone_present=dark_tone["present"],
            light_tone_present=light_tone["present"],
            dramatic_tone_present=dramatic_tone["present"],
            comic_tone_present=comic_tone["present"],
            ironic_tone_present=ironic_tone["present"],
            serious_tone_present=serious_tone["present"],
            inconsistent_tone_detected=inconsistent_tone["detected"],
            tone_deaf_detected=tone_deaf["detected"],
            unclear_tone_detected=unclear_tone["detected"],
            overall_tone_quality=0.0  # calculated below
        )

        # Calculate overall tone quality
        tone_profile.overall_tone_quality = self._calculate_overall_tone_quality(tone_profile)

        # Check against rules
        rule_violations = self._check_tone_rules(
            tone_profile, tone_established, tone_consistency, mood_atmosphere,
            voice_consistency, tone_genre_alignment, tonal_shifts,
            dark_tone, light_tone, dramatic_tone, comic_tone,
            ironic_tone, serious_tone, inconsistent_tone, tone_deaf, unclear_tone
        )

        # Calculate score
        score = self._calculate_tone_score(tone_profile, rule_violations)

        # Generate diagnosis
        diagnosis = self._generate_diagnosis(score, tone_profile, rule_violations)

        return {
            "specialist": {
                "name": self.name,
                "title": self.title,
                "specialty": self.specialty
            },
            "score": score,
            "tone_established": {
                "established": tone_established["established"],
                "count": tone_established["count"],
                "opening_strength": tone_established["opening_strength"]
            },
            "tone_consistency": {
