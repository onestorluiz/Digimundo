    def _calculate_overall_tone_quality(self, profile: ToneProfile) -> float:
        """Calculate overall tone quality score."""
        scores = [
            1.0 if profile.tone_established else 0.4,  # Critical (audience needs expectations)
            1.0 if profile.tone_consistency else 0.5,  # Critical (maintained throughout)
            1.0 if profile.mood_established else 0.6,  # Important (emotional environment)
            1.0 if profile.atmosphere_quality else 0.7,  # Important (supports story)
            1.0 if profile.voice_consistency else 0.7,  # Important (writer's style)
            1.0 if profile.tone_genre_alignment else 0.6,  # Important (meets expectations)
            1.0 if profile.tonal_shifts_controlled else 0.8,  # Nice to have (controlled)
            1.0 if profile.dark_tone_present else 0.9,  # Optional (if present, consistent)
            1.0 if profile.light_tone_present else 0.9,  # Optional (if present, consistent)
            1.0 if profile.dramatic_tone_present else 0.9,  # Optional (genre-dependent)
            1.0 if profile.comic_tone_present else 0.9,  # Optional (genre-dependent)
            1.0 if profile.ironic_tone_present else 0.95,  # Optional (sophisticated)
            1.0 if profile.serious_tone_present else 0.9,  # Optional (genre-dependent)
            0.0 if profile.inconsistent_tone_detected else 1.0,  # PENALTY (critical violation)
            0.0 if profile.tone_deaf_detected else 1.0,  # PENALTY (critical violation)
            0.0 if profile.unclear_tone_detected else 1.0  # PENALTY (critical violation)
        ]

        # Average
        overall = sum(scores) / len(scores)

        return max(0.0, min(1.0, overall))

    def _check_tone_rules(self, profile: ToneProfile, tone_established: Dict,
                          tone_consistency: Dict, mood_atmosphere: Dict,
                          voice_consistency: Dict, tone_genre_alignment: Dict,
                          tonal_shifts: Dict, dark_tone: Dict, light_tone: Dict,
                          dramatic_tone: Dict, comic_tone: Dict, ironic_tone: Dict,
                          serious_tone: Dict, inconsistent_tone: Dict,
                          tone_deaf: Dict, unclear_tone: Dict) -> List[Dict]:
        """Check tone against rules."""
        violations = []

        for rule in self.rules.get("rules", []):
            if rule["id"] == "TONE.R001":
                # Tone Established
                if not profile.tone_established:
                    violations.append({
                        "rule_id": rule["id"],
                        "title": rule["title"],
                        "severity": rule["severity"],
                        "message": "Tone not established in opening - audience unclear about emotional expectations",
                        "fix": rule["fix"]
