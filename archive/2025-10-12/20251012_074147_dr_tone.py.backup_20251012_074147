        return violations

    def _calculate_tone_score(self, profile: ToneProfile, violations: List) -> float:
        """Calculate overall tone score."""
        # Start at 90
        score = 90.0

        # Deduct for violations
        for violation in violations:
            if violation["severity"] == "critical":
                score -= 20
            elif violation["severity"] == "high":
                score -= 15
            elif violation["severity"] == "medium":
                score -= 8
            elif violation["severity"] == "low":
                score -= 5

        # Extra penalty for major issues
        if profile.inconsistent_tone_detected:
            score -= 25  # Critical penalty (tone whiplash)
        if profile.tone_deaf_detected:
            score -= 25  # Critical penalty (worst violation)
        if profile.unclear_tone_detected:
            score -= 20  # High penalty (audience confusion)

        # Bonus for excellence
        if profile.overall_tone_quality > 0.85:
            score += 5
        elif profile.overall_tone_quality > 0.75:
            score += 3

        if profile.tone_established and profile.tone_consistency:
            score += 5  # McKee's excellence (tone clear and consistent)

        if profile.mood_established and profile.atmosphere_quality:
            score += 3  # Strong atmosphere

        if profile.voice_consistency and profile.tone_consistency:
            score += 3  # Voice-tone unity

        if profile.tone_genre_alignment:
            score += 2  # Meets genre expectations

        if profile.tonal_shifts_controlled:
            score += 2  # Sophisticated tonal modulation

        # Cap at 95
        return max(5.0, min(95.0, score))

    def _generate_diagnosis(self, score: float, profile: ToneProfile,
                           violations: List) -> str:
        """Generate tone diagnosis summary."""
        if score >= 80:
            level = "EXCELLENT"
            summary = "Tone sophisticated with clear establishment, consistency, and appropriate atmosphere"
        elif score >= 60:
            level = "GOOD"
            summary = "Tone present but could be more consistent or atmospheric"
        elif score >= 40:
            level = "NEEDS WORK"
            summary = "Tone problems - inconsistent, tone-deaf, or unclear"
        else:
            level = "POOR"
            summary = "Major tone problems - inconsistent, tone-deaf, or lacking establishment"

        diagnosis = f"TONE {level} ({score:.1f}/100): {summary}"

        # Add specific issues
        issues = []
        if not profile.tone_established:
            issues.append("tone not established")
        if not profile.tone_consistency:
            issues.append("inconsistent tone")
        if not profile.mood_established:
            issues.append("weak atmosphere")
        if profile.inconsistent_tone_detected:
            issues.append("tone shifts randomly")
        if profile.tone_deaf_detected:
            issues.append("tone-deaf moments")
        if profile.unclear_tone_detected:
            issues.append("unclear tone")
        if not profile.voice_consistency:
            issues.append("inconsistent voice")
        if not profile.tone_genre_alignment:
            issues.append("genre misalignment")

        if issues:
            diagnosis += f". Key issues: {', '.join(issues)}"

        return diagnosis

    def _generate_recommendations(self, score: float, violations: List,
                                  profile: ToneProfile) -> List[str]:
        """Generate specific tone recommendations."""
        recommendations = []

        # Add recommendations based on violations
        for violation in violations[:3]:
            recommendations.append(f"[{violation['severity'].upper()}] {violation['fix']}")

        # Add specific recommendations
        if not profile.tone_established:
            recommendations.append("Establish tone in opening - Seger: 'Tone established in opening - audience knows emotional environment immediately'")

        if not profile.tone_consistency:
            recommendations.append("Strengthen tone consistency - McKee: 'Tone consistency - maintained throughout story, not shifting randomly'")

        if not profile.mood_established:
            recommendations.append("Develop mood/atmosphere - McKee: 'Atmosphere - emotional environment permeates story, affects audience'")

        if profile.inconsistent_tone_detected:
            recommendations.append("Eliminate inconsistent tone - McKee: 'Inconsistent tone - shifts randomly, jarring, confusing audience'")

        if profile.tone_deaf_detected:
            recommendations.append("Fix tone-deaf moments - Seger: 'Tone-deaf moments - inappropriate tone, wrong emotional notes alienate audience'")

        if profile.unclear_tone_detected:
            recommendations.append("Clarify tone - McKee: 'Tone must be clear - audience needs emotional roadmap from opening'")

        if not profile.voice_consistency:
            recommendations.append("Strengthen writer's voice - Goldman: 'Voice distinctive - writer's personal, authentic, professional craft'")

        if not profile.tone_genre_alignment:
            recommendations.append("Align tone with genre - Snyder: 'Tone genre expectations - comedy light, drama serious, thriller tense'")

        if not profile.atmosphere_quality:
            recommendations.append("Improve atmosphere - Mackendrick: 'Atmosphere visual design - cinematography creates emotional environment'")

        if not profile.tonal_shifts_controlled:
            recommendations.append("Control tonal shifts - McKee: 'Tonal shifts controlled - intentional, earned, not jarring shifts'")

        # General excellence recommendations
        if score < 40:
            recommendations.append("Study McKee's Story - tone and atmosphere principles essential")
            recommendations.append("Study Seger's Making a Good Script Great - tone establishment and consistency")

        return recommendations[:5]

    def export_tone_features(self, screenplay_text: str) -> Dict[str, Any]:
        """
        Export tone features for correlation/analysis.

        Returns structured data with tone metrics.
        """
        opening_text = self._extract_pages(screenplay_text, 0, 10)
        tone_established = self._analyze_tone_established(opening_text)
        tone_consistency = self._analyze_tone_consistency(
            screenplay_text,
            self._extract_pages(screenplay_text, 0, 25),
            self._extract_pages(screenplay_text, 25, 75),
            self._extract_pages(screenplay_text, 75, 100)
        )
        mood_atmosphere = self._analyze_mood_atmosphere(screenplay_text)
        voice_consistency = self._analyze_voice_consistency(screenplay_text)

        return {
            "tone": {
                "tone_established": tone_established["established"],
                "tone_consistency": tone_consistency["consistent"],
                "mood_established": mood_atmosphere["established"],
                "voice_consistency": voice_consistency["consistent"]
            },
            "meta": {
                "source": "DrTone",
                "focus": "Tone and atmosphere analysis"
            }
        }


