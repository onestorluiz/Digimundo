@dataclass
class BackstoryProfile:
    """Overall backstory analysis."""
    backstory_present: bool  # Character has backstory/history
    backstory_integrated: bool  # Weaved naturally not dumped
    drip_feed_technique: bool  # Revealed gradually (McKee)
    backstory_reveals_character: bool  # Shows who they are now
    backstory_timing: bool  # Revealed when needed for story
    ghost_wound_identified: bool  # Past trauma affecting present (Truby)
    flashback_usage: bool  # When appropriate, not overused
    exposition_integration: bool  # Show don't tell backstory
    backstory_motivation: bool  # Explains current behavior
    backstory_relevant: bool  # Every detail serves story
    info_dump_detected: bool  # PENALTY (too much backstory at once)
    irrelevant_backstory_detected: bool  # PENALTY (doesn't serve story)
    excessive_flashbacks_detected: bool  # PENALTY (overused, breaks flow)
    overall_backstory_quality: float


@dataclass
class BackstoryAnalysisResults:
    """Complete backstory analysis results."""
    backstory_profile: BackstoryProfile
    backstory_moments: List[str]  # Moments of backstory revelation
    ghost_wound_list: List[str]  # Past traumas identified
    flashback_list: List[str]  # Flashback scenes
    drip_feed_moments: List[str]  # Gradual revelation moments
    info_dump_list: List[str]  # Info dumps detected (PENALTY)
    score: float
    diagnosis: str
    recommendations: List[str]


