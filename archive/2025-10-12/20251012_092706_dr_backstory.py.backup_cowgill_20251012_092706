    def _load_rules(self) -> Dict:
        """Load rules from YAML file."""
        if self.rules_path.exists():
            with open(self.rules_path, 'r') as f:
                return yaml.safe_load(f)
        return {}

    def analyze(self, screenplay_text: str) -> Dict[str, Any]:
        """
        Analyze backstory integration in screenplay.

        Args:
            screenplay_text: The full screenplay text

        Returns:
            Complete backstory diagnostic report
        """
        # Extract page count and scenes
        page_count = self._estimate_page_count(screenplay_text)
        scenes = self._extract_scenes(screenplay_text)

        # Extract opening (first 15 pages) for backstory setup
        opening_text = self._extract_pages(screenplay_text, 0, 15)

        # Extract Act 1 (first 25%) for backstory establishment
        act1_text = self._extract_pages(screenplay_text, 0, int(page_count * 0.25))

        # Extract Act 2 (middle 50%) for backstory drip-feed
        act2_text = self._extract_pages(screenplay_text, int(page_count * 0.25), int(page_count * 0.75))

        # Analyze backstory present (character has history)
        backstory_present = self._analyze_backstory_present(screenplay_text)

        # Analyze backstory integrated (weaved naturally)
        backstory_integrated = self._analyze_backstory_integrated(screenplay_text)

        # Analyze drip-feed technique (revealed gradually - McKee)
        drip_feed = self._analyze_drip_feed_technique(screenplay_text, act2_text)

        # Analyze backstory reveals character (shows who they are now)
        backstory_reveals = self._analyze_backstory_reveals_character(screenplay_text)

        # Analyze backstory timing (revealed when needed)
        backstory_timing = self._analyze_backstory_timing(screenplay_text)

        # Analyze ghost/wound (past trauma affecting present - Truby)
        ghost_wound = self._analyze_ghost_wound(screenplay_text)

        # Analyze flashback usage (when appropriate)
        flashback_usage = self._analyze_flashback_usage(screenplay_text, scenes)

        # Analyze exposition integration (show don't tell)
        exposition_integration = self._analyze_exposition_integration(screenplay_text)

        # Analyze backstory motivation (explains behavior)
        backstory_motivation = self._analyze_backstory_motivation(screenplay_text)

        # Analyze backstory relevant (serves story)
        backstory_relevant = self._analyze_backstory_relevant(screenplay_text)

        # Detect info dump (PENALTY)
        info_dump = self._detect_info_dump(screenplay_text)

        # Detect irrelevant backstory (PENALTY)
        irrelevant_backstory = self._detect_irrelevant_backstory(screenplay_text)

        # Detect excessive flashbacks (PENALTY)
        excessive_flashbacks = self._detect_excessive_flashbacks(screenplay_text, flashback_usage)

        # Build backstory profile
        backstory_profile = BackstoryProfile(
            backstory_present=backstory_present["present"],
            backstory_integrated=backstory_integrated["integrated"],
            drip_feed_technique=drip_feed["drip_feed"],
            backstory_reveals_character=backstory_reveals["reveals"],
            backstory_timing=backstory_timing["good_timing"],
            ghost_wound_identified=ghost_wound["identified"],
            flashback_usage=flashback_usage["appropriate"],
            exposition_integration=exposition_integration["integrated"],
            backstory_motivation=backstory_motivation["explains"],
            backstory_relevant=backstory_relevant["relevant"],
            info_dump_detected=info_dump["detected"],
            irrelevant_backstory_detected=irrelevant_backstory["detected"],
            excessive_flashbacks_detected=excessive_flashbacks["detected"],
            overall_backstory_quality=0.0  # calculated below
        )

        # Calculate overall backstory quality
        backstory_profile.overall_backstory_quality = self._calculate_overall_backstory_quality(backstory_profile)

        # Check against rules
        rule_violations = self._check_backstory_rules(
            backstory_profile, backstory_present, backstory_integrated, drip_feed,
            backstory_reveals, backstory_timing, ghost_wound, flashback_usage,
            exposition_integration, backstory_motivation, backstory_relevant,
            info_dump, irrelevant_backstory, excessive_flashbacks
        )

        # Calculate score
        score = self._calculate_backstory_score(backstory_profile, rule_violations)

        # Generate diagnosis
        diagnosis = self._generate_diagnosis(score, backstory_profile, rule_violations)

        return {
            "specialist": {
                "name": self.name,
                "title": self.title,
                "specialty": self.specialty
            },
            "score": score,
            "backstory_present": {
                "present": backstory_present["present"],
                "count": backstory_present["count"],
                "moments": backstory_present["moments"][:10]
            },
            "backstory_integrated": {
                "integrated": backstory_integrated["integrated"],
                "count": backstory_integrated["count"]
            },
