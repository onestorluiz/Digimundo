    def _calculate_backstory_score(self, profile: BackstoryProfile, violations: List) -> float:
        """Calculate overall backstory score."""
        # Start at 90
        score = 90.0

        # Deduct for violations
        for violation in violations:
            if violation["severity"] == "critical":
                score -= 20
            elif violation["severity"] == "high":
                score -= 15
            elif violation["severity"] == "medium":
                score -= 8
            elif violation["severity"] == "low":
                score -= 5

        # Extra penalty for major issues
        if profile.info_dump_detected:
            score -= 25  # critical penalty
        if profile.excessive_flashbacks_detected:
            score -= 20  # high penalty
        if profile.irrelevant_backstory_detected:
            score -= 10

        # Bonus for excellence
        if profile.overall_backstory_quality > 0.85:
            score += 5
        elif profile.overall_backstory_quality > 0.75:
            score += 3

        if profile.backstory_integrated and profile.drip_feed_technique:
            score += 3  # McKee's sophisticated technique

        if profile.ghost_wound_identified:
            score += 3  # Truby's sophisticated storytelling

        if profile.backstory_integrated and not profile.info_dump_detected:
            score += 2

        if profile.flashback_usage and not profile.excessive_flashbacks_detected:
            score += 2

        # Cap at 95
        return max(5.0, min(95.0, score))

    def _generate_diagnosis(self, score: float, profile: BackstoryProfile,
                          violations: List) -> str:
        """Generate backstory diagnosis summary."""
        if score >= 80:
            level = "EXCELLENT"
            summary = "Backstory integrated naturally with drip-feed technique and strategic timing"
        elif score >= 60:
            level = "GOOD"
            summary = "Backstory present but could be better integrated or more gradual"
        elif score >= 40:
            level = "NEEDS WORK"
            summary = "Backstory problems - info dumps or excessive flashbacks detected"
        else:
            level = "POOR"
            summary = "Major backstory problems - excessive exposition or irrelevant details"

        diagnosis = f"BACKSTORY {level} ({score:.1f}/100): {summary}"

        # Add specific issues
        issues = []
        if not profile.backstory_integrated:
            issues.append("not integrated")
        if not profile.drip_feed_technique:
            issues.append("no drip-feed")
        if profile.info_dump_detected:
            issues.append("info dumps")
        if profile.excessive_flashbacks_detected:
            issues.append("excessive flashbacks")
        if profile.irrelevant_backstory_detected:
            issues.append("irrelevant details")
        if not profile.backstory_timing:
            issues.append("poor timing")

        if issues:
            diagnosis += f". Key issues: {', '.join(issues)}"

        return diagnosis

    def _generate_recommendations(self, score: float, violations: List,
                                 profile: BackstoryProfile) -> List[str]:
        """Generate specific backstory recommendations."""
        recommendations = []

        # Add recommendations based on violations
        for violation in violations[:3]:
            recommendations.append(f"[{violation['severity'].upper()}] {violation['fix']}")

        # Add specific recommendations
        if not profile.backstory_integrated:
            recommendations.append("Integrate backstory - McKee: 'Backstory revelation through conflict not narration - weave it in naturally' - avoid dumps")

        if not profile.drip_feed_technique:
            recommendations.append("Use drip-feed - McKee: 'Drip-feed backstory - reveal piece by piece, not all at once' - gradual revelation throughout")

        if profile.info_dump_detected:
            recommendations.append("Cut info dumps - McKee: 'Info dump kills drama - never stop action to explain backstory' - weave backstory into present action")

        if profile.excessive_flashbacks_detected:
            recommendations.append("Reduce flashbacks - McKee: 'Excessive flashbacks destroy present tension - use sparingly' - maintain present story momentum")

        if not profile.ghost_wound_identified:
            recommendations.append("Add ghost/wound - Truby: 'Ghost - past trauma that haunts character, drives current behavior' - create deeper character dimension")

        if not profile.backstory_timing:
            recommendations.append("Improve timing - McKee: 'Backstory revelation timing - reveal when tension is high, stakes are clear' - strategic revelation")

        # General excellence recommendations
        if score < 40:
            recommendations.append("Study McKee's Story - backstory revelation techniques essential")
            recommendations.append("Study Truby's Anatomy of Story - ghost/wound fundamental")

        return recommendations[:5]

    def export_backstory_features(self, screenplay_text: str) -> Dict[str, Any]:
        """
        Export backstory features for correlation/analysis.

        Returns structured data with backstory metrics.
        """
        backstory_present = self._analyze_backstory_present(screenplay_text)
        backstory_integrated = self._analyze_backstory_integrated(screenplay_text)
        drip_feed = self._analyze_drip_feed_technique(screenplay_text, screenplay_text)

        return {
            "backstory": {
                "backstory_present": backstory_present["present"],
                "backstory_integrated": backstory_integrated["integrated"],
                "drip_feed_technique": drip_feed["drip_feed"]
            },
            "meta": {
                "source": "DrBackstory",
                "focus": "Backstory integration and revelation"
            }
        }


