            1.0 if profile.backstory_integrated else 0.4,  # CRITICAL
            1.0 if profile.drip_feed_technique else 0.5,  # Important (McKee)
            1.0 if profile.backstory_reveals_character else 0.6,  # Important
            1.0 if profile.backstory_timing else 0.6,  # Important
            1.0 if profile.ghost_wound_identified else 0.7,  # Nice to have (Truby)
            1.0 if profile.flashback_usage else 0.3,  # CRITICAL (avoid overuse)
            1.0 if profile.exposition_integration else 0.5,  # Important
            1.0 if profile.backstory_motivation else 0.6,  # Important
