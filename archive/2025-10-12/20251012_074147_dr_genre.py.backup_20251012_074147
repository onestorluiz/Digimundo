                if not profile.genre_tone_alignment:
                    violations.append({
                        "rule_id": rule["id"],
                        "title": rule["title"],
                        "severity": rule["severity"],
                        "message": "Genre-tone misalignment - tone doesn't match genre expectations",
                        "fix": rule["fix"]
                    })

            elif rule["id"] == "GENRE.R012":
                # Genre Pacing Appropriate
                if not profile.genre_pacing_appropriate:
                    violations.append({
                        "rule_id": rule["id"],
                        "title": rule["title"],
