    def _detect_genre_cliches(self, screenplay: str, identified_genres: List[str]) -> Dict[str, Any]:
        """
        Detect genre clichés overused (PENALTY - too derivative).

        Truby: "Genre clichés - avoid overused tropes, be original."
        McKee: "Derivative genre writing - stale, predictable, unoriginal."
        """
        detected = False
        penalty = False
        cliches_list = []

        # Check for cliché markers
        count = 0
        for marker in self.genre_cliches_markers:
            marker_count = screenplay.lower().count(marker)
            count += marker_count
            if marker_count > 0:
                # Extract cliché instances
                for line in screenplay.split('\n'):
                    if marker in line.lower():
                        cliches_list.append(line.strip()[:100])
                        if len(cliches_list) >= 10:
                            break

        if count >= 5:
            detected = True
            penalty = True
        elif count >= 3:
            detected = True
            penalty = True

        return {
            "detected": detected,
            "penalty": penalty,
            "count": count,
            "list": cliches_list
        }

    def _calculate_overall_genre_quality(self, profile: GenreProfile) -> float:
        """Calculate overall genre quality score."""
        scores = [
            1.0 if profile.genre_identified else 0.3,  # Critical (must know genre)
            1.0 if profile.genre_clarity else 0.5,  # Critical (audience needs clarity)
            1.0 if profile.genre_conventions_met else 0.4,  # Critical (follow genre rules)
            1.0 if profile.genre_expectations_satisfied else 0.4,  # Critical (deliver promises)
            1.0 if profile.genre_tropes_present else 0.7,  # Important (familiar elements)
            1.0 if profile.genre_tropes_fresh else 0.8,  # Important (avoid clichés)
            1.0 if profile.hybrid_genre_handling else 0.9,  # Nice to have (if hybrid, balanced)
            1.0 if profile.genre_tone_alignment else 0.6,  # Important (tone matches genre)
            1.0 if profile.genre_pacing_appropriate else 0.7,  # Important (pacing fits)
            1.0 if profile.genre_stakes_appropriate else 0.7,  # Important (stakes fit)
            1.0 if profile.genre_resolution_appropriate else 0.7,  # Important (resolution fits)
            0.0 if profile.genre_confusion_detected else 1.0,  # PENALTY (critical violation)
            0.0 if profile.genre_promise_broken else 1.0,  # PENALTY (critical violation)
            0.0 if profile.genre_cliches_overused else 1.0  # PENALTY (major violation)
        ]

        # Average
        overall = sum(scores) / len(scores)

        return max(0.0, min(1.0, overall))

    def _check_genre_rules(self, profile: GenreProfile, genre_identified: Dict,
                          genre_clarity: Dict, genre_conventions: Dict,
                          genre_expectations: Dict, genre_tropes: Dict,
                          hybrid_genre: Dict, action_genre: Dict, drama_genre: Dict,
                          comedy_genre: Dict, thriller_genre: Dict, horror_genre: Dict,
                          romance_genre: Dict, scifi_fantasy_genre: Dict, mystery_genre: Dict,
                          genre_tone_alignment: Dict, genre_pacing: Dict,
                          genre_stakes: Dict, genre_resolution: Dict,
                          genre_confusion: Dict, genre_promise_broken: Dict,
                          genre_cliches: Dict) -> List[Dict]:
        """Check genre against rules."""
        violations = []

        for rule in self.rules.get("rules", []):
            if rule["id"] == "GENRE.R001":
                # Genre Identified
                if not profile.genre_identified:
                    violations.append({
                        "rule_id": rule["id"],
                        "title": rule["title"],
                        "severity": rule["severity"],
                        "message": "Genre not identified - audience unclear what genre this is",
                        "fix": rule["fix"]
                    })

            elif rule["id"] == "GENRE.R002":
                # Genre Clarity
                if not profile.genre_clarity:
                    violations.append({
                        "rule_id": rule["id"],
                        "title": rule["title"],
                        "severity": rule["severity"],
                        "message": "Genre unclear from opening - audience doesn't know genre immediately",
                        "fix": rule["fix"]
                    })

            elif rule["id"] == "GENRE.R003":
                # Genre Conventions Met
                if not profile.genre_conventions_met:
                    violations.append({
                        "rule_id": rule["id"],
                        "title": rule["title"],
                        "severity": rule["severity"],
                        "message": "Genre conventions not met - missing essential genre elements",
                        "fix": rule["fix"]
                    })

            elif rule["id"] == "GENRE.R004":
                # Genre Expectations Satisfied
                if not profile.genre_expectations_satisfied:
                    violations.append({
                        "rule_id": rule["id"],
                        "title": rule["title"],
                        "severity": rule["severity"],
                        "message": "Genre expectations not satisfied - doesn't deliver what genre promises",
                        "fix": rule["fix"]
                    })

            elif rule["id"] == "GENRE.R005":
                # Genre Tropes Present
                if not profile.genre_tropes_present:
                    violations.append({
                        "rule_id": rule["id"],
                        "title": rule["title"],
                        "severity": rule["severity"],
                        "message": "Genre tropes missing - lacks familiar elements audience expects",
                        "fix": rule["fix"]
                    })

            elif rule["id"] == "GENRE.R006":
                # Genre Tropes Fresh
                if not profile.genre_tropes_fresh:
                    violations.append({
                        "rule_id": rule["id"],
                        "title": rule["title"],
                        "severity": rule["severity"],
                        "message": "Genre tropes stale - clichéd, derivative, unoriginal",
                        "fix": rule["fix"]
                    })

            elif rule["id"] == "GENRE.R007":
                # Hybrid Genre Handling
                if hybrid_genre["is_hybrid"] and not profile.hybrid_genre_handling:
                    violations.append({
                        "rule_id": rule["id"],
                        "title": rule["title"],
                        "severity": rule["severity"],
                        "message": "Hybrid genre unbalanced - multiple genres not integrated effectively",
