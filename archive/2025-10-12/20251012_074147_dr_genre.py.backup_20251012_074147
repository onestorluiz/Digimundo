    def _estimate_page_count(self, screenplay: str) -> int:
        """Estimate page count from screenplay text."""
        lines = screenplay.split('\n')
        return max(1, len(lines) // 55)

    def _extract_scenes(self, screenplay: str) -> List[Dict]:
        """Extract all scenes from screenplay."""
        scenes = []
        lines = screenplay.split('\n')
        current_scene = None
        scene_number = 0

        for i, line in enumerate(lines):
            # Detect scene heading
            if re.match(r'^(INT\.|EXT\.)', line.strip()):
                # Save previous scene
                if current_scene:
                    current_scene['end_line'] = i - 1
                    current_scene['end_page'] = (i - 1) // 55
                    scenes.append(current_scene)

                # Start new scene
                scene_number += 1
                current_scene = {
                    'number': scene_number,
                    'heading': line.strip(),
                    'start_line': i,
                    'start_page': i // 55,
                    'content': []
                }
            elif current_scene:
                current_scene['content'].append(line)

        # Add last scene
        if current_scene:
            current_scene['end_line'] = len(lines) - 1
            current_scene['end_page'] = (len(lines) - 1) // 55
            scenes.append(current_scene)

        return scenes

    def _extract_pages(self, screenplay: str, start_page: int, end_page: int) -> str:
        """Extract specific page range from screenplay."""
        lines = screenplay.split('\n')
        start_line = start_page * 55
        end_line = end_page * 55
        return '\n'.join(lines[start_line:end_line])

    def _analyze_genre_identification(self, screenplay: str, opening_text: str) -> Dict[str, Any]:
        """
        Analyze genre identification (what genre is this?).

        Snyder: "Genre clear from opening image - audience knows immediately what genre."
        McKee: "Genre design conventions - audience expectations must be met."
        """
        identified = False
        genres = []
        primary_genre = None
        confidence = 0.0

        # Check for genre identification markers
        genre_counts = {}
        for marker in self.genre_identification_markers:
            count = screenplay.lower().count(marker)
            if count > 0:
                # Extract genre from marker
                genre = marker.split()[0] if " " in marker else marker
                genre_counts[genre] = genre_counts.get(genre, 0) + count

        # Identify genres by analyzing markers
        if genre_counts:
            identified = True
            # Sort by count
            sorted_genres = sorted(genre_counts.items(), key=lambda x: x[1], reverse=True)
            genres = [g[0] for g in sorted_genres[:3]]  # Top 3
            primary_genre = genres[0] if genres else None
            confidence = min(1.0, sorted_genres[0][1] / 10.0) if sorted_genres else 0.0

        return {
            "identified": identified,
            "genres": genres,
            "primary_genre": primary_genre,
            "confidence": confidence
        }

