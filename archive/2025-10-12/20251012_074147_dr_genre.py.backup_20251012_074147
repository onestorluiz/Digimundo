                    })

            elif rule["id"] == "GENRE.R008":
                # Action Genre Quality
                if profile.action_genre_present:
                    # Check if action genre meets conventions
                    if not profile.genre_conventions_met:
                        violations.append({
                            "rule_id": rule["id"],
                            "title": rule["title"],
                            "severity": rule["severity"],
                            "message": "Action genre conventions weak - lacks chase/fight/set pieces",
                            "fix": rule["fix"]
                        })

            elif rule["id"] == "GENRE.R009":
                # Drama Genre Quality
                if profile.drama_genre_present:
                    # Check if drama genre meets conventions
                    if not profile.genre_conventions_met:
                        violations.append({
                            "rule_id": rule["id"],
                            "title": rule["title"],
                            "severity": rule["severity"],
                            "message": "Drama genre conventions weak - lacks emotional depth/character focus",
                            "fix": rule["fix"]
                        })

            elif rule["id"] == "GENRE.R010":
                # Comedy Genre Quality
                if profile.comedy_genre_present:
