                if profile.genre_cliches_overused:
                    violations.append({
                        "rule_id": rule["id"],
                        "title": rule["title"],
                        "severity": rule["severity"],
                        "message": "Genre clichés overused - too derivative, unoriginal, predictable",
                        "fix": rule["fix"]
                    })

        return violations

    def _calculate_genre_score(self, profile: GenreProfile, violations: List) -> float:
        """Calculate overall genre score."""
        # Start at 90
        score = 90.0

        # Deduct for violations
        for violation in violations:
            if violation["severity"] == "critical":
                score -= 20
            elif violation["severity"] == "high":
                score -= 15
            elif violation["severity"] == "medium":
                score -= 8
            elif violation["severity"] == "low":
                score -= 5

        # Extra penalty for major issues
        if profile.genre_confusion_detected:
            score -= 25  # Critical penalty (worst violation)
        if profile.genre_promise_broken:
            score -= 25  # Critical penalty (audience disappointed)
        if profile.genre_cliches_overused:
            score -= 20  # High penalty (derivative)

        # Bonus for excellence
        if profile.overall_genre_quality > 0.85:
            score += 5
        elif profile.overall_genre_quality > 0.75:
            score += 3

        if profile.genre_identified and profile.genre_clarity:
            score += 5  # Snyder's excellence (genre clear from opening)

        if profile.genre_conventions_met and profile.genre_expectations_satisfied:
            score += 5  # McKee's excellence (delivers genre promises)

        if profile.genre_tropes_present and profile.genre_tropes_fresh:
            score += 3  # Truby's excellence (uses tropes effectively, not clichéd)

        if profile.genre_tone_alignment:
            score += 2  # Tone matches genre

        if profile.genre_pacing_appropriate:
            score += 2  # Pacing fits genre

        # Cap at 95
        return max(5.0, min(95.0, score))

    def _generate_diagnosis(self, score: float, profile: GenreProfile,
                           violations: List) -> str:
        """Generate genre diagnosis summary."""
        if score >= 80:
            level = "EXCELLENT"
            summary = "Genre sophisticated with clear identification, conventions met, expectations satisfied"
        elif score >= 60:
            level = "GOOD"
            summary = "Genre present but could be clearer or deliver conventions more effectively"
        elif score >= 40:
            level = "NEEDS WORK"
            summary = "Genre problems - unclear, conventions missing, or expectations unmet"
        else:
            level = "POOR"
            summary = "Major genre problems - confusion, broken promises, or too derivative"

        diagnosis = f"GENRE {level} ({score:.1f}/100): {summary}"

        # Add specific issues
        issues = []
        if not profile.genre_identified:
            issues.append("genre not identified")
        if not profile.genre_clarity:
            issues.append("genre unclear")
        if not profile.genre_conventions_met:
            issues.append("conventions missing")
        if not profile.genre_expectations_satisfied:
            issues.append("expectations unmet")
        if profile.genre_confusion_detected:
            issues.append("genre confusion")
        if profile.genre_promise_broken:
            issues.append("promise broken")
        if profile.genre_cliches_overused:
            issues.append("too derivative")
        if not profile.genre_tone_alignment:
            issues.append("tone misalignment")

        if issues:
            diagnosis += f". Key issues: {', '.join(issues)}"

        return diagnosis

    def _generate_recommendations(self, score: float, violations: List,
                                  profile: GenreProfile) -> List[str]:
        """Generate specific genre recommendations."""
        recommendations = []

        # Add recommendations based on violations
        for violation in violations[:3]:
            recommendations.append(f"[{violation['severity'].upper()}] {violation['fix']}")

        # Add specific recommendations
        if not profile.genre_identified:
            recommendations.append("Identify genre clearly - Snyder: 'Genre clear from opening image - audience knows immediately'")

        if not profile.genre_clarity:
            recommendations.append("Establish genre in opening - Snyder: 'Opening image tells genre - page 1 signals genre to audience'")

        if not profile.genre_conventions_met:
            recommendations.append("Meet genre conventions - Snyder: 'Genre conventions must be met - each genre has rules, deliver them'")

        if not profile.genre_expectations_satisfied:
            recommendations.append("Satisfy genre expectations - Snyder: 'Deliver what genre promises or audience disappointed'")

        if profile.genre_confusion_detected:
            recommendations.append("Eliminate genre confusion - Seger: 'Genre unclear - audience confused, doesn't know what to expect'")

        if profile.genre_promise_broken:
            recommendations.append("Fulfill genre promises - Snyder: 'Genre promise broken - expectations unmet, audience disappointed'")

        if profile.genre_cliches_overused:
            recommendations.append("Refresh genre tropes - Truby: 'Avoid genre clichés - be original, subvert intentionally'")

        if not profile.genre_tone_alignment:
            recommendations.append("Align tone with genre - Snyder: 'Tone matches genre - action energetic, drama serious, comedy light'")

        if not profile.genre_tropes_fresh:
            recommendations.append("Freshen genre tropes - Truby: 'Use tropes effectively - subvert when intentional, avoid derivative'")

        if not profile.genre_pacing_appropriate:
            recommendations.append("Match pacing to genre - Field: 'Genre pacing - action fast, drama measured, comedy rhythm'")

        # General excellence recommendations
        if score < 40:
            recommendations.append("Study Snyder's Save the Cat - genre types, conventions, expectations essential")
            recommendations.append("Study McKee's Story - genre design conventions and audience expectations")

        return recommendations[:5]

    def export_genre_features(self, screenplay_text: str) -> Dict[str, Any]:
        """
        Export genre features for correlation/analysis.

        Returns structured data with genre metrics.
        """
        opening_text = self._extract_pages(screenplay_text, 0, 10)
        genre_identified = self._analyze_genre_identification(screenplay_text, opening_text)
        genre_clarity = self._analyze_genre_clarity(opening_text)
        genre_conventions = self._analyze_genre_conventions(screenplay_text, genre_identified["genres"])
        genre_expectations = self._analyze_genre_expectations(screenplay_text, genre_identified["genres"])

        return {
            "genre": {
                "genre_identified": genre_identified["identified"],
                "genre_clarity": genre_clarity["clear"],
                "genre_conventions_met": genre_conventions["met"],
                "genre_expectations_satisfied": genre_expectations["satisfied"],
                "primary_genre": genre_identified["primary_genre"],
                "genres": genre_identified["genres"]
            },
            "meta": {
                "source": "DrGenre",
                "focus": "Genre analysis"
            }
        }


