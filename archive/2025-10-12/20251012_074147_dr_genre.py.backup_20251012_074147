@dataclass
class GenreProfile:
    """Overall genre analysis."""
    genre_identified: bool  # Clear what genre this is
    genre_clarity: bool  # Audience knows genre from opening
    genre_conventions_met: bool  # Follows genre rules
    genre_expectations_satisfied: bool  # Delivers what genre promises
    genre_tropes_present: bool  # Familiar elements used
    genre_tropes_fresh: bool  # Tropes subverted/refreshed (not clichéd)
    hybrid_genre_handling: bool  # If multiple genres, balanced
    action_genre_present: bool  # Action genre analysis
    drama_genre_present: bool  # Drama genre analysis
    comedy_genre_present: bool  # Comedy genre analysis
    thriller_genre_present: bool  # Thriller/suspense genre
    horror_genre_present: bool  # Horror genre
    romance_genre_present: bool  # Romance genre
    scifi_fantasy_genre_present: bool  # Sci-Fi/Fantasy genre
    mystery_genre_present: bool  # Mystery genre
    genre_tone_alignment: bool  # Genre matches tone
    genre_pacing_appropriate: bool  # Pacing fits genre
    genre_stakes_appropriate: bool  # Stakes level fits genre
    genre_resolution_appropriate: bool  # Resolution fits genre
    genre_confusion_detected: bool  # PENALTY (unclear what genre)
    genre_promise_broken: bool  # PENALTY (doesn't deliver expectations)
    genre_cliches_overused: bool  # PENALTY (too derivative)
    overall_genre_quality: float


@dataclass
class GenreAnalysisResults:
    """Complete genre analysis results."""
    genre_profile: GenreProfile
    identified_genres_list: List[str]  # Identified genre(s)
    conventions_met_list: List[str]  # Genre conventions present
    conventions_missing_list: List[str]  # Genre conventions missing
    expectations_list: List[str]  # Genre expectations
    tropes_list: List[str]  # Genre tropes identified
    hybrid_elements_list: List[str]  # If hybrid genre, elements
    genre_confusion_list: List[str]  # Genre confusion (PENALTY)
    genre_promise_broken_list: List[str]  # Promise broken (PENALTY)
    cliches_list: List[str]  # Overused clichés (PENALTY)
    score: float
    diagnosis: str
    recommendations: List[str]


