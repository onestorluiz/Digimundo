        """Find midpoint (typically page 50-60, middle of Act 2)."""
        lines = screenplay.split('\n')
        expected_page = int(page_count * 0.50)

        # Search around expected page (±10 pages)
        search_start = max(0, (expected_page - 10) * 55)
