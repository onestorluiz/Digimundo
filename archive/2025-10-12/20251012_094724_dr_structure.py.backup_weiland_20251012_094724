    def _analyze_act_proportions(self, act_structure: Dict, page_count: int) -> Dict[str, float]:
        """Analyze act proportions (ideal: 25/50/25)."""
        act1_end = act_structure.get("act1_end", 0)
        act2_end = act_structure.get("act2_end", 0)

        act1_pages = act1_end
        act2_pages = act2_end - act1_end
        act3_pages = page_count - act2_end

        return {
            "act1_percentage": (act1_pages / max(page_count, 1)) * 100,
            "act2_percentage": (act2_pages / max(page_count, 1)) * 100,
            "act3_percentage": (act3_pages / max(page_count, 1)) * 100,
            "act1_pages": act1_pages,
            "act2_pages": act2_pages,
            "act3_pages": act3_pages
        }

    def _proportions_match_paradigm(self, proportions: Dict) -> bool:
        """Check if proportions match Field's 25/50/25 paradigm."""
        act1_pct = proportions["act1_percentage"]
        act2_pct = proportions["act2_percentage"]
        act3_pct = proportions["act3_percentage"]

        # Allow 10% variance
        return (15 <= act1_pct <= 35 and
                40 <= act2_pct <= 60 and
                15 <= act3_pct <= 35)

    def _count_turning_points(self, screenplay: str) -> List[Dict]:
        """Count all turning points throughout screenplay."""
        turning_points = []
        lines = screenplay.split('\n')

        for i, line in enumerate(lines):
            line = line.strip()
            for marker in self.plot_point_markers:
                if marker in line.lower():
                    turning_points.append({
                        "page": i // 55,
                        "description": line[:80] + "..." if len(line) > 80 else line,
                        "marker": marker
                    })
                    break

        return turning_points

    def _detect_rising_action(self, screenplay: str) -> Dict[str, Any]:
        """Detect rising action and escalation."""
        count = 0
        examples = []

        for line in screenplay.split('\n'):
            for marker in self.rising_action_markers:
                if marker in line.lower():
                    count += 1
                    if len(examples) < 3:
                        examples.append(line[:80] + "..." if len(line) > 80 else line)
                    break

        return {
            "present": count > 0,
            "escalation_count": count,
            "examples": examples
        }

    def _check_opening_hook(self, screenplay: str) -> Dict[str, Any]:
        """Check for opening hook (first 3 pages)."""
        lines = screenplay.split('\n')
        first_pages = lines[:165]  # Roughly 3 pages

        for line in first_pages:
            for marker in self.opening_hook_markers:
                if marker in line.lower():
