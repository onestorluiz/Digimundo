    def _estimate_page_count(self, screenplay: str) -> int:
        """Estimate page count from screenplay text."""
        # Rough estimate: 55 lines per page
        lines = screenplay.split('\n')
        return max(1, len(lines) // 55)

    def _detect_three_act_structure(self, screenplay: str, page_count: int) -> Dict[str, Any]:
        """Detect three-act structure breaks."""
        # Expected act breaks (Field's paradigm: 25/50/25)
        expected_act1_end = int(page_count * 0.25)
        expected_act2_end = int(page_count * 0.75)

        # Search for explicit act markers or structural beats
        lines = screenplay.split('\n')
        current_page = 0

        act1_end = None
        act2_end = None

        for i, line in enumerate(lines):
            current_page = i // 55  # Rough page estimation

            # Check for plot point 1 (around page 25)
            if expected_act1_end - 5 <= current_page <= expected_act1_end + 5:
                if any(marker in line.lower() for marker in self.plot_point_markers):
                    act1_end = current_page

            # Check for plot point 2 (around page 75)
            if expected_act2_end - 5 <= current_page <= expected_act2_end + 5:
                if any(marker in line.lower() for marker in self.plot_point_markers):
                    act2_end = current_page

        # If not found explicitly, use expected positions
        if act1_end is None:
            act1_end = expected_act1_end
        if act2_end is None:
            act2_end = expected_act2_end

        return {
            "detected": True,
            "act1_end": act1_end,
            "act2_end": act2_end,
            "act3_end": page_count
        }

    def _find_inciting_incident(self, screenplay: str, page_count: int) -> Optional[Dict]:
        """Find the inciting incident (typically pages 10-15)."""
        lines = screenplay.split('\n')

        # Search in first 20% of script
        search_end = int(len(lines) * 0.20)

        for i in range(min(search_end, len(lines))):
            line = lines[i].strip()
            for marker in self.inciting_incident_markers:
                if marker in line.lower():
                    return {
                        "page": i // 55,
                        "description": line[:100] + "..." if len(line) > 100 else line,
                        "marker_used": marker
                    }

        return None

