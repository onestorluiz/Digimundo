    def _find_climax(self, screenplay: str, page_count: int) -> Optional[Dict]:
        """Find climax (typically pages 85-100, near end of Act 3)."""
        lines = screenplay.split('\n')

        # Search in last 20% of script
        search_start = int(len(lines) * 0.80)

        max_intensity = 0
        climax_line = None
        climax_page = None

        for i in range(search_start, len(lines)):
            line = lines[i].strip()

            # Calculate intensity based on climax markers
            intensity = sum(1 for marker in self.climax_markers if marker in line.lower())

            if intensity > max_intensity:
                max_intensity = intensity
                climax_line = line
                climax_page = i // 55

        if climax_line:
            return {
                "page": climax_page,
                "intensity": min(1.0, max_intensity / 5.0),
                "description": climax_line[:100] + "..." if len(climax_line) > 100 else climax_line
            }

        return None

