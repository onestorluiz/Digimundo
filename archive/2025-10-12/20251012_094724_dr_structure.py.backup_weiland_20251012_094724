        for setup in setups:
            for payoff in payoffs:
                if payoff["page"] > setup["page"]:
                    pairs.append({
                        "setup_page": setup["page"],
                        "payoff_page": payoff["page"],
                        "description": f"{setup['text'][:40]} → {payoff['text'][:40]}"
                    })
                    break

        return {
            "setups_count": len(setups),
            "payoffs_count": len(payoffs),
            "pairs": pairs[:10]  # Top 10 pairs
        }

    def _calculate_structural_coherence(self, act_structure: Dict,
                                       inciting_incident: Optional[Dict],
                                       plot_point_one: Optional[Dict],
                                       midpoint: Optional[Dict],
                                       plot_point_two: Optional[Dict],
                                       climax: Optional[Dict]) -> float:
        """Calculate overall structural coherence score."""
        score = 0.0

        # Each major structural element present adds to score
        if act_structure.get("detected"):
            score += 0.15
        if inciting_incident:
            score += 0.20
        if plot_point_one:
            score += 0.15
        if midpoint:
            score += 0.15
        if plot_point_two:
            score += 0.15
        if climax:
            score += 0.20

        return min(1.0, score)

    def _detect_beat_sheet(self, screenplay: str, page_count: int) -> Dict[str, Any]:
        """Detect Save the Cat beat sheet coverage."""
        lines = screenplay.split('\n')
        beats_found = {}

        for beat_name, markers in self.beat_sheet_markers.items():
            for i, line in enumerate(lines):
                for marker in markers:
                    if marker in line.lower():
                        beats_found[beat_name] = {
                            "page": i // 55,
                            "description": line[:60]
                        }
                        break
                if beat_name in beats_found:
                    break

        total_beats = len(self.beat_sheet_markers)
        coverage = (len(beats_found) / total_beats) * 100

        return {
            "coverage": coverage,
            "beats_found": beats_found,
            "total_possible": total_beats
        }

    def _analyze_pacing(self, screenplay: str, page_count: int, act_structure: Dict) -> Dict[str, Any]:
        """Analyze pacing consistency."""
        lines = screenplay.split('\n')

        # Measure scene density per act
        scenes = screenplay.count('INT.') + screenplay.count('EXT.')

        act1_end = act_structure.get("act1_end", 0) * 55
        act2_end = act_structure.get("act2_end", 0) * 55

        act1_text = '\n'.join(lines[:act1_end])
        act2_text = '\n'.join(lines[act1_end:act2_end])
        act3_text = '\n'.join(lines[act2_end:])

        act1_scenes = act1_text.count('INT.') + act1_text.count('EXT.')
        act2_scenes = act2_text.count('INT.') + act2_text.count('EXT.')
        act3_scenes = act3_text.count('INT.') + act3_text.count('EXT.')

        # Calculate variance (low variance = consistent pacing)
        scene_counts = [act1_scenes, act2_scenes, act3_scenes]
        mean_scenes = sum(scene_counts) / 3
        variance = sum((x - mean_scenes) ** 2 for x in scene_counts) / 3

        consistent = variance < 10  # Threshold for consistency

        return {
            "total_scenes": scenes,
            "act1_scenes": act1_scenes,
            "act2_scenes": act2_scenes,
            "act3_scenes": act3_scenes,
            "pacing_consistent": consistent,
            "variance": variance,
            "sagging_middle": act2_scenes < (act1_scenes * 0.5)  # Act 2 has too few scenes
        }

    def _check_structure_rules(self, profile: StructureProfile,
                               proportions: Dict, rising_action: Dict,
                               opening_hook: Dict, coherence: float) -> List[Dict]:
        """Check narrative structure against rules."""
        violations = []

        for rule in self.rules.get("rules", []):
            if rule["id"] == "STRUCT.R001":
                # Three-Act Structure Present
                if not (profile.act_one_end and profile.act_two_end):
                    violations.append({
                        "rule_id": rule["id"],
                        "title": rule["title"],
                        "severity": rule["severity"],
                        "message": "Three-act structure not clearly defined",
                        "fix": rule["fix"]
                    })

            elif rule["id"] == "STRUCT.R002":
                # Inciting Incident Present
                if not profile.inciting_incident:
                    violations.append({
                        "rule_id": rule["id"],
                        "title": rule["title"],
                        "severity": rule["severity"],
                        "message": "Inciting incident not detected",
                        "fix": rule["fix"]
                    })

            elif rule["id"] == "STRUCT.R003":
                # Plot Point 1 Present
                if not profile.plot_point_one:
                    violations.append({
                        "rule_id": rule["id"],
                        "title": rule["title"],
                        "severity": rule["severity"],
                        "message": "Plot Point 1 not detected",
                        "fix": rule["fix"]
                    })

            elif rule["id"] == "STRUCT.R004":
                # Midpoint Present
                if not profile.midpoint:
                    violations.append({
                        "rule_id": rule["id"],
                        "title": rule["title"],
                        "severity": rule["severity"],
                        "message": "Midpoint not detected",
                        "fix": rule["fix"]
                    })

            elif rule["id"] == "STRUCT.R005":
                # Plot Point 2 Present
                if not profile.plot_point_two:
                    violations.append({
                        "rule_id": rule["id"],
                        "title": rule["title"],
                        "severity": rule["severity"],
                        "message": "Plot Point 2 not detected",
                        "fix": rule["fix"]
                    })

            elif rule["id"] == "STRUCT.R006":
                # Climax Present
                if not profile.climax:
                    violations.append({
                        "rule_id": rule["id"],
                        "title": rule["title"],
                        "severity": rule["severity"],
                        "message": "Climax not detected",
                        "fix": rule["fix"]
                    })

            elif rule["id"] == "STRUCT.R007":
                # Act Proportions Correct
                if not self._proportions_match_paradigm(proportions):
                    violations.append({
                        "rule_id": rule["id"],
                        "title": rule["title"],
                        "severity": rule["severity"],
                        "message": f"Act proportions off: {proportions['act1_percentage']:.0f}/{proportions['act2_percentage']:.0f}/{proportions['act3_percentage']:.0f} (should be ~25/50/25)",
                        "fix": rule["fix"]
                    })

            elif rule["id"] == "STRUCT.R008":
                # Rising Action/Escalation
                if not rising_action["present"]:
                    violations.append({
                        "rule_id": rule["id"],
                        "title": rule["title"],
                        "severity": rule["severity"],
                        "message": "No rising action or escalation detected",
                        "fix": rule["fix"]
                    })

            elif rule["id"] == "STRUCT.R011":
                # Opening Hook
                if not opening_hook["present"]:
                    violations.append({
                        "rule_id": rule["id"],
                        "title": rule["title"],
                        "severity": rule["severity"],
                        "message": "Opening hook not detected",
                        "fix": rule["fix"]
                    })

            elif rule["id"] == "STRUCT.R015":
                # Structural Coherence
                if coherence < 0.6:
                    violations.append({
                        "rule_id": rule["id"],
                        "title": rule["title"],
                        "severity": rule["severity"],
                        "message": f"Low structural coherence: {coherence:.0%}",
                        "fix": rule["fix"]
                    })

        return violations

    def _calculate_structure_score(self, profile: StructureProfile,
                                   proportions: Dict, coherence: float,
                                   violations: List) -> float:
        """Calculate overall structure architecture score."""
        # Start at 90 (not 100 - no structure is perfect)
        score = 90.0

        # Deduct for violations
        for violation in violations:
            if violation["severity"] == "critical":
                score -= 20
            elif violation["severity"] == "high":
                score -= 15
            elif violation["severity"] == "medium":
                score -= 8
            elif violation["severity"] == "low":
                score -= 5

        # Bonus for excellence (max +15, capped at 95)
        if coherence > 0.9:
            score += 5
        elif coherence > 0.7:
            score += 3

        if self._proportions_match_paradigm(proportions):
            score += 5

        if profile.turning_points_count > 5:
            score += 3
        elif profile.turning_points_count > 3:
            score += 2

        # Cap at 95 (not 100 - always room for improvement)
        return max(5.0, min(95.0, score))

    def _generate_diagnosis(self, score: float, profile: StructureProfile,
                          proportions: Dict, violations: List) -> str:
        """Generate structure diagnosis summary."""
        if score >= 80:
            level = "EXCELLENT"
            summary = "Narrative structure is well-architected with clear acts and beats"
        elif score >= 60:
            level = "GOOD"
            summary = "Structure works but could be more precisely defined"
        elif score >= 40:
            level = "NEEDS WORK"
            summary = "Structural architecture issues affecting narrative flow"
        else:
            level = "POOR"
            summary = "Major structural construction problems throughout"

        diagnosis = f"STRUCTURE {level} ({score:.1f}/100): {summary}"

        # Add specific issues
        issues = []
        if not profile.inciting_incident:
            issues.append("no inciting incident")
        if not profile.midpoint:
            issues.append("missing midpoint")
        if not self._proportions_match_paradigm(proportions):
            issues.append("act proportions off")
        if profile.structural_coherence_score < 0.6:
            issues.append("low coherence")

        if issues:
            diagnosis += f". Key issues: {', '.join(issues)}"

        return diagnosis

    def _generate_recommendations(self, score: float, violations: List,
                                 profile: StructureProfile,
                                 proportions: Dict) -> List[str]:
        """Generate specific structure recommendations."""
        recommendations = []

        # Add recommendations based on violations
        for violation in violations[:3]:  # Top 3 violations
            recommendations.append(f"[{violation['severity'].upper()}] {violation['fix']}")

        # Add specific recommendations
        if not profile.inciting_incident:
            recommendations.append("Establish clear inciting incident in first 10-15 pages")

        if not profile.midpoint:
            recommendations.append("Add midpoint (false victory/defeat) at page 50-60")

        if not self._proportions_match_paradigm(proportions):
            recommendations.append(f"Rebalance acts to 25/50/25 (currently {proportions['act1_percentage']:.0f}/{proportions['act2_percentage']:.0f}/{proportions['act3_percentage']:.0f})")

        if profile.turning_points_count < 3:
            recommendations.append("Add more turning points to create narrative momentum")

        if not profile.opening_hook_present:
            recommendations.append("Strengthen opening with immediate hook or action")

        # General excellence recommendations
        if score < 40:
            recommendations.append("Study three-act structure in acclaimed screenplays")
            recommendations.append("Apply Field's paradigm worksheet to restructure")

        return recommendations[:5]  # Return top 5

    def export_structure_features(self, screenplay_text: str) -> Dict[str, Any]:
        """
        Export structure features for correlation/analysis.

        Returns structured data with narrative structure metrics.
        Useful for external indexing, correlation engines, or ML pipelines.

        Args:
            screenplay_text: Full screenplay text

        Returns:
            Dict with keys:
                - page_metrics: Total pages and act breaks
                - plot_points: All major structural beats
                - proportions: Act proportions analysis
                - coherence: Structural coherence metrics
                - meta: Additional metadata
        """
        page_count = self._estimate_page_count(screenplay_text)
        act_structure = self._detect_three_act_structure(screenplay_text, page_count)

        inciting_incident = self._find_inciting_incident(screenplay_text, page_count)
        plot_point_one = self._find_plot_point_one(screenplay_text, page_count)
        midpoint = self._find_midpoint(screenplay_text, page_count)
        plot_point_two = self._find_plot_point_two(screenplay_text, page_count)
        climax = self._find_climax(screenplay_text, page_count)
        resolution = self._find_resolution(screenplay_text, page_count)

        act_proportions = self._analyze_act_proportions(act_structure, page_count)
        coherence = self._calculate_structural_coherence(
            act_structure, inciting_incident, plot_point_one,
            midpoint, plot_point_two, climax
        )

        return {
            "page_metrics": {
                "total_pages": page_count,
                "act_one_end": act_structure.get("act1_end"),
                "act_two_end": act_structure.get("act2_end"),
                "act_three_end": page_count
            },
            "plot_points": {
                "inciting_incident": inciting_incident,
                "plot_point_one": plot_point_one,
                "midpoint": midpoint,
                "plot_point_two": plot_point_two,
                "climax": climax,
                "resolution": resolution
            },
            "proportions": {
                "act1_percentage": act_proportions["act1_percentage"],
                "act2_percentage": act_proportions["act2_percentage"],
                "act3_percentage": act_proportions["act3_percentage"],
                "matches_paradigm": self._proportions_match_paradigm(act_proportions)
            },
            "coherence": {
                "score": coherence,
                "all_elements_present": coherence >= 1.0,
                "major_gaps": coherence < 0.6
            },
            "meta": {
                "source": "DrStructure",
                "paradigm": "Syd Field 25/50/25"
            }
        }


