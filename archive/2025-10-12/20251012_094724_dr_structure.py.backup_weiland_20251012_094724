                    }

        # Check for action-oriented opening
        action_words = ["explosion", "chase", "fight", "crash", "run", "battle"]
        for line in first_pages:
            if any(word in line.lower() for word in action_words):
                return {
                    "present": True,
                    "description": f"Action opening: {line[:80]}..."
                }

        return {"present": False}

