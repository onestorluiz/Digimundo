        """Find Plot Point 1 (typically page 25, end of Act 1)."""
        lines = screenplay.split('\n')
        expected_page = int(page_count * 0.25)

        # Search around expected page (±5 pages)
        search_start = max(0, (expected_page - 5) * 55)
        search_end = min(len(lines), (expected_page + 5) * 55)

        for i in range(search_start, search_end):
            line = lines[i].strip()
            for marker in self.plot_point_markers:
                if marker in line.lower():
                    return {
                        "page": i // 55,
                        "description": line[:100] + "..." if len(line) > 100 else line,
                        "expected_page": expected_page
                    }

        return None

