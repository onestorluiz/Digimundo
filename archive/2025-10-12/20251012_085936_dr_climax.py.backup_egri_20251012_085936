        Too early = before 75%, too late = after 98%
        """
        too_early = False
        too_late = False

        if not climax_detection["present"]:
            return {"too_early": False, "too_late": False}

        climax_page = climax_detection["page"]
        climax_percentage = (climax_page / page_count) * 100

        if climax_percentage < 75:
            too_early = True
        elif climax_percentage > 98:
            too_late = True

        return {
