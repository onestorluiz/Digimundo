        }

    def _assess_climax_intensity(self, ultimate_confrontation: Dict,
                                 peak_tension: Dict, stakes_maximized: Dict) -> float:
        """Assess climax intensity (0-1)."""
        scores = [
            1.0 if ultimate_confrontation["present"] else 0.0,
            ultimate_confrontation.get("intensity", 0.0),
            1.0 if peak_tension["achieved"] else 0.0,
            peak_tension.get("score", 0.0),
            1.0 if stakes_maximized["maximized"] else 0.0
        ]

        return sum(scores) / len(scores)

    def _assess_climax_satisfaction(self, theme_expression: Dict,
                                   character_transformation: Dict,
                                   emotional_peak: Dict,
                                   anticlimax: Dict, weak_climax: Dict) -> float:
        """Assess climax satisfaction (0-1)."""
        scores = [
            1.0 if theme_expression["expressed"] else 0.5,
            theme_expression.get("clarity", 0.0),
            1.0 if character_transformation["present"] else 0.5,
            1.0 if emotional_peak["achieved"] else 0.5,
            0.0 if anticlimax["detected"] else 1.0,  # PENALTY
            0.0 if weak_climax["detected"] else 1.0   # PENALTY
        ]

        return sum(scores) / len(scores)

    def _calculate_overall_climax_quality(self, profile: ClimaxProfile) -> float:
        """Calculate overall climax quality score."""
        scores = [
            1.0 if profile.climax_present else 0.0,
            profile.climax_placement_score,
            1.0 if profile.ultimate_confrontation else 0.3,
            1.0 if profile.peak_tension_achieved else 0.3,
            1.0 if profile.theme_expressed_at_climax else 0.6,
            1.0 if profile.stakes_maximized else 0.4,
            1.0 if profile.character_transformation_moment else 0.5,
            1.0 if profile.crisis_vs_climax_distinct else 0.7,
            1.0 if profile.resolution_setup else 0.7,
            1.0 if profile.all_forces_converge else 0.6,
            1.0 if profile.emotional_peak_achieved else 0.6,
            1.0 if profile.intellectual_peak_achieved else 0.7,
            1.0 if profile.moral_choice_at_climax else 0.7,
            0.0 if profile.anticlimax_detected else 1.0,  # PENALTY
            0.0 if profile.weak_climax_detected else 1.0,  # PENALTY
            0.0 if profile.climax_too_early else 1.0,  # PENALTY
            0.0 if profile.climax_too_late else 1.0,  # PENALTY
            profile.climax_intensity,
            profile.climax_satisfaction
        ]

        # Average
        overall = sum(scores) / len(scores)

        return max(0.0, min(1.0, overall))

    def _check_climax_rules(self, profile: ClimaxProfile, climax_detection: Dict,
                           climax_placement: Dict, ultimate_confrontation: Dict,
                           peak_tension: Dict, theme_expression: Dict,
                           stakes_maximized: Dict, character_transformation: Dict,
                           crisis_vs_climax: Dict, resolution_setup: Dict,
                           forces_converge: Dict, emotional_peak: Dict,
                           intellectual_peak: Dict, moral_choice: Dict,
                           anticlimax: Dict, weak_climax: Dict,
                           timing_problems: Dict) -> List[Dict]:
        """Check climax against rules."""
        violations = []

        for rule in self.rules.get("rules", []):
            if rule["id"] == "CLIMAX.R001":
                # Climax Present
                if not profile.climax_present:
