    def _estimate_page_count(self, screenplay: str) -> int:
        """Estimate page count from screenplay text."""
        lines = screenplay.split('\n')
        return max(1, len(lines) // 55)

    def _extract_scenes(self, screenplay: str) -> List[Dict]:
        """Extract all scenes from screenplay."""
        scenes = []
        lines = screenplay.split('\n')
        current_scene = None
        scene_number = 0

        for i, line in enumerate(lines):
            # Detect scene heading
            if re.match(r'^(INT\.|EXT\.)', line.strip()):
                # Save previous scene
                if current_scene:
                    current_scene['end_line'] = i - 1
                    current_scene['end_page'] = (i - 1) // 55
                    scenes.append(current_scene)

                # Start new scene
                scene_number += 1
                current_scene = {
                    'number': scene_number,
                    'heading': line.strip(),
                    'start_line': i,
                    'start_page': i // 55,
                    'content': []
                }
            elif current_scene:
                current_scene['content'].append(line)

        # Add last scene
        if current_scene:
            current_scene['end_line'] = len(lines) - 1
            current_scene['end_page'] = (len(lines) - 1) // 55
            scenes.append(current_scene)

        return scenes

    def _extract_pages(self, screenplay: str, start_page: int, end_page: int) -> str:
        """Extract specific page range from screenplay."""
        lines = screenplay.split('\n')
        start_line = start_page * 55
        end_line = end_page * 55
        return '\n'.join(lines[start_line:end_line])

    def _detect_climax(self, screenplay: str, page_count: int) -> Dict[str, Any]:
        """
        Detect climax presence and location.

        McKee/Field: "Climax occurs in Act 3, typically 85-95% through script."
        """
        present = False
        page = 0
        description = ""

        # Expected climax range: pages 85-95% of script
        expected_start = int(page_count * 0.85)
        expected_end = int(page_count * 0.95)

        # Extract Act 3
        act3_text = self._extract_pages(screenplay, expected_start, page_count)

        # Check for climax markers
        climax_count = 0
        for marker in self.climax_markers:
            if marker in act3_text.lower():
                climax_count += 1
                present = True
                if not description:
                    for line in act3_text.split('\n'):
                        if marker in line.lower():
                            description = line.strip()[:200]
                            break

        # If climax markers found, estimate page
        if present:
            page = expected_start + (expected_end - expected_start) // 2
        else:
            # Check entire screenplay
            for marker in self.climax_markers:
                if marker in screenplay.lower():
                    present = True
                    page = page_count - 10  # Assume near end
                    description = "Climax detected but not in optimal location"
                    break

        return {
            "present": present,
            "page": page,
            "description": description or "No clear climax detected",
            "climax_count": climax_count
        }

    def _analyze_climax_placement(self, climax_detection: Dict, page_count: int) -> Dict[str, Any]:
        """
        Analyze climax placement quality.

        Optimal: 85-95% through script (Field/McKee)
        """
        if not climax_detection["present"]:
            return {"score": 0.0, "optimal": False, "notes": "No climax detected"}

        climax_page = climax_detection["page"]
        climax_percentage = (climax_page / page_count) * 100

        # Optimal range: 85-95%
        if 85 <= climax_percentage <= 95:
            score = 1.0
            optimal = True
            notes = f"Optimal placement at {climax_percentage:.1f}% through script"
        elif 80 <= climax_percentage < 85 or 95 < climax_percentage <= 100:
            score = 0.7
            optimal = False
            notes = f"Acceptable but not optimal placement at {climax_percentage:.1f}%"
        elif 70 <= climax_percentage < 80:
            score = 0.4
            optimal = False
            notes = f"Too early - climax at {climax_percentage:.1f}% (should be 85-95%)"
        else:
            score = 0.2
            optimal = False
            notes = f"Poor placement at {climax_percentage:.1f}%"

        return {
            "score": score,
            "optimal": optimal,
            "percentage": climax_percentage,
            "notes": notes
        }

    def _detect_ultimate_confrontation(self, act3_text: str) -> Dict[str, Any]:
        """
        Detect ultimate confrontation (protagonist vs antagonist).

        McKee/Field: "Climax is ultimate confrontation between protagonist and antagonistic force."
        """
        present = False
        face_off = False
        intensity = 0.0

        # Check for ultimate confrontation markers
        confrontation_count = 0
        for marker in self.ultimate_confrontation_markers:
            confrontation_count += act3_text.lower().count(marker)

        if confrontation_count >= 2:
            present = True
            face_off = True
            intensity = min(1.0, confrontation_count / 4.0)
        elif confrontation_count >= 1:
            present = True
            face_off = False
            intensity = 0.5

        return {
            "present": present,
            "face_off": face_off,
            "intensity": intensity,
            "confrontation_count": confrontation_count
        }

