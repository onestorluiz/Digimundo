        return violations

    def _calculate_climax_score(self, profile: ClimaxProfile, violations: List) -> float:
        """Calculate overall climax score."""
        # Start at 90
        score = 90.0

        # Deduct for violations
        for violation in violations:
            if violation["severity"] == "critical":
                score -= 20
            elif violation["severity"] == "high":
                score -= 15
            elif violation["severity"] == "medium":
                score -= 8
            elif violation["severity"] == "low":
                score -= 5

        # Extra penalty for anticlimax/weak climax
        if profile.anticlimax_detected:
            score -= 25  # critical penalty
        if profile.weak_climax_detected:
            score -= 20  # major penalty
        if profile.climax_too_early:
            score -= 15
        if profile.climax_too_late:
            score -= 10

        # Bonus for excellence
        if profile.overall_climax_quality > 0.85:
            score += 5
        elif profile.overall_climax_quality > 0.75:
            score += 3

        if profile.ultimate_confrontation and profile.peak_tension_achieved:
            score += 3

        if profile.theme_expressed_at_climax:
            score += 3

        if profile.character_transformation_moment:
            score += 2

        if profile.climax_intensity > 0.8:
            score += 2

        # Cap at 95
        return max(5.0, min(95.0, score))

    def _generate_diagnosis(self, score: float, profile: ClimaxProfile,
                          violations: List) -> str:
        """Generate climax diagnosis summary."""
        if score >= 80:
            level = "EXCELLENT"
            summary = "Climax delivers powerful ultimate confrontation at peak tension"
        elif score >= 60:
            level = "GOOD"
            summary = "Climax solid but could be more intense"
        elif score >= 40:
            level = "NEEDS WORK"
            summary = "Climax problems - weak or poorly placed"
        else:
            level = "POOR"
            summary = "Major climax problems - fails to deliver"

        diagnosis = f"CLIMAX {level} ({score:.1f}/100): {summary}"

        # Add specific issues
        issues = []
        if not profile.climax_present:
            issues.append("no climax")
        if not profile.ultimate_confrontation:
            issues.append("no confrontation")
        if profile.anticlimax_detected:
            issues.append("anticlimax")
        if profile.weak_climax_detected:
            issues.append("weak climax")
        if not profile.peak_tension_achieved:
            issues.append("low tension")
        if not profile.theme_expressed_at_climax:
            issues.append("theme not expressed")

        if issues:
            diagnosis += f". Key issues: {', '.join(issues)}"

        return diagnosis

    def _generate_recommendations(self, score: float, violations: List,
                                 profile: ClimaxProfile) -> List[str]:
        """Generate specific climax recommendations."""
        recommendations = []

        # Add recommendations based on violations
        for violation in violations[:3]:
            recommendations.append(f"[{violation['severity'].upper()}] {violation['fix']}")

        # Add specific recommendations
        if not profile.climax_present:
            recommendations.append("Create clear climax - McKee/Field: 'Ultimate confrontation where protagonist faces antagonistic force' - this is story's peak moment")

        if not profile.ultimate_confrontation:
            recommendations.append("Add ultimate confrontation - McKee: 'Protagonist must face antagonist directly' - no substitutes, no evasion, direct face-off")

        if profile.anticlimax_detected:
            recommendations.append("Fix anticlimax - McKee: 'Climax must deliver on all setups' - avoid disappointment, deliver satisfying payoff, meet audience expectations")

        if profile.weak_climax_detected:
            recommendations.append("Strengthen climax - Avoid deus ex machina - McKee: 'Victory must be earned through character's choices and actions' - increase difficulty, raise stakes")

        if not profile.peak_tension_achieved:
            recommendations.append("Maximize tension at climax - McKee: 'All accumulated pressure released at climax' - this is highest tension point in entire story")

        if not profile.theme_expressed_at_climax:
            recommendations.append("Express theme at climax - McKee: 'Controlling idea proved through climactic action' - theme must be demonstrated, not stated")

        # General excellence recommendations
        if score < 40:
            recommendations.append("Study McKee's Story - climax structure and ultimate confrontation fundamental")
            recommendations.append("Study Field's Screenplay - Act 3 structure and climax placement")

        return recommendations[:5]

    def export_climax_features(self, screenplay_text: str) -> Dict[str, Any]:
        """
        Export climax features for correlation/analysis.

        Returns structured data with climax metrics.
        """
        page_count = self._estimate_page_count(screenplay_text)
        climax_detection = self._detect_climax(screenplay_text, page_count)
        act3_text = self._extract_pages(screenplay_text, int(page_count * 0.75), page_count)
        ultimate_confrontation = self._detect_ultimate_confrontation(act3_text)
        peak_tension = self._analyze_peak_tension(act3_text)

        return {
            "climax": {
                "present": climax_detection["present"],
                "page": climax_detection["page"],
                "placement_percentage": (climax_detection["page"] / page_count * 100) if climax_detection["present"] else 0
            },
            "ultimate_confrontation": {
                "present": ultimate_confrontation["present"],
                "intensity": ultimate_confrontation.get("intensity", 0.0)
            },
            "peak_tension": {
                "achieved": peak_tension["achieved"],
                "score": peak_tension.get("score", 0.0)
            },
            "meta": {
                "source": "DrClimax",
                "focus": "Ultimate confrontation and peak tension at climax"
            }
        }


