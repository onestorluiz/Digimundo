@dataclass
class MotivationProfile:
    """Overall motivation analysis."""
    want_clear: bool  # Conscious goal/desire (what protagonist wants)
    need_identified: bool  # Unconscious/deeper need (what protagonist needs)
    want_vs_need_distinction: bool  # Want ≠ need (Truby's key insight)
    goal_specific: bool  # Goal is specific and measurable
    goal_clarity: float  # 0-1 (how clear/specific is the goal)
    motivation_established_early: bool  # First 10-15 pages
    motivation_consistent: bool  # Doesn't change arbitrarily
    obstacles_to_goal: bool  # Active opposition to protagonist's goal
    motivation_drives_action: bool  # Protagonist actively pursues goal
    emotional_motivation: bool  # Why protagonist cares (emotional stake)
    motivation_relatable: bool  # Audience understands/relates to motivation
    antagonist_motivation_clear: bool  # Antagonist has clear opposing goal
    supporting_motivations: bool  # Allies have their own motivations
    unclear_motivation_detected: bool  # PENALTY (audience doesn't know what protagonist wants)
    passive_protagonist_detected: bool  # PENALTY (no clear drive/desire)
    inconsistent_motivation_detected: bool  # PENALTY (motivation changes arbitrarily)
    overall_motivation_quality: float


@dataclass
class MotivationAnalysisResults:
    """Complete motivation analysis results."""
    motivation_profile: MotivationProfile
    want_list: List[str]  # Protagonist's conscious desires
    need_list: List[str]  # Protagonist's unconscious needs
    goal_statements: List[str]  # Specific goal articulations
    obstacles_list: List[str]  # Obstacles to achieving goal
    motivation_moments: List[str]  # Moments showing motivation
    score: float
    diagnosis: str
    recommendations: List[str]


