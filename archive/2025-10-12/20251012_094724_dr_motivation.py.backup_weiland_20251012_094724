    def _estimate_page_count(self, screenplay: str) -> int:
        """Estimate page count from screenplay text."""
        lines = screenplay.split('\n')
        return max(1, len(lines) // 55)

    def _extract_scenes(self, screenplay: str) -> List[Dict]:
        """Extract all scenes from screenplay."""
        scenes = []
        lines = screenplay.split('\n')
        current_scene = None
        scene_number = 0

        for i, line in enumerate(lines):
            # Detect scene heading
            if re.match(r'^(INT\.|EXT\.)', line.strip()):
                # Save previous scene
                if current_scene:
                    current_scene['end_line'] = i - 1
                    current_scene['end_page'] = (i - 1) // 55
                    scenes.append(current_scene)

                # Start new scene
                scene_number += 1
                current_scene = {
                    'number': scene_number,
                    'heading': line.strip(),
                    'start_line': i,
                    'start_page': i // 55,
                    'content': []
                }
            elif current_scene:
                current_scene['content'].append(line)

        # Add last scene
        if current_scene:
            current_scene['end_line'] = len(lines) - 1
            current_scene['end_page'] = (len(lines) - 1) // 55
            scenes.append(current_scene)

        return scenes

    def _extract_pages(self, screenplay: str, start_page: int, end_page: int) -> str:
        """Extract specific page range from screenplay."""
        lines = screenplay.split('\n')
        start_line = start_page * 55
        end_line = end_page * 55
        return '\n'.join(lines[start_line:end_line])

    def _analyze_want_clear(self, screenplay: str, opening_text: str) -> Dict[str, Any]:
        """
        Analyze want/desire clarity (conscious goal).

        Truby: "Protagonist must want something - desire line drives story."
        McKee: "Protagonist's conscious desire is what story tracks."
        """
        clear = False
        want_list = []

        # Check for want/desire markers
        want_count = 0
        for marker in self.want_clear_markers:
            count = screenplay.lower().count(marker)
            want_count += count
            if count > 0:
                # Extract want context
                for line in screenplay.split('\n'):
                    if marker in line.lower():
                        want_list.append(line.strip()[:100])
                        if len(want_list) >= 20:
                            break

        if want_count >= 8:
            clear = True
        elif want_count >= 5:
            clear = True

        return {
            "clear": clear,
            "count": want_count,
            "want_list": want_list
        }

    def _analyze_need_identified(self, screenplay: str, climax_text: str) -> Dict[str, Any]:
        """
        Analyze need identification (unconscious/deeper need).

        Truby: "Need is what protagonist must learn/gain - often unconscious."
        McKee: "True character emerges under pressure - reveals deeper need."
        """
        identified = False
        need_list = []

        # Check for need markers
        need_count = 0
        for marker in self.need_markers:
            count = screenplay.lower().count(marker)
            need_count += count
            if count > 0:
                # Extract need context
                for line in screenplay.split('\n'):
                    if marker in line.lower():
                        need_list.append(line.strip()[:100])
                        if len(need_list) >= 20:
                            break

        # Higher weight for need markers in climax (Truby: need often fulfilled at climax)
        climax_need_count = 0
        for marker in self.need_markers:
            climax_need_count += climax_text.lower().count(marker)

        if need_count >= 5 or climax_need_count >= 2:
            identified = True
        elif need_count >= 3:
            identified = True

        return {
            "identified": identified,
            "count": need_count,
            "climax_count": climax_need_count,
            "need_list": need_list
        }

