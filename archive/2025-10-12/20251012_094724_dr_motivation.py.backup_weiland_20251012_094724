            detected = True
            penalty = True
        elif passive_count >= 3:
            detected = True
            penalty = True

        return {
            "detected": detected,
            "penalty": penalty,
            "count": passive_count
        }

    def _detect_inconsistent_motivation(self, screenplay: str) -> Dict[str, Any]:
        """
        Detect inconsistent motivation (PENALTY - changes arbitrarily).

        Truby: "Protagonist's desire shouldn't change arbitrarily - motivation must be consistent."
        """
        detected = False
        penalty = False

        # Check for inconsistent motivation markers
        inconsistent_count = 0
        for marker in self.inconsistent_motivation_markers:
            inconsistent_count += screenplay.lower().count(marker)

        if inconsistent_count >= 3:
            detected = True
            penalty = True
        elif inconsistent_count >= 2:
            detected = True
            penalty = True

        return {
            "detected": detected,
            "penalty": penalty,
            "count": inconsistent_count
        }

    def _calculate_overall_motivation_quality(self, profile: MotivationProfile) -> float:
        """Calculate overall motivation quality score."""
        scores = [
            1.0 if profile.want_clear else 0.2,  # CRITICAL
            1.0 if profile.need_identified else 0.6,  # Important but not all stories
            1.0 if profile.want_vs_need_distinction else 0.7,  # Sophisticated storytelling
            1.0 if profile.goal_specific else 0.4,  # CRITICAL
            profile.goal_clarity,  # Variable
            1.0 if profile.motivation_established_early else 0.3,  # CRITICAL
            1.0 if profile.motivation_consistent else 0.4,  # Important
            1.0 if profile.obstacles_to_goal else 0.5,  # Important
            1.0 if profile.motivation_drives_action else 0.2,  # CRITICAL
            1.0 if profile.emotional_motivation else 0.6,  # Important
            1.0 if profile.motivation_relatable else 0.7,  # Nice to have
            1.0 if profile.antagonist_motivation_clear else 0.6,  # Important
            1.0 if profile.supporting_motivations else 0.8,  # Nice to have
            0.0 if profile.unclear_motivation_detected else 1.0,  # PENALTY
            0.0 if profile.passive_protagonist_detected else 1.0,  # PENALTY
            0.0 if profile.inconsistent_motivation_detected else 1.0  # PENALTY
        ]

        # Average
        overall = sum(scores) / len(scores)

        return max(0.0, min(1.0, overall))

    def _check_motivation_rules(self, profile: MotivationProfile, want_clear: Dict,
                                need_identified: Dict, want_vs_need: Dict,
                                goal_specific: Dict, goal_clarity: Dict,
                                motivation_early: Dict, motivation_consistent: Dict,
                                obstacles: Dict, drives_action: Dict,
                                emotional_motivation: Dict, motivation_relatable: Dict,
                                antagonist_motivation: Dict, supporting_motivations: Dict,
                                unclear_motivation: Dict, passive_protagonist: Dict,
                                inconsistent_motivation: Dict) -> List[Dict]:
        """Check motivation against rules."""
        violations = []

        for rule in self.rules.get("rules", []):
            if rule["id"] == "MOTIVATION.R001":
                # Want/Desire Clear
                if not profile.want_clear:
                    violations.append({
                        "rule_id": rule["id"],
                        "title": rule["title"],
                        "severity": rule["severity"],
                        "message": "Want/desire unclear - audience doesn't know what protagonist wants",
                        "fix": rule["fix"]
                    })

            elif rule["id"] == "MOTIVATION.R002":
                # Need Identified
                if not profile.need_identified:
                    violations.append({
                        "rule_id": rule["id"],
                        "title": rule["title"],
                        "severity": rule["severity"],
                        "message": "Need not identified - protagonist lacks deeper unconscious need",
                        "fix": rule["fix"]
                    })

            elif rule["id"] == "MOTIVATION.R003":
                # Want vs Need Distinction
                if not profile.want_vs_need_distinction:
                    violations.append({
                        "rule_id": rule["id"],
                        "title": rule["title"],
                        "severity": rule["severity"],
                        "message": "Want vs need not distinguished - lacks Truby's sophisticated storytelling",
                        "fix": rule["fix"]
                    })

            elif rule["id"] == "MOTIVATION.R004":
                # Goal Specific
                if not profile.goal_specific:
                    violations.append({
                        "rule_id": rule["id"],
                        "title": rule["title"],
                        "severity": rule["severity"],
                        "message": "Goal not specific - vague goals = weak story",
                        "fix": rule["fix"]
                    })

            elif rule["id"] == "MOTIVATION.R005":
                # Goal Clarity
                if profile.goal_clarity < 0.5:
                    violations.append({
                        "rule_id": rule["id"],
                        "title": rule["title"],
                        "severity": rule["severity"],
                        "message": f"Goal clarity weak ({profile.goal_clarity:.1f}/1.0) - audience unclear on protagonist's goal",
                        "fix": rule["fix"]
                    })

            elif rule["id"] == "MOTIVATION.R006":
                # Motivation Established Early
                if not profile.motivation_established_early:
                    violations.append({
                        "rule_id": rule["id"],
                        "title": rule["title"],
                        "severity": rule["severity"],
                        "message": "Motivation not established in first 10-15 pages",
                        "fix": rule["fix"]
                    })

            elif rule["id"] == "MOTIVATION.R007":
                # Motivation Consistent
                if not profile.motivation_consistent:
                    violations.append({
                        "rule_id": rule["id"],
                        "title": rule["title"],
                        "severity": rule["severity"],
                        "message": "Motivation inconsistent - changes arbitrarily without reason",
                        "fix": rule["fix"]
                    })

            elif rule["id"] == "MOTIVATION.R008":
                # Obstacles to Goal
                if not profile.obstacles_to_goal:
                    violations.append({
                        "rule_id": rule["id"],
                        "title": rule["title"],
                        "severity": rule["severity"],
                        "message": "Insufficient obstacles - protagonist's desire not tested",
                        "fix": rule["fix"]
                    })

            elif rule["id"] == "MOTIVATION.R009":
                # Motivation Drives Action
                if not profile.motivation_drives_action:
                    violations.append({
                        "rule_id": rule["id"],
                        "title": rule["title"],
                        "severity": rule["severity"],
                        "message": "Motivation doesn't drive action - passive protagonist",
                        "fix": rule["fix"]
                    })

            elif rule["id"] == "MOTIVATION.R010":
                # Emotional Motivation
                if not profile.emotional_motivation:
                    violations.append({
                        "rule_id": rule["id"],
                        "title": rule["title"],
                        "severity": rule["severity"],
                        "message": "Emotional motivation weak - why protagonist cares not clear",
                        "fix": rule["fix"]
                    })

            elif rule["id"] == "MOTIVATION.R011":
                # Motivation Relatable
                if not profile.motivation_relatable:
                    violations.append({
                        "rule_id": rule["id"],
                        "title": rule["title"],
                        "severity": rule["severity"],
                        "message": "Motivation not relatable - audience can't connect with protagonist's desire",
                        "fix": rule["fix"]
                    })

            elif rule["id"] == "MOTIVATION.R012":
                # Antagonist Motivation Clear
                if not profile.antagonist_motivation_clear:
                    violations.append({
                        "rule_id": rule["id"],
                        "title": rule["title"],
                        "severity": rule["severity"],
                        "message": "Antagonist motivation unclear - opposing goal not defined",
                        "fix": rule["fix"]
                    })

            elif rule["id"] == "MOTIVATION.R013":
                # Avoid Unclear Motivation
                if profile.unclear_motivation_detected:
                    violations.append({
                        "rule_id": rule["id"],
                        "title": rule["title"],
                        "severity": rule["severity"],
                        "message": "Unclear motivation detected - audience lost on what protagonist wants",
                        "fix": rule["fix"]
                    })

            elif rule["id"] == "MOTIVATION.R014":
                # Avoid Passive Protagonist
                if profile.passive_protagonist_detected:
                    violations.append({
                        "rule_id": rule["id"],
                        "title": rule["title"],
                        "severity": rule["severity"],
                        "message": "Passive protagonist detected - lacks clear drive and desire",
                        "fix": rule["fix"]
                    })

            elif rule["id"] == "MOTIVATION.R015":
                # Avoid Inconsistent Motivation
                if profile.inconsistent_motivation_detected:
                    violations.append({
                        "rule_id": rule["id"],
                        "title": rule["title"],
                        "severity": rule["severity"],
                        "message": "Inconsistent motivation detected - changes arbitrarily",
                        "fix": rule["fix"]
                    })

        return violations

    def _calculate_motivation_score(self, profile: MotivationProfile, violations: List) -> float:
        """Calculate overall motivation score."""
        # Start at 90
        score = 90.0

        # Deduct for violations
        for violation in violations:
            if violation["severity"] == "critical":
                score -= 20
            elif violation["severity"] == "high":
                score -= 15
            elif violation["severity"] == "medium":
                score -= 8
            elif violation["severity"] == "low":
                score -= 5

        # Extra penalty for major issues
        if profile.unclear_motivation_detected:
            score -= 25  # critical penalty
        if profile.passive_protagonist_detected:
            score -= 25  # critical penalty
        if profile.inconsistent_motivation_detected:
            score -= 15

        # Bonus for excellence
        if profile.overall_motivation_quality > 0.85:
            score += 5
        elif profile.overall_motivation_quality > 0.75:
            score += 3

        if profile.want_clear and profile.motivation_established_early:
            score += 3

        if profile.want_vs_need_distinction:
            score += 3  # Sophisticated storytelling (Truby)

        if profile.motivation_drives_action:
            score += 2

        if profile.obstacles_to_goal:
            score += 2

        # Cap at 95
        return max(5.0, min(95.0, score))

    def _generate_diagnosis(self, score: float, profile: MotivationProfile,
                          violations: List) -> str:
        """Generate motivation diagnosis summary."""
        if score >= 80:
            level = "EXCELLENT"
            summary = "Motivation clear with protagonist actively pursuing specific goal"
        elif score >= 60:
            level = "GOOD"
            summary = "Motivation present but could be clearer or more active"
        elif score >= 40:
            level = "NEEDS WORK"
            summary = "Motivation problems - unclear goal or passive protagonist"
        else:
            level = "POOR"
            summary = "Major motivation problems - unclear desire or passive approach"

        diagnosis = f"MOTIVATION {level} ({score:.1f}/100): {summary}"

        # Add specific issues
        issues = []
        if not profile.want_clear:
            issues.append("unclear want")
        if not profile.motivation_established_early:
            issues.append("late establishment")
        if profile.unclear_motivation_detected:
            issues.append("confusing motivation")
        if profile.passive_protagonist_detected:
            issues.append("passive protagonist")
        if profile.inconsistent_motivation_detected:
            issues.append("inconsistent desire")
        if not profile.motivation_drives_action:
            issues.append("doesn't drive action")

        if issues:
            diagnosis += f". Key issues: {', '.join(issues)}"

        return diagnosis

    def _generate_recommendations(self, score: float, violations: List,
                                 profile: MotivationProfile) -> List[str]:
        """Generate specific motivation recommendations."""
        recommendations = []

        # Add recommendations based on violations
        for violation in violations[:3]:
            recommendations.append(f"[{violation['severity'].upper()}] {violation['fix']}")

        # Add specific recommendations
        if not profile.want_clear:
            recommendations.append("Clarify want - Truby: 'Protagonist must want something - desire line drives story' - establish clear conscious goal")

        if not profile.motivation_established_early:
            recommendations.append("Establish motivation early - Field/Snyder: 'Protagonist's goal must be clear in first 10-15 pages' - don't wait")

        if profile.passive_protagonist_detected:
            recommendations.append("Activate protagonist - McKee: 'Passive protagonist = weak story. Protagonist must drive action' - make them pursue goal actively")

        if profile.unclear_motivation_detected:
            recommendations.append("Clarify motivation - Truby: 'If audience doesn't know what protagonist wants, they're lost' - make desire explicit")

        if not profile.want_vs_need_distinction:
            recommendations.append("Distinguish want vs need - Truby: 'Want ≠ Need - protagonist wants X but needs Y. Best stories show this distinction' - add deeper layer")

        if not profile.motivation_drives_action:
            recommendations.append("Let motivation drive action - Truby: 'Desire drives plot - protagonist actively pursues goal' - connect motivation to plot progression")

        # General excellence recommendations
        if score < 40:
            recommendations.append("Study Truby's Anatomy of Story - want, need, desire line fundamental")
            recommendations.append("Study McKee's Story - character motivation essential")

        return recommendations[:5]

    def export_motivation_features(self, screenplay_text: str) -> Dict[str, Any]:
        """
        Export motivation features for correlation/analysis.

        Returns structured data with motivation metrics.
        """
        page_count = self._estimate_page_count(screenplay_text)
        opening_text = self._extract_pages(screenplay_text, 0, 15)
        want_clear = self._analyze_want_clear(screenplay_text, opening_text)
        drives_action = self._analyze_motivation_drives_action(screenplay_text)

        return {
            "motivation": {
                "want_clear": want_clear["clear"],
                "drives_action": drives_action["drives"]
            },
            "meta": {
                "source": "DrMotivation",
                "focus": "Character motivation and desire"
            }
        }


