    def analyze(self, screenplay_text: str) -> Dict[str, Any]:
        """
        Analyze character motivation in screenplay.

        Args:
            screenplay_text: The full screenplay text

        Returns:
            Complete motivation diagnostic report
        """
        # Extract page count and scenes
        page_count = self._estimate_page_count(screenplay_text)
        scenes = self._extract_scenes(screenplay_text)

        # Extract opening (first 10-15 pages) for early motivation establishment
        opening_text = self._extract_pages(screenplay_text, 0, 15)

        # Extract Act 1 (first 25%) for motivation setup
        act1_text = self._extract_pages(screenplay_text, 0, int(page_count * 0.25))

        # Extract climax (last 15 pages) for need fulfillment
        climax_text = self._extract_pages(screenplay_text, max(0, page_count - 15), page_count)

        # Analyze want clear (conscious goal/desire)
        want_clear = self._analyze_want_clear(screenplay_text, opening_text)

        # Analyze need identified (unconscious/deeper need - Truby)
        need_identified = self._analyze_need_identified(screenplay_text, climax_text)

        # Analyze want vs need distinction (Truby's key insight)
        want_vs_need = self._analyze_want_vs_need_distinction(screenplay_text)

        # Analyze goal specific (measurable objective)
        goal_specific = self._analyze_goal_specific(screenplay_text)

        # Analyze goal clarity (how clear/specific)
        goal_clarity = self._analyze_goal_clarity(screenplay_text, opening_text)

        # Analyze motivation established early (first 10-15 pages)
        motivation_early = self._analyze_motivation_established_early(opening_text)

        # Analyze motivation consistent (doesn't change arbitrarily)
        motivation_consistent = self._analyze_motivation_consistent(screenplay_text)

        # Analyze obstacles to goal (active opposition)
        obstacles = self._analyze_obstacles_to_goal(screenplay_text)

        # Analyze motivation drives action (protagonist active)
        drives_action = self._analyze_motivation_drives_action(screenplay_text)

        # Analyze emotional motivation (why protagonist cares)
        emotional_motivation = self._analyze_emotional_motivation(screenplay_text)

        # Analyze motivation relatable (audience understands)
        motivation_relatable = self._analyze_motivation_relatable(screenplay_text)

        # Analyze antagonist motivation (opposing goal)
        antagonist_motivation = self._analyze_antagonist_motivation(screenplay_text)

        # Analyze supporting motivations (allies have goals)
        supporting_motivations = self._analyze_supporting_motivations(screenplay_text)

        # Detect unclear motivation (PENALTY)
        unclear_motivation = self._detect_unclear_motivation(screenplay_text)

        # Detect passive protagonist (PENALTY)
        passive_protagonist = self._detect_passive_protagonist(screenplay_text)

        # Detect inconsistent motivation (PENALTY)
        inconsistent_motivation = self._detect_inconsistent_motivation(screenplay_text)

        # Build motivation profile
        motivation_profile = MotivationProfile(
            want_clear=want_clear["clear"],
            need_identified=need_identified["identified"],
            want_vs_need_distinction=want_vs_need["distinct"],
            goal_specific=goal_specific["specific"],
            goal_clarity=goal_clarity["clarity"],
            motivation_established_early=motivation_early["established"],
            motivation_consistent=motivation_consistent["consistent"],
            obstacles_to_goal=obstacles["present"],
            motivation_drives_action=drives_action["drives"],
            emotional_motivation=emotional_motivation["present"],
            motivation_relatable=motivation_relatable["relatable"],
            antagonist_motivation_clear=antagonist_motivation["clear"],
            supporting_motivations=supporting_motivations["present"],
            unclear_motivation_detected=unclear_motivation["detected"],
            passive_protagonist_detected=passive_protagonist["detected"],
            inconsistent_motivation_detected=inconsistent_motivation["detected"],
            overall_motivation_quality=0.0  # calculated below
        )

        # Calculate overall motivation quality
        motivation_profile.overall_motivation_quality = self._calculate_overall_motivation_quality(motivation_profile)

        # Check against rules
        rule_violations = self._check_motivation_rules(
            motivation_profile, want_clear, need_identified, want_vs_need,
