    def _analyze_goal_clarity(self, screenplay: str, opening_text: str) -> Dict[str, Any]:
        """
        Analyze goal clarity (how clear/specific is goal).

        McKee/Field: "Audience must know protagonist's goal clearly - what are they after?"
        """
        clarity = 0.0

        # Count want + goal markers
        total_markers = 0
        for marker in self.want_clear_markers + self.goal_specific_markers:
            total_markers += opening_text.lower().count(marker)

        # Calculate clarity score
        if total_markers >= 10:
            clarity = 1.0
        elif total_markers >= 7:
            clarity = 0.8
        elif total_markers >= 5:
            clarity = 0.6
        elif total_markers >= 3:
            clarity = 0.4
        else:
            clarity = 0.2

        return {
            "clarity": clarity,
            "marker_count": total_markers
        }

