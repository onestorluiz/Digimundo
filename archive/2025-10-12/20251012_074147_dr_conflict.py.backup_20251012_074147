    def _estimate_page_count(self, screenplay: str) -> int:
        """Estimate page count from screenplay text."""
        lines = screenplay.split('\n')
        return max(1, len(lines) // 55)

    def _extract_scenes(self, screenplay: str) -> List[Dict]:
        """Extract all scenes from screenplay."""
        scenes = []
        lines = screenplay.split('\n')
        current_scene = None
        scene_number = 0

        for i, line in enumerate(lines):
            # Detect scene heading
            if re.match(r'^(INT\.|EXT\.)', line.strip()):
                # Save previous scene
                if current_scene:
                    current_scene['end_line'] = i - 1
                    current_scene['end_page'] = (i - 1) // 55
                    scenes.append(current_scene)

                # Start new scene
                scene_number += 1
                current_scene = {
                    'number': scene_number,
                    'heading': line.strip(),
                    'start_line': i,
                    'start_page': i // 55,
                    'content': []
                }
            elif current_scene:
                current_scene['content'].append(line)

        # Add last scene
        if current_scene:
            current_scene['end_line'] = len(lines) - 1
            current_scene['end_page'] = (len(lines) - 1) // 55
            scenes.append(current_scene)

        return scenes

    def _detect_central_conflict(self, screenplay: str) -> Dict[str, Any]:
        """
        Identify the central/main conflict.

        McKee: "Story is the quest to close the gap between expectation and result."
        The central conflict is the main dramatic question/tension of the story.
        """
        # Count general conflict markers
        conflict_count = 0
        for marker in self.conflict_markers:
            conflict_count += screenplay.lower().count(marker)

        # Look for explicit conflict descriptions (usually in first 10 pages)
        lines = screenplay.split('\n')
        first_10_pages = '\n'.join(lines[:550])  # ~10 pages

        # Find most prominent conflict type
        antagonist_mentions = sum(1 for marker in self.antagonist_markers if marker in screenplay.lower())
        internal_mentions = sum(1 for marker in self.internal_conflict_markers if marker in screenplay.lower())
        external_mentions = sum(1 for marker in self.external_conflict_markers if marker in screenplay.lower())

        # Determine central conflict type
        if antagonist_mentions > 5:
            if internal_mentions > 3:
                description = "Protagonist vs Antagonist with internal struggle"
            else:
                description = "Protagonist vs Antagonist"
        elif internal_mentions > external_mentions:
            description = "Internal conflict - protagonist vs self"
        elif external_mentions > 5:
            description = "External conflict - protagonist vs outside force"
        else:
            description = "Unclear central conflict"

        # Assess clarity and strength
        clear = conflict_count >= 10 and (antagonist_mentions >= 3 or internal_mentions >= 3)

        if conflict_count >= 30:
            strength = "strong"
        elif conflict_count >= 15:
            strength = "medium"
        else:
            strength = "weak"

        return {
            "description": description,
            "clear": clear,
            "strength": strength,
            "conflict_markers": conflict_count
        }

    def _analyze_antagonist(self, screenplay: str) -> Dict[str, Any]:
        """
        Analyze antagonist/antagonistic force.

        Seger: "Worthy opponent makes stronger story."
        McKee: "Protagonist needs formidable opposition."
        """
        # Count antagonist markers
        antagonist_count = 0
        for marker in self.antagonist_markers:
            antagonist_count += screenplay.lower().count(marker)

        present = antagonist_count >= 3

        # Calculate strength (0-1)
        strength = min(1.0, antagonist_count / 20.0)

        # Determine antagonist type
        if "villain" in screenplay.lower() or "evil" in screenplay.lower():
            antagonist_type = "villain"
        elif "rival" in screenplay.lower() or "competitor" in screenplay.lower():
            antagonist_type = "rival"
        elif "system" in screenplay.lower() or "society" in screenplay.lower():
            antagonist_type = "system/society"
        elif "self" in screenplay.lower() and any(marker in screenplay.lower() for marker in self.internal_conflict_markers):
            antagonist_type = "self (internal)"
        else:
            antagonist_type = "opposing force"

        # Assessment
        if strength >= 0.7:
            assessment = "Strong antagonistic force - worthy opponent"
        elif strength >= 0.5:
            assessment = "Adequate antagonist - provides opposition"
        elif strength >= 0.3:
            assessment = "Weak antagonist - needs more presence/power"
        else:
            assessment = "Antagonist unclear or absent"

        return {
            "present": present,
            "strength": strength,
            "type": antagonist_type,
            "count": antagonist_count,
            "assessment": assessment
        }

    def _analyze_internal_conflict(self, screenplay: str) -> Dict[str, Any]:
        """
        Analyze internal conflict (protagonist vs self).

        McKee: "Best stories have both internal and external conflict."
        Internal conflict = inner struggle, moral dilemma, self-doubt.
        """
        # Count internal conflict markers
        count = 0
        examples = []

        for line in screenplay.split('\n'):
            for marker in self.internal_conflict_markers:
                if marker in line.lower():
                    count += 1
                    if len(examples) < 5:
                        examples.append(line.strip()[:80])
                    break

        score = min(1.0, count / 10.0)
        present = count >= 3

        return {
            "score": score,
            "present": present,
            "count": count,
            "examples": examples
        }

    def _analyze_external_conflict(self, screenplay: str) -> Dict[str, Any]:
        """
        Analyze external conflict (protagonist vs outside force).

        External conflict = protagonist against antagonist, society, nature, etc.
        """
        # Count external conflict markers
        count = 0
        for marker in self.external_conflict_markers:
            count += screenplay.lower().count(marker)

        # Also count antagonist presence as external conflict
        antagonist_count = sum(1 for marker in self.antagonist_markers if marker in screenplay.lower())
        count += antagonist_count // 2

        score = min(1.0, count / 15.0)
        present = count >= 5

        # Determine strength
        if count >= 20:
            strength = "strong"
        elif count >= 10:
            strength = "medium"
        else:
            strength = "weak"

        return {
            "score": score,
            "present": present,
            "count": count,
            "strength": strength
        }

    def _analyze_conflict_layers(self, screenplay: str, internal: Dict, external: Dict) -> Dict[str, Any]:
        """
        Analyze multiple conflict layers.

        McKee/Egri: "Multiple conflict layers create dramatic richness."
        Best stories have internal + external + moral/relational conflicts.
        """
        layers = []

        # Internal conflict layer
        if internal["present"]:
            layers.append("internal")

        # External conflict layer
        if external["present"]:
            layers.append("external")

        # Moral conflict layer
        moral_count = sum(1 for marker in self.moral_conflict_markers if marker in screenplay.lower())
        if moral_count >= 2:
            layers.append("moral")

        # Relational conflict layer
        relational_count = sum(1 for marker in self.relational_conflict_markers if marker in screenplay.lower())
        if relational_count >= 2:
            layers.append("relational")

        # Ideological conflict layer
        ideological_count = sum(1 for marker in self.ideological_conflict_markers if marker in screenplay.lower())
        if ideological_count >= 2:
            layers.append("ideological")

        layer_count = len(layers)

        # Determine richness
        if layer_count >= 4:
            richness = "excellent"
        elif layer_count >= 3:
            richness = "good"
        elif layer_count >= 2:
            richness = "adequate"
        else:
            richness = "thin"

        return {
            "layer_count": layer_count,
            "types": layers,
            "richness": richness
        }

    def _analyze_conflict_escalation(self, screenplay: str) -> Dict[str, Any]:
        """
        Analyze conflict escalation (progressive complications).

        McKee/Field: "Conflict must escalate - build in intensity."
        Progressive complications = conflict gets worse, stakes rise.
        """
        # Count escalation markers
        escalation_count = 0
        for marker in self.escalation_markers:
            escalation_count += screenplay.lower().count(marker)

        # Count progressive complication markers
        complication_count = sum(1 for marker in self.progressive_complications_markers if marker in screenplay.lower())

        total = escalation_count + complication_count
        present = total >= 5

        # Determine quality
        if total >= 15:
            quality = "excellent"
        elif total >= 8:
            quality = "good"
        elif total >= 5:
            quality = "adequate"
        else:
            quality = "poor"

        return {
            "present": present,
            "count": total,
            "quality": quality
        }

    def _assess_worthy_opponent(self, screenplay: str, antagonist_analysis: Dict) -> Dict[str, Any]:
        """
        Assess worthy opponent quality.

        Seger: "Worthy opponent = antagonist as strong or stronger than protagonist."
        A worthy opponent makes the story more compelling.
        """
        # Count worthy opponent markers
        worthy_count = 0
        for marker in self.worthy_opponent_markers:
            worthy_count += screenplay.lower().count(marker)

        # Antagonist strength from previous analysis
        antagonist_strength = antagonist_analysis.get("strength", 0.0)

        # Combined score
        score = (antagonist_strength + min(1.0, worthy_count / 5.0)) / 2.0

        worthy = score >= 0.6

        if worthy:
            notes = "Antagonist is worthy opponent - strong opposition"
        else:
            notes = "Antagonist too weak - needs more power/presence"

        return {
            "worthy": worthy,
            "score": score,
            "worthy_count": worthy_count,
            "notes": notes
        }

    def _analyze_scene_conflict(self, screenplay: str, scenes: List[Dict]) -> Dict[str, Any]:
        """
        Analyze conflict presence in every scene.

        Seger: "Every scene should have conflict - even subtle."
        Scene-level conflict creates continuous tension.
        """
        if not scenes:
            return {
                "ratio": 0.0,
                "scenes_with_conflict": 0,
                "total_scenes": 0,
                "quality": "none"
            }

        scenes_with_conflict = 0

        for scene in scenes:
            scene_text = '\n'.join(scene['content'])

            # Check for any conflict markers
            has_conflict = any(marker in scene_text.lower() for marker in self.conflict_markers)

            # Also check for tension, opposition, obstacles
            has_tension = any(marker in scene_text.lower() for marker in self.tension_markers)
            has_opposition = any(marker in scene_text.lower() for marker in self.opposition_markers)
            has_obstacle = any(marker in scene_text.lower() for marker in self.obstacle_markers)

            if has_conflict or has_tension or has_opposition or has_obstacle:
                scenes_with_conflict += 1

        ratio = scenes_with_conflict / len(scenes)

        # Determine quality
        if ratio >= 0.8:
            quality = "excellent"
        elif ratio >= 0.6:
            quality = "good"
        elif ratio >= 0.4:
            quality = "adequate"
        else:
            quality = "poor"

        return {
            "ratio": ratio,
            "scenes_with_conflict": scenes_with_conflict,
            "total_scenes": len(scenes),
            "quality": quality
        }

    def _detect_moral_conflict(self, screenplay: str) -> Dict[str, Any]:
        """
        Detect moral/ethical conflict.

        Truby: "Moral argument through moral conflict and choices."
        Moral conflict = ethical dilemmas, right vs wrong, conscience.
        """
        # Count moral conflict markers
        count = 0
        examples = []

        for line in screenplay.split('\n'):
            for marker in self.moral_conflict_markers:
                if marker in line.lower():
                    count += 1
                    if len(examples) < 3:
                        examples.append(line.strip()[:80])
                    break

        present = count >= 2

        return {
            "present": present,
            "count": count,
            "examples": examples
        }

    def _detect_relational_conflict(self, screenplay: str) -> Dict[str, Any]:
        """
        Detect relational/interpersonal conflict.

        Relational conflict = tension in relationships (family, romantic, friendship).
        """
        # Count relational conflict markers
        count = 0
        for marker in self.relational_conflict_markers:
            count += screenplay.lower().count(marker)

        present = count >= 2

        # Identify relationship types
        types = []
        if "family" in screenplay.lower() or "father" in screenplay.lower() or "mother" in screenplay.lower():
            types.append("family")
        if "romantic" in screenplay.lower() or "love" in screenplay.lower():
            types.append("romantic")
        if "friend" in screenplay.lower() or "friendship" in screenplay.lower():
            types.append("friendship")
        if "betrayal" in screenplay.lower() or "trust" in screenplay.lower():
            types.append("trust/betrayal")

        return {
            "present": present,
            "count": count,
            "types": types
        }

    def _detect_ideological_conflict(self, screenplay: str) -> Dict[str, Any]:
        """
        Detect ideological conflict (belief systems clash).

        Ideological conflict = worldview clash, values conflict, cultural/political/religious differences.
        """
        # Count ideological conflict markers
        count = 0
        for marker in self.ideological_conflict_markers:
            count += screenplay.lower().count(marker)

        present = count >= 2

        # Determine clash type
        if "political" in screenplay.lower():
            clash_type = "political"
        elif "religious" in screenplay.lower() or "faith" in screenplay.lower():
            clash_type = "religious"
        elif "cultural" in screenplay.lower() or "culture" in screenplay.lower():
            clash_type = "cultural"
        elif "belief" in screenplay.lower() or "worldview" in screenplay.lower():
            clash_type = "philosophical"
        else:
            clash_type = "values"

        return {
            "present": present,
            "count": count,
            "clash_type": clash_type
        }

    def _analyze_obstacle_strength(self, screenplay: str) -> Dict[str, Any]:
        """
        Analyze obstacle strength and effectiveness.

        Field/McKee: "Obstacles must be strong - test protagonist."
        Strong obstacles = protagonist must struggle to overcome.
        """
        # Count obstacle markers
        count = 0
        for marker in self.obstacle_markers:
            count += screenplay.lower().count(marker)

        # Calculate strength (0-1)
        strength = min(1.0, count / 20.0)

        effective = strength >= 0.5

        return {
            "strength": strength,
            "count": count,
            "effective": effective
        }

    def _analyze_progressive_complications(self, screenplay: str) -> Dict[str, Any]:
        """
        Analyze progressive complications (conflict getting worse).

        McKee: "Story is series of progressive complications."
        Things must get worse before they get better.
        """
        # Count progressive complication markers
        count = 0
        for marker in self.progressive_complications_markers:
            count += screenplay.lower().count(marker)

        present = count >= 3

        # Check if escalating (later mentions > earlier mentions)
        lines = screenplay.split('\n')
        first_half = '\n'.join(lines[:len(lines)//2])
        second_half = '\n'.join(lines[len(lines)//2:])

        first_half_count = sum(1 for marker in self.progressive_complications_markers if marker in first_half.lower())
        second_half_count = sum(1 for marker in self.progressive_complications_markers if marker in second_half.lower())

        escalating = second_half_count > first_half_count

        return {
            "present": present,
            "count": count,
            "escalating": escalating
        }

    def _analyze_climactic_confrontation(self, screenplay: str) -> Dict[str, Any]:
        """
        Analyze climactic confrontation (ultimate conflict).

        McKee/Field: "Climax = ultimate confrontation between protagonist and antagonistic force."
        """
        # Look for climactic confrontation markers (usually in last 20% of script)
        lines = screenplay.split('\n')
        last_20_percent = '\n'.join(lines[int(len(lines)*0.8):])

        # Count climactic confrontation markers
        count = 0
        for marker in self.climactic_confrontation_markers:
            count += last_20_percent.lower().count(marker)

        # Also check for high conflict density in last section
        conflict_density = sum(1 for marker in self.conflict_markers if marker in last_20_percent.lower())

        present = count >= 1 or conflict_density >= 10

        # Estimate intensity
        intensity = min(1.0, (count + conflict_density / 10.0) / 5.0)

        # Estimate location (page)
        if present:
            location = f"Last 20% of script (estimated page {int(len(lines) * 0.8 / 55)}+)"
        else:
            location = "Not detected"

        return {
            "present": present,
            "location": location,
            "intensity": intensity,
            "count": count
        }

    def _assess_conflict_resolution(self, screenplay: str) -> Dict[str, Any]:
        """
        Assess how conflict resolves.

        McKee: "Resolution must be earned - logical result of protagonist's choices."
        """
        # Look for resolution markers (usually in last 10% of script)
        lines = screenplay.split('\n')
        last_10_percent = '\n'.join(lines[int(len(lines)*0.9):])

        # Count resolution markers
        resolution_count = 0
        for marker in self.resolution_markers:
            resolution_count += last_10_percent.lower().count(marker)

        # Determine resolution type
        if "peace" in last_10_percent.lower() or "reconciled" in last_10_percent.lower():
            resolution_type = "reconciliation"
        elif "overcome" in last_10_percent.lower() or "victory" in last_10_percent.lower():
            resolution_type = "victory"
        elif "defeat" in last_10_percent.lower() or "loss" in last_10_percent.lower():
            resolution_type = "defeat"
        elif "compromise" in last_10_percent.lower() or "agreement" in last_10_percent.lower():
            resolution_type = "compromise"
        elif resolution_count >= 1:
            resolution_type = "resolved"
        else:
            resolution_type = "unclear"

        satisfying = resolution_count >= 1
        earned = resolution_count >= 2  # Multiple resolution markers suggest earned resolution

        return {
            "type": resolution_type,
            "satisfying": satisfying,
            "earned": earned,
            "resolution_count": resolution_count
        }

    def _calculate_overall_conflict_quality(self, profile: ConflictProfile) -> float:
        """Calculate overall conflict quality score."""
        scores = [
            1.0 if profile.antagonist_present else 0.0,
            profile.antagonist_strength,
            profile.internal_conflict_score,
            profile.external_conflict_score,
            profile.conflict_layers / 5.0,  # Normalize to 0-1
            1.0 if profile.conflict_escalation else 0.0,
            profile.scene_conflict_ratio,
            profile.obstacle_strength,
            1.0 if profile.progressive_complications else 0.0,
            1.0 if profile.climactic_confrontation else 0.0
        ]

        # Average
        overall = sum(scores) / len(scores)

        return max(0.0, min(1.0, overall))

    def _check_conflict_rules(self, profile: ConflictProfile, central_conflict: Dict,
                             antagonist_analysis: Dict, internal_conflict: Dict,
                             external_conflict: Dict, scene_conflict: Dict,
                             climactic_confrontation: Dict, conflict_resolution: Dict) -> List[Dict]:
        """Check conflict against rules."""
        violations = []

        for rule in self.rules.get("rules", []):
            if rule["id"] == "CONFLICT.R001":
                # Conflict Present
                if not central_conflict.get("clear", False):
                    violations.append({
                        "rule_id": rule["id"],
                        "title": rule["title"],
                        "severity": rule["severity"],
                        "message": "Central conflict unclear or absent",
                        "fix": rule["fix"]
                    })

            elif rule["id"] == "CONFLICT.R002":
                # Clear Antagonist/Opposition
                if not profile.antagonist_present:
                    violations.append({
                        "rule_id": rule["id"],
                        "title": rule["title"],
                        "severity": rule["severity"],
                        "message": "No clear antagonist or opposing force",
                        "fix": rule["fix"]
                    })

            elif rule["id"] == "CONFLICT.R003":
                # Internal Conflict
                if profile.internal_conflict_score < 0.3:
                    violations.append({
                        "rule_id": rule["id"],
                        "title": rule["title"],
                        "severity": rule["severity"],
                        "message": "Internal conflict weak or absent",
                        "fix": rule["fix"]
                    })

            elif rule["id"] == "CONFLICT.R004":
                # External Conflict
                if profile.external_conflict_score < 0.4:
                    violations.append({
                        "rule_id": rule["id"],
                        "title": rule["title"],
                        "severity": rule["severity"],
                        "message": "External conflict weak or absent",
                        "fix": rule["fix"]
                    })

            elif rule["id"] == "CONFLICT.R005":
                # Conflict Escalates
                if not profile.conflict_escalation:
                    violations.append({
                        "rule_id": rule["id"],
                        "title": rule["title"],
                        "severity": rule["severity"],
                        "message": "Conflict doesn't escalate - flat intensity",
                        "fix": rule["fix"]
                    })

            elif rule["id"] == "CONFLICT.R006":
                # Worthy Opponent
                if profile.antagonist_strength < 0.5:
                    violations.append({
                        "rule_id": rule["id"],
                        "title": rule["title"],
                        "severity": rule["severity"],
                        "message": f"Antagonist too weak: {profile.antagonist_strength:.1%}",
                        "fix": rule["fix"]
                    })

            elif rule["id"] == "CONFLICT.R007":
                # Conflict in Every Scene
                if profile.scene_conflict_ratio < 0.6:
                    violations.append({
                        "rule_id": rule["id"],
                        "title": rule["title"],
                        "severity": rule["severity"],
                        "message": f"Only {profile.scene_conflict_ratio:.1%} scenes have conflict",
                        "fix": rule["fix"]
                    })

            elif rule["id"] == "CONFLICT.R008":
                # Multiple Conflict Layers
                if profile.conflict_layers < 2:
                    violations.append({
                        "rule_id": rule["id"],
                        "title": rule["title"],
                        "severity": rule["severity"],
                        "message": f"Only {profile.conflict_layers} conflict layer(s) - needs more depth",
                        "fix": rule["fix"]
                    })

            elif rule["id"] == "CONFLICT.R009":
                # Moral/Ethical Conflict
                if not profile.moral_conflict_present:
                    violations.append({
                        "rule_id": rule["id"],
                        "title": rule["title"],
                        "severity": rule["severity"],
                        "message": "No moral/ethical conflict dimension",
                        "fix": rule["fix"]
                    })

            elif rule["id"] == "CONFLICT.R010":
                # Relational Conflict
                if not profile.relational_conflict_present:
                    violations.append({
                        "rule_id": rule["id"],
                        "title": rule["title"],
                        "severity": rule["severity"],
                        "message": "No relational conflict dimension",
                        "fix": rule["fix"]
                    })

            elif rule["id"] == "CONFLICT.R011":
                # Ideological Conflict
                # This is low priority - not all stories need it
                pass

            elif rule["id"] == "CONFLICT.R012":
                # Obstacle Strength
                if profile.obstacle_strength < 0.4:
                    violations.append({
                        "rule_id": rule["id"],
                        "title": rule["title"],
                        "severity": rule["severity"],
                        "message": "Obstacles too weak",
                        "fix": rule["fix"]
                    })

            elif rule["id"] == "CONFLICT.R013":
                # Progressive Complications
                if not profile.progressive_complications:
                    violations.append({
                        "rule_id": rule["id"],
                        "title": rule["title"],
                        "severity": rule["severity"],
                        "message": "No progressive complications - conflict doesn't worsen",
                        "fix": rule["fix"]
                    })

            elif rule["id"] == "CONFLICT.R014":
                # Climactic Confrontation
                if not profile.climactic_confrontation:
                    violations.append({
                        "rule_id": rule["id"],
                        "title": rule["title"],
                        "severity": rule["severity"],
                        "message": "No climactic confrontation detected",
                        "fix": rule["fix"]
                    })

            elif rule["id"] == "CONFLICT.R015":
                # Conflict Resolution
                if conflict_resolution["type"] == "unclear":
                    violations.append({
                        "rule_id": rule["id"],
                        "title": rule["title"],
                        "severity": rule["severity"],
                        "message": "Conflict resolution unclear",
                        "fix": rule["fix"]
                    })

        return violations

    def _calculate_conflict_score(self, profile: ConflictProfile, violations: List) -> float:
        """Calculate overall conflict score."""
        # Start at 90
        score = 90.0

        # Deduct for violations
        for violation in violations:
            if violation["severity"] == "critical":
                score -= 20
            elif violation["severity"] == "high":
                score -= 15
            elif violation["severity"] == "medium":
                score -= 8
            elif violation["severity"] == "low":
                score -= 5

        # Bonus for excellence
        if profile.overall_conflict_quality > 0.8:
            score += 5
        elif profile.overall_conflict_quality > 0.7:
            score += 3

        if profile.worthy_opponent and profile.conflict_escalation:
            score += 3

        if profile.conflict_layers >= 4:
            score += 3

        if profile.scene_conflict_ratio >= 0.8:
            score += 2

        if profile.progressive_complications and profile.climactic_confrontation:
            score += 2

        # Cap at 95
        return max(5.0, min(95.0, score))

    def _generate_diagnosis(self, score: float, profile: ConflictProfile,
                          violations: List) -> str:
        """Generate conflict diagnosis summary."""
        if score >= 80:
            level = "EXCELLENT"
            summary = "Conflict is clear, escalating, and multi-layered"
        elif score >= 60:
            level = "GOOD"
            summary = "Conflict is present but could be stronger"
        elif score >= 40:
            level = "NEEDS WORK"
            summary = "Conflict weak or antagonist unclear"
        else:
            level = "POOR"
            summary = "Major conflict problems - unclear or absent"

        diagnosis = f"CONFLICT {level} ({score:.1f}/100): {summary}"

        # Add specific issues
        issues = []
        if not profile.antagonist_present:
            issues.append("no clear antagonist")
        if not profile.conflict_escalation:
            issues.append("flat conflict")
        if profile.conflict_layers < 2:
            issues.append("thin conflict layers")
        if not profile.worthy_opponent:
            issues.append("weak antagonist")

        if issues:
            diagnosis += f". Key issues: {', '.join(issues)}"

        return diagnosis

    def _generate_recommendations(self, score: float, violations: List,
                                 profile: ConflictProfile) -> List[str]:
        """Generate specific conflict recommendations."""
        recommendations = []

        # Add recommendations based on violations
        for violation in violations[:3]:
            recommendations.append(f"[{violation['severity'].upper()}] {violation['fix']}")

        # Add specific recommendations
        if not profile.antagonist_present:
            recommendations.append("Create clear antagonist or opposing force (McKee/Seger/Field)")

        if profile.antagonist_strength < 0.5:
            recommendations.append("Strengthen antagonist - must be worthy opponent (Seger: 'Worthy opponent = stronger story')")

        if not profile.conflict_escalation:
            recommendations.append("Escalate conflict progressively - conflict must build (McKee/Field)")

        if profile.conflict_layers < 2:
            recommendations.append("Add conflict layers - internal + external + moral creates richness (McKee)")

        if profile.scene_conflict_ratio < 0.6:
            recommendations.append("Add conflict to more scenes - every scene should have tension (Seger)")

        if not profile.progressive_complications:
            recommendations.append("Add progressive complications - things get worse before better (McKee)")

        if not profile.climactic_confrontation:
            recommendations.append("Create climactic confrontation - ultimate showdown (McKee/Field)")

        # General excellence recommendations
        if score < 40:
            recommendations.append("Study McKee's Story - conflict is gap between expectation and result")
            recommendations.append("Study Egri's Art of Dramatic Writing - unity of opposites creates dramatic power")

        return recommendations[:5]

    def export_conflict_features(self, screenplay_text: str) -> Dict[str, Any]:
        """
        Export conflict features for correlation/analysis.

        Returns structured data with conflict metrics.
        Useful for external indexing, correlation engines, or ML pipelines.

        Args:
            screenplay_text: Full screenplay text

        Returns:
            Dict with conflict metrics
        """
        central_conflict = self._detect_central_conflict(screenplay_text)
