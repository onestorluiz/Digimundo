    def _estimate_page_count(self, screenplay: str) -> int:
        """Estimate page count from screenplay text."""
        lines = screenplay.split('\n')
        return max(1, len(lines) // 55)

    def _extract_scenes(self, screenplay: str) -> List[Dict]:
        """Extract all scenes from screenplay."""
        scenes = []
        lines = screenplay.split('\n')
        current_scene = None
        scene_number = 0

        for i, line in enumerate(lines):
            # Detect scene heading
            if re.match(r'^(INT\.|EXT\.)', line.strip()):
                # Save previous scene
                if current_scene:
                    current_scene['end_line'] = i - 1
                    current_scene['end_page'] = (i - 1) // 55
                    scenes.append(current_scene)

                # Start new scene
                scene_number += 1
                current_scene = {
                    'number': scene_number,
                    'heading': line.strip(),
                    'start_line': i,
                    'start_page': i // 55,
                    'content': []
                }
            elif current_scene:
                current_scene['content'].append(line)

        # Add last scene
        if current_scene:
            current_scene['end_line'] = len(lines) - 1
            current_scene['end_page'] = (len(lines) - 1) // 55
            scenes.append(current_scene)

        return scenes

    def _extract_pages(self, screenplay: str, start_page: int, end_page: int) -> str:
        """Extract specific page range from screenplay."""
        lines = screenplay.split('\n')
        start_line = start_page * 55
        end_line = end_page * 55
        return '\n'.join(lines[start_line:end_line])

    def _detect_world_established(self, opening_text: str) -> Dict[str, Any]:
        """
        Detect world established in opening.

        McKee/Field: "Opening pages establish world - audience must know where we are."
        """
        established = False
        description = ""

        # Check for world established markers
        world_count = 0
        for marker in self.world_established_markers:
            world_count += opening_text.lower().count(marker)

        if world_count >= 5:
            established = True
            description = "World clearly established in opening"
        elif world_count >= 3:
            established = True
            description = "World established but could be clearer"
        else:
            description = "World not clearly established in opening"

        return {
            "established": established,
            "world_count": world_count,
            "description": description
        }

    def _analyze_setting_clear(self, screenplay: str, scenes: List[Dict]) -> Dict[str, Any]:
        """
        Analyze setting clarity (specific locations).

        Field/Seger: "Setting must be specific and clear - audience knows where every scene takes place."
        """
        clear = False
        locations = []

        # Count scene headings (INT./EXT. indicates clear locations)
        scene_headings = len(scenes)

        # Extract location names from scene headings
        for scene in scenes:
            heading = scene['heading']
            # Extract location (after INT./EXT.)
            match = re.search(r'(INT\.|EXT\.)\s+(.+)', heading)
            if match:
                location = match.group(2).strip()
                locations.append(location)

        # Check if locations are specific
        if scene_headings >= 10 and len(locations) >= 10:
            clear = True
        elif scene_headings >= 5 and len(locations) >= 5:
            clear = True

        return {
            "clear": clear,
            "scene_headings": scene_headings,
            "locations": locations
        }

