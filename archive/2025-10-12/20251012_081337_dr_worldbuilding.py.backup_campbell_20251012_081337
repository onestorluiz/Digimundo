    def _calculate_overall_worldbuilding_quality(self, profile: WorldProfile) -> float:
        """Calculate overall worldbuilding quality score."""
        scores = [
            1.0 if profile.world_established else 0.3,
            1.0 if profile.setting_clear else 0.4,
            profile.setting_consistency,
            1.0 if profile.world_rules_defined else 0.5,
            1.0 if profile.world_rules_consistent else 0.4,
            1.0 if profile.geography_clear else 0.6,
            1.0 if profile.time_period_established else 0.5,
            1.0 if profile.culture_society_rules else 0.7,
            1.0 if profile.technology_level_consistent else 0.8,
            1.0 if profile.magic_system_rules else 0.9,  # Not always applicable
            profile.visual_worldbuilding_score,
            profile.sensory_details_score,
            1.0 if profile.world_unique else 0.5,
            1.0 if profile.world_coherent else 0.3,
            0.0 if profile.confusing_world_detected else 1.0,  # PENALTY
            0.0 if profile.inconsistent_rules_detected else 1.0,  # PENALTY
            0.0 if profile.generic_world_detected else 1.0  # PENALTY
        ]

        # Average
        overall = sum(scores) / len(scores)

        return max(0.0, min(1.0, overall))

    def _check_worldbuilding_rules(self, profile: WorldProfile, world_established: Dict,
                                  setting_clear: Dict, setting_consistency: Dict,
                                  world_rules: Dict, rules_consistency: Dict,
                                  geography: Dict, time_period: Dict, culture: Dict,
                                  technology: Dict, magic: Dict,
                                  visual_worldbuilding: Dict, sensory_details: Dict,
                                  world_uniqueness: Dict, confusing_world: Dict,
                                  inconsistent_rules: Dict, generic_world: Dict) -> List[Dict]:
        """Check worldbuilding against rules."""
        violations = []

        for rule in self.rules.get("rules", []):
            if rule["id"] == "WORLD.R001":
                # World Established in Opening
                if not profile.world_established:
                    violations.append({
                        "rule_id": rule["id"],
                        "title": rule["title"],
                        "severity": rule["severity"],
                        "message": "World not established in opening pages",
                        "fix": rule["fix"]
                    })

            elif rule["id"] == "WORLD.R002":
                # Setting Clear and Specific
                if not profile.setting_clear:
                    violations.append({
                        "rule_id": rule["id"],
                        "title": rule["title"],
                        "severity": rule["severity"],
                        "message": "Setting not clear and specific",
                        "fix": rule["fix"]
                    })

            elif rule["id"] == "WORLD.R003":
                # Setting Consistency
                if profile.setting_consistency < 0.6:
                    violations.append({
                        "rule_id": rule["id"],
                        "title": rule["title"],
                        "severity": rule["severity"],
                        "message": f"Setting consistency low ({profile.setting_consistency:.1f}/1.0)",
                        "fix": rule["fix"]
                    })

            elif rule["id"] == "WORLD.R004":
                # World Rules Defined
                if not profile.world_rules_defined:
                    violations.append({
                        "rule_id": rule["id"],
                        "title": rule["title"],
                        "severity": rule["severity"],
                        "message": "World rules not defined (critical for genre stories)",
                        "fix": rule["fix"]
                    })

            elif rule["id"] == "WORLD.R005":
                # World Rules Consistent
                if not profile.world_rules_consistent:
                    violations.append({
                        "rule_id": rule["id"],
                        "title": rule["title"],
                        "severity": rule["severity"],
                        "message": "World rules inconsistent - contradictions detected",
                        "fix": rule["fix"]
                    })

            elif rule["id"] == "WORLD.R006":
                # Geography Clear
                if not profile.geography_clear:
                    violations.append({
                        "rule_id": rule["id"],
                        "title": rule["title"],
                        "severity": rule["severity"],
                        "message": "Geography unclear - spatial relationships confusing",
                        "fix": rule["fix"]
                    })

            elif rule["id"] == "WORLD.R007":
                # Time Period Established
                if not profile.time_period_established:
                    violations.append({
                        "rule_id": rule["id"],
                        "title": rule["title"],
                        "severity": rule["severity"],
                        "message": "Time period not established",
                        "fix": rule["fix"]
                    })

            elif rule["id"] == "WORLD.R008":
                # Culture/Society Rules
                if not profile.culture_society_rules:
                    violations.append({
                        "rule_id": rule["id"],
                        "title": rule["title"],
                        "severity": rule["severity"],
                        "message": "Culture/society rules not defined",
                        "fix": rule["fix"]
                    })

            elif rule["id"] == "WORLD.R009":
                # Visual Worldbuilding
                if profile.visual_worldbuilding_score < 0.5:
                    violations.append({
                        "rule_id": rule["id"],
                        "title": rule["title"],
                        "severity": rule["severity"],
                        "message": f"Visual worldbuilding weak ({profile.visual_worldbuilding_score:.1f}/1.0)",
                        "fix": rule["fix"]
                    })

            elif rule["id"] == "WORLD.R010":
                # Sensory Details
                if profile.sensory_details_score < 0.5:
                    violations.append({
                        "rule_id": rule["id"],
                        "title": rule["title"],
                        "severity": rule["severity"],
                        "message": f"Sensory details insufficient ({profile.sensory_details_score:.1f}/1.0)",
                        "fix": rule["fix"]
                    })

            elif rule["id"] == "WORLD.R011":
                # World Coherent
                if not profile.world_coherent:
