                    })

        return violations

    def _calculate_worldbuilding_score(self, profile: WorldProfile, violations: List) -> float:
        """Calculate overall worldbuilding score."""
        # Start at 90
        score = 90.0

        # Deduct for violations
        for violation in violations:
            if violation["severity"] == "critical":
                score -= 20
            elif violation["severity"] == "high":
                score -= 15
            elif violation["severity"] == "medium":
                score -= 8
            elif violation["severity"] == "low":
                score -= 5

        # Extra penalty for major issues
        if profile.confusing_world_detected:
            score -= 25  # critical penalty
        if profile.inconsistent_rules_detected:
            score -= 20  # major penalty
        if profile.generic_world_detected:
            score -= 15

        # Bonus for excellence
        if profile.overall_worldbuilding_quality > 0.85:
            score += 5
        elif profile.overall_worldbuilding_quality > 0.75:
            score += 3

        if profile.world_established and profile.setting_clear:
            score += 3

        if profile.world_unique:
            score += 3

        if profile.visual_worldbuilding_score > 0.8:
            score += 2

        if profile.sensory_details_score > 0.8:
            score += 2

        # Cap at 95
        return max(5.0, min(95.0, score))

    def _generate_diagnosis(self, score: float, profile: WorldProfile,
                          violations: List) -> str:
        """Generate worldbuilding diagnosis summary."""
        if score >= 80:
            level = "EXCELLENT"
            summary = "Worldbuilding rich and immersive with clear rules"
        elif score >= 60:
            level = "GOOD"
            summary = "Worldbuilding solid but could be more detailed"
        elif score >= 40:
            level = "NEEDS WORK"
            summary = "Worldbuilding problems - unclear or inconsistent"
        else:
            level = "POOR"
            summary = "Major worldbuilding problems - confusing or generic"

        diagnosis = f"WORLDBUILDING {level} ({score:.1f}/100): {summary}"

        # Add specific issues
        issues = []
        if not profile.world_established:
            issues.append("world unclear")
        if not profile.setting_clear:
            issues.append("setting vague")
        if profile.confusing_world_detected:
            issues.append("confusing")
        if profile.inconsistent_rules_detected:
            issues.append("inconsistent")
        if profile.generic_world_detected:
            issues.append("generic")
        if not profile.world_coherent:
            issues.append("incoherent")

        if issues:
            diagnosis += f". Key issues: {', '.join(issues)}"

        return diagnosis

    def _generate_recommendations(self, score: float, violations: List,
                                 profile: WorldProfile) -> List[str]:
        """Generate specific worldbuilding recommendations."""
        recommendations = []

        # Add recommendations based on violations
        for violation in violations[:3]:
            recommendations.append(f"[{violation['severity'].upper()}] {violation['fix']}")

        # Add specific recommendations
        if not profile.world_established:
            recommendations.append("Establish world in opening - McKee/Field: 'First 10 pages establish where we are' - show setting, rules, time period")

        if not profile.setting_clear:
            recommendations.append("Clarify setting - Field: 'Every scene needs specific location' - use INT./EXT. headings, describe locations")

        if profile.confusing_world_detected:
            recommendations.append("Clarify world rules - Truby: 'World rules must be clear' - explain how world works, what's possible/impossible")

        if profile.inconsistent_rules_detected:
            recommendations.append("Fix inconsistencies - McKee: 'World must be internally consistent' - track world rules, eliminate contradictions")

        if profile.generic_world_detected:
            recommendations.append("Add uniqueness - McKee: 'Distinctive world engages audience' - find fresh angle on familiar settings")

        if profile.visual_worldbuilding_score < 0.5:
            recommendations.append("Add visual details - Seger: 'Show don't tell worldbuilding' - describe what we see, avoid exposition")

        # General excellence recommendations
        if score < 40:
            recommendations.append("Study McKee's Story - worldbuilding and setting design fundamental")
            recommendations.append("Study Truby's Anatomy - world rules and genre expectations critical")

        return recommendations[:5]

    def export_worldbuilding_features(self, screenplay_text: str) -> Dict[str, Any]:
        """
        Export worldbuilding features for correlation/analysis.

        Returns structured data with worldbuilding metrics.
        """
        page_count = self._estimate_page_count(screenplay_text)
        opening_text = self._extract_pages(screenplay_text, 0, 10)
        world_established = self._detect_world_established(opening_text)
        scenes = self._extract_scenes(screenplay_text)
        setting_clear = self._analyze_setting_clear(screenplay_text, scenes)

        return {
            "world": {
                "established": world_established["established"],
                "setting_clear": setting_clear["clear"],
                "locations_count": len(setting_clear["locations"])
            },
            "meta": {
                "source": "DrWorldbuilding",
                "focus": "Worldbuilding clarity and consistency"
            }
        }


