    def _detect_abrupt_ending(self, resolution_detection: Dict, page_count: int) -> Dict[str, Any]:
        """
        Detect abrupt ending (PENALTY).

        Abrupt ending = too sudden, not enough resolution time.
        """
        detected = False
        penalty = False

        resolution_length = resolution_detection["length"]

        # If resolution is too short (<2 pages), it's abrupt
        if resolution_length <= 2:
            detected = True
            penalty = True

        return {
            "detected": detected,
            "penalty": penalty,
            "length": resolution_length
        }

    def _detect_unresolved_threads(self, resolution_text: str) -> Dict[str, Any]:
        """
        Detect unresolved threads (PENALTY).

        Unresolved threads = loose ends remain, questions unanswered.
        """
        detected = False
        penalty = False

        # Check for unresolved thread markers
        unresolved_count = 0
        for marker in self.unresolved_threads_markers:
            unresolved_count += resolution_text.lower().count(marker)

        if unresolved_count >= 2:
            detected = True
            penalty = True
        elif unresolved_count >= 1:
            detected = True
            penalty = True

        return {
            "detected": detected,
            "penalty": penalty,
            "unresolved_count": unresolved_count
        }

    def _detect_dragging_resolution(self, resolution_detection: Dict, page_count: int) -> Dict[str, Any]:
        """
        Detect dragging resolution (PENALTY).

        Dragging resolution = too long, overstays welcome (Goldman).
        """
        detected = False
        penalty = False

        resolution_length = resolution_detection["length"]

        # If resolution is too long (>15 pages), it's dragging
        if resolution_length > 15:
            detected = True
            penalty = True

        return {
            "detected": detected,
            "penalty": penalty,
            "length": resolution_length
        }

    def _assess_resolution_completeness(self, threads_closed: Dict,
                                       character_fates: Dict, loose_ends: Dict) -> float:
        """Assess resolution completeness (0-1)."""
        scores = [
            1.0 if threads_closed["closed"] else 0.3,
            1.0 if character_fates["resolved"] else 0.2,
            1.0 if character_fates["protagonist_clear"] else 0.3,
            1.0 if character_fates["antagonist_clear"] else 0.5,
            1.0 if loose_ends["addressed"] else 0.4
        ]

        return sum(scores) / len(scores)

    def _assess_resolution_satisfaction(self, emotional_satisfaction: Dict,
                                       catharsis: Dict, hope_wisdom: Dict,
                                       theme_reinforcement: Dict) -> float:
        """Assess resolution satisfaction (0-1)."""
        scores = [
            1.0 if emotional_satisfaction["achieved"] else 0.4,
            1.0 if catharsis["delivered"] else 0.5,
            1.0 if hope_wisdom["present"] else 0.6,
            1.0 if theme_reinforcement["reinforced"] else 0.7
        ]

        return sum(scores) / len(scores)

    def _calculate_overall_resolution_quality(self, profile: ResolutionProfile) -> float:
        """Calculate overall resolution quality score."""
        scores = [
            1.0 if profile.resolution_present else 0.0,
            1.0 if profile.all_threads_closed else 0.4,
            1.0 if profile.character_fates_resolved else 0.3,
            1.0 if profile.protagonist_fate_clear else 0.4,
            1.0 if profile.antagonist_fate_clear else 0.6,
            1.0 if profile.theme_reinforced_at_resolution else 0.7,
            1.0 if profile.emotional_satisfaction_achieved else 0.5,
            1.0 if profile.new_equilibrium_established else 0.6,
            1.0 if profile.loose_ends_addressed else 0.5,
            1.0 if profile.final_image_effective else 0.7,
            1.0 if profile.denouement_pacing == "appropriate" else 0.5,
            1.0 if profile.catharsis_delivered else 0.6,
            1.0 if profile.hope_or_wisdom_present else 0.7,
            1.0 if profile.callbacks_to_setup else 0.8,
            0.0 if profile.abrupt_ending_detected else 1.0,  # PENALTY
            0.0 if profile.unresolved_threads_detected else 1.0,  # PENALTY
            0.0 if profile.dragging_resolution_detected else 1.0,  # PENALTY
            profile.resolution_completeness,
            profile.resolution_satisfaction
        ]

        # Average
        overall = sum(scores) / len(scores)

        return max(0.0, min(1.0, overall))

    def _check_resolution_rules(self, profile: ResolutionProfile, resolution_detection: Dict,
                               threads_closed: Dict, character_fates: Dict,
                               theme_reinforcement: Dict, emotional_satisfaction: Dict,
                               new_equilibrium: Dict, loose_ends: Dict,
                               final_image: Dict, denouement_pacing: Dict,
                               catharsis: Dict, hope_wisdom: Dict, callbacks: Dict,
                               abrupt_ending: Dict, unresolved_threads: Dict,
                               dragging_resolution: Dict) -> List[Dict]:
        """Check resolution against rules."""
        violations = []

        for rule in self.rules.get("rules", []):
            if rule["id"] == "RESOLUTION.R001":
                # Resolution Present
                if not profile.resolution_present:
                    violations.append({
                        "rule_id": rule["id"],
                        "title": rule["title"],
                        "severity": rule["severity"],
                        "message": "No clear resolution detected",
                        "fix": rule["fix"]
                    })

            elif rule["id"] == "RESOLUTION.R002":
                # All Threads Closed
                if not profile.all_threads_closed:
                    violations.append({
                        "rule_id": rule["id"],
                        "title": rule["title"],
                        "severity": rule["severity"],
                        "message": f"Not all threads closed - {profile.open_threads_count} loose ends remain",
                        "fix": rule["fix"]
                    })

            elif rule["id"] == "RESOLUTION.R003":
                # Character Fates Resolved
                if not profile.character_fates_resolved:
                    violations.append({
                        "rule_id": rule["id"],
                        "title": rule["title"],
                        "severity": rule["severity"],
                        "message": "Character fates not clear",
                        "fix": rule["fix"]
                    })

            elif rule["id"] == "RESOLUTION.R004":
                # Theme Reinforced
                if not profile.theme_reinforced_at_resolution:
                    violations.append({
                        "rule_id": rule["id"],
                        "title": rule["title"],
                        "severity": rule["severity"],
                        "message": "Theme not reinforced at resolution",
                        "fix": rule["fix"]
                    })

            elif rule["id"] == "RESOLUTION.R005":
                # Emotional Satisfaction
                if not profile.emotional_satisfaction_achieved:
                    violations.append({
                        "rule_id": rule["id"],
                        "title": rule["title"],
                        "severity": rule["severity"],
                        "message": "Emotional satisfaction not achieved",
                        "fix": rule["fix"]
                    })

            elif rule["id"] == "RESOLUTION.R006":
                # New Equilibrium
                if not profile.new_equilibrium_established:
                    violations.append({
                        "rule_id": rule["id"],
                        "title": rule["title"],
                        "severity": rule["severity"],
                        "message": "New equilibrium not established",
                        "fix": rule["fix"]
                    })

            elif rule["id"] == "RESOLUTION.R007":
                # Loose Ends Addressed
                if not profile.loose_ends_addressed:
                    violations.append({
                        "rule_id": rule["id"],
                        "title": rule["title"],
                        "severity": rule["severity"],
                        "message": "Loose ends not addressed",
                        "fix": rule["fix"]
                    })

            elif rule["id"] == "RESOLUTION.R008":
                # Final Image Effective
                if not profile.final_image_effective:
                    violations.append({
                        "rule_id": rule["id"],
                        "title": rule["title"],
                        "severity": rule["severity"],
                        "message": "Final image not effective - doesn't bookend opening",
                        "fix": rule["fix"]
                    })

            elif rule["id"] == "RESOLUTION.R009":
                # Denouement Pacing
                if profile.denouement_pacing == "too_fast" or profile.denouement_pacing == "dragging":
                    violations.append({
                        "rule_id": rule["id"],
                        "title": rule["title"],
                        "severity": rule["severity"],
                        "message": f"Denouement pacing: {profile.denouement_pacing}",
                        "fix": rule["fix"]
                    })

            elif rule["id"] == "RESOLUTION.R010":
                # Catharsis Delivered
                if not profile.catharsis_delivered:
                    violations.append({
                        "rule_id": rule["id"],
                        "title": rule["title"],
                        "severity": rule["severity"],
                        "message": "Catharsis not delivered - lacks emotional release",
                        "fix": rule["fix"]
                    })

            elif rule["id"] == "RESOLUTION.R011":
                # Avoid Abrupt Ending
                if profile.abrupt_ending_detected:
                    violations.append({
                        "rule_id": rule["id"],
                        "title": rule["title"],
                        "severity": rule["severity"],
                        "message": "Abrupt ending - too sudden, insufficient resolution",
                        "fix": rule["fix"]
                    })

            elif rule["id"] == "RESOLUTION.R012":
                # Avoid Unresolved Threads
                if profile.unresolved_threads_detected:
                    violations.append({
                        "rule_id": rule["id"],
                        "title": rule["title"],
                        "severity": rule["severity"],
                        "message": "Unresolved threads - loose ends remain",
                        "fix": rule["fix"]
                    })

            elif rule["id"] == "RESOLUTION.R013":
                # Avoid Dragging Resolution
                if profile.dragging_resolution_detected:
                    violations.append({
                        "rule_id": rule["id"],
                        "title": rule["title"],
                        "severity": rule["severity"],
                        "message": "Dragging resolution - overstays welcome",
                        "fix": rule["fix"]
                    })

            elif rule["id"] == "RESOLUTION.R014":
                # Hope or Wisdom Present
                if not profile.hope_or_wisdom_present:
                    violations.append({
                        "rule_id": rule["id"],
                        "title": rule["title"],
                        "severity": rule["severity"],
                        "message": "No hope or wisdom - story leaves audience empty",
                        "fix": rule["fix"]
                    })

            elif rule["id"] == "RESOLUTION.R015":
                # Resolution Completeness
                if profile.resolution_completeness < 0.6:
                    violations.append({
                        "rule_id": rule["id"],
                        "title": rule["title"],
                        "severity": rule["severity"],
                        "message": f"Insufficient resolution completeness ({profile.resolution_completeness:.1f}/1.0)",
                        "fix": rule["fix"]
                    })

        return violations

    def _calculate_resolution_score(self, profile: ResolutionProfile, violations: List) -> float:
        """Calculate overall resolution score."""
        # Start at 90
        score = 90.0

        # Deduct for violations
        for violation in violations:
            if violation["severity"] == "critical":
                score -= 20
            elif violation["severity"] == "high":
                score -= 15
            elif violation["severity"] == "medium":
                score -= 8
            elif violation["severity"] == "low":
                score -= 5

        # Extra penalty for major issues
        if profile.abrupt_ending_detected:
            score -= 25  # critical penalty
        if profile.unresolved_threads_detected:
            score -= 20  # major penalty
        if profile.dragging_resolution_detected:
            score -= 15

        # Bonus for excellence
        if profile.overall_resolution_quality > 0.85:
            score += 5
        elif profile.overall_resolution_quality > 0.75:
            score += 3

        if profile.all_threads_closed and profile.character_fates_resolved:
            score += 3

        if profile.theme_reinforced_at_resolution:
            score += 3

        if profile.emotional_satisfaction_achieved:
            score += 2

        if profile.final_image_effective:
            score += 2

        # Cap at 95
        return max(5.0, min(95.0, score))

    def _generate_diagnosis(self, score: float, profile: ResolutionProfile,
                          violations: List) -> str:
        """Generate resolution diagnosis summary."""
        if score >= 80:
            level = "EXCELLENT"
            summary = "Resolution delivers complete closure with emotional satisfaction"
        elif score >= 60:
            level = "GOOD"
            summary = "Resolution solid but could be more complete"
        elif score >= 40:
            level = "NEEDS WORK"
            summary = "Resolution problems - incomplete or unsatisfying"
        else:
            level = "POOR"
            summary = "Major resolution problems - fails to deliver closure"

        diagnosis = f"RESOLUTION {level} ({score:.1f}/100): {summary}"

        # Add specific issues
        issues = []
        if not profile.resolution_present:
            issues.append("no resolution")
        if not profile.all_threads_closed:
            issues.append("loose ends")
        if profile.abrupt_ending_detected:
            issues.append("abrupt ending")
        if profile.unresolved_threads_detected:
            issues.append("unresolved threads")
        if profile.dragging_resolution_detected:
            issues.append("dragging")
        if not profile.emotional_satisfaction_achieved:
            issues.append("unsatisfying")

        if issues:
            diagnosis += f". Key issues: {', '.join(issues)}"

        return diagnosis

    def _generate_recommendations(self, score: float, violations: List,
                                 profile: ResolutionProfile) -> List[str]:
        """Generate specific resolution recommendations."""
        recommendations = []

        # Add recommendations based on violations
        for violation in violations[:3]:
            recommendations.append(f"[{violation['severity'].upper()}] {violation['fix']}")

        # Add specific recommendations
        if not profile.resolution_present:
            recommendations.append("Add clear resolution - McKee/Field: 'Resolution ties up all story threads' - show consequences of climax, character fates")

        if not profile.all_threads_closed:
            recommendations.append("Close all threads - Seger: 'Address all loose ends' - every setup needs payoff, every question answered")

        if profile.abrupt_ending_detected:
            recommendations.append("Lengthen resolution - Goldman: 'End quickly but not abruptly' - give 3-5 pages for consequences to play out")

        if profile.unresolved_threads_detected:
            recommendations.append("Resolve hanging threads - McKee: 'All story threads must be closed' - identify unanswered questions and address them")

        if profile.dragging_resolution_detected:
            recommendations.append("Shorten resolution - Goldman: 'Don't overstay welcome' - end within 5-10 pages after climax, avoid multiple endings")

        if not profile.emotional_satisfaction_achieved:
            recommendations.append("Add emotional satisfaction - Aristotle: 'Resolution provides catharsis' - deliver emotional payoff, leave audience fulfilled")

        # General excellence recommendations
        if score < 40:
            recommendations.append("Study McKee's Story - resolution structure and emotional satisfaction fundamental")
            recommendations.append("Study Snyder's Save the Cat - final image bookending opening image technique")

        return recommendations[:5]

    def export_resolution_features(self, screenplay_text: str) -> Dict[str, Any]:
        """
        Export resolution features for correlation/analysis.

        Returns structured data with resolution metrics.
        """
        page_count = self._estimate_page_count(screenplay_text)
        resolution_detection = self._detect_resolution(screenplay_text, page_count)
        resolution_text = self._extract_pages(screenplay_text, int(page_count * 0.90), page_count)
        threads_closed = self._analyze_threads_closed(resolution_text)
        character_fates = self._analyze_character_fates(resolution_text)

        return {
            "resolution": {
                "present": resolution_detection["present"],
                "page": resolution_detection["page"],
                "length": resolution_detection["length"]
            },
            "threads_closed": {
                "closed": threads_closed["closed"],
                "open_count": threads_closed["open_count"]
            },
            "character_fates": {
                "resolved": character_fates["resolved"],
                "protagonist_clear": character_fates["protagonist_clear"],
                "antagonist_clear": character_fates["antagonist_clear"]
            },
            "meta": {
                "source": "DrResolution",
                "focus": "Resolution completeness and emotional satisfaction"
            }
        }


