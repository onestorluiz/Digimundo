        present = False
        page = 0
        length = 0
        description = ""

        # Expected resolution range: pages 90-100% of script (after climax 85-95%)
        expected_start = int(page_count * 0.90)
        expected_end = page_count

        # Extract final pages
        final_text = self._extract_pages(screenplay, expected_start, page_count)

        # Check for resolution markers
        resolution_count = 0
        for marker in self.resolution_markers:
            if marker in final_text.lower():
                resolution_count += 1
                present = True
                if not description:
                    for line in final_text.split('\n'):
                        if marker in line.lower():
                            description = line.strip()[:200]
                            break

        # If resolution markers found, estimate details
        if present:
            page = expected_start
            length = page_count - expected_start
        else:
            # Assume minimal resolution at end
            present = True  # Always assume some resolution exists
            page = page_count - 3
            length = 3
            description = "Minimal or implicit resolution detected"

        return {
            "present": present,
            "page": page,
            "length": length,
            "description": description or "Resolution detected in final pages",
            "resolution_count": resolution_count
        }

    def _analyze_threads_closed(self, resolution_text: str) -> Dict[str, Any]:
        """
        Analyze if all threads closed.

        McKee/Seger: "All story threads must be closed - no loose ends."
        """
        closed = False
        open_count = 0

        # Check for threads closed markers
        closed_count = 0
        for marker in self.threads_closed_markers:
            closed_count += resolution_text.lower().count(marker)

        # Check for unresolved thread markers
        for marker in self.unresolved_threads_markers:
            open_count += resolution_text.lower().count(marker)

        # If more closures than open threads
        if closed_count >= 2 and open_count == 0:
            closed = True
        elif closed_count >= 1 and open_count == 0:
            closed = True
        elif open_count > 0:
            closed = False
        else:
            # Neutral - assume partial closure
            closed = False

        return {
            "closed": closed,
            "open_count": open_count,
            "closed_count": closed_count
        }

    def _analyze_character_fates(self, resolution_text: str) -> Dict[str, Any]:
        """
        Analyze character fates resolved.

        McKee/Field: "Protagonist and antagonist fates must be clear."
        """
        resolved = False
        protagonist_clear = False
        antagonist_clear = False

        # Check for character fate markers (general)
        fate_count = 0
        for marker in self.character_fate_markers:
            fate_count += resolution_text.lower().count(marker)

        # Check protagonist fate markers
        protagonist_count = 0
        for marker in self.protagonist_fate_clear_markers:
            protagonist_count += resolution_text.lower().count(marker)

        # Check antagonist fate markers
        antagonist_count = 0
        for marker in self.antagonist_fate_clear_markers:
            antagonist_count += resolution_text.lower().count(marker)

        if protagonist_count >= 1:
            protagonist_clear = True
        if antagonist_count >= 1:
            antagonist_clear = True

        if protagonist_clear and antagonist_clear:
            resolved = True
        elif protagonist_clear:
            resolved = True  # At minimum protagonist fate must be clear

        return {
            "resolved": resolved,
            "protagonist_clear": protagonist_clear,
            "antagonist_clear": antagonist_clear,
            "fate_count": fate_count
        }

