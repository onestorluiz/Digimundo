        """
        effective = False

        # Check for final image markers
        final_image_count = 0
        for marker in self.final_image_markers:
            final_image_count += resolution_text.lower().count(marker)

        # Extract opening image text (first 3 pages)
        opening_text = self._extract_pages(screenplay, 0, 3)

        # Check for callback/bookend patterns between opening and final
        callback_words = ["opening", "beginning", "first", "started", "mirrors", "contrast", "transformation"]
        callback_count = 0
        for word in callback_words:
            if word in resolution_text.lower():
                callback_count += 1

        if final_image_count >= 1 or callback_count >= 2:
            effective = True

        return {
