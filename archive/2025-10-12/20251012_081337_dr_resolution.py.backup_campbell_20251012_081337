    def _analyze_denouement_pacing(self, resolution_detection: Dict, page_count: int) -> Dict[str, Any]:
        """
        Analyze denouement pacing.

        Goldman: "End quickly - don't overstay welcome. 3-5 pages after climax ideal."
        """
        pacing = "appropriate"

        if not resolution_detection["present"]:
            return {"pacing": "none"}

        resolution_length = resolution_detection["length"]

        # Ideal resolution length: 3-10 pages (after climax)
        if resolution_length <= 2:
            pacing = "too_fast"
        elif 3 <= resolution_length <= 10:
            pacing = "appropriate"
        elif 11 <= resolution_length <= 15:
            pacing = "acceptable"
        else:
            pacing = "dragging"

        return {
            "pacing": pacing,
            "length": resolution_length
        }

