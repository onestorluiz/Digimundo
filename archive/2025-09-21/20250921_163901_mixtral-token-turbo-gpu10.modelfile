# TEST: GPU 10 - FORCE CPU USAGE
FROM mixtral-dedicated-q5:latest

PARAMETER num_ctx 200000
PARAMETER num_batch 1024
PARAMETER num_keep 2048
PARAMETER num_thread 28
PARAMETER num_gpu 10
PARAMETER use_mmap true
PARAMETER temperature 0.3
PARAMETER top_p 0.9
PARAMETER top_k 40
PARAMETER repeat_penalty 1.05
PARAMETER seed 42