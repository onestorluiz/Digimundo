class TrainingMode(Enum):
    """Training distribution strategies"""
    DATA_PARALLEL = auto()
    MODEL_PARALLEL = auto()
    PIPELINE_PARALLEL = auto()
    FEDERATED = auto()
    QUANTUM_ENHANCED = auto()
    NEUROMORPHIC = auto()
    ENSEMBLE = auto()
    HYBRID = auto()

class DeviceType(Enum):
    """Available compute devices"""
    CPU = auto()
    GPU = auto()
    NEURAL_ENGINE = auto()
    QUANTUM_PROCESSOR = auto()
    DISTRIBUTED_CLUSTER = auto()

class OptimizerType(Enum):
    """Optimization algorithms"""
    SGD = auto()
    ADAM = auto()
    RMSPROP = auto()
    ADAGRAD = auto()
    QUANTUM_NATURAL_GRADIENT = auto()
    EVOLUTIONARY = auto()
    SWARM = auto()
