@dataclass
class TrainingConfig:
    """Configuration for distributed training"""
    model_name: str = 'script_doctor_ultimate'
    batch_size: int = 32
    learning_rate: float = 0.001
    epochs: int = 100
    gradient_accumulation_steps: int = 4
    mixed_precision: bool = True
    checkpoint_interval: int = 10
    validation_interval: int = 5
    training_mode: TrainingMode = TrainingMode.HYBRID
    num_workers: int = MAX_WORKERS
    devices: List[DeviceType] = field(default_factory=lambda: [DeviceType.CPU, DeviceType.GPU, DeviceType.NEURAL_ENGINE])
    optimizer: OptimizerType = OptimizerType.ADAM
    scheduler: str = 'cosine_annealing'
    warmup_steps: int = 1000
    gradient_clip_norm: float = 1.0
    gradient_checkpointing: bool = True
    offload_to_disk: bool = True
    compression_ratio: float = 0.5
    quantum_enhancement: bool = True
    federated_aggregation: str = 'secure_avg'
    differential_privacy: bool = True
    epsilon: float = 1.0
    checkpoint_dir: Path = OUTPUT_DIR / 'checkpoints'
    tensorboard_dir: Path = OUTPUT_DIR / 'tensorboard'
    model_dir: Path = OUTPUT_DIR / 'models'

@dataclass
class TrainingMetrics:
    """Metrics for training monitoring"""
    epoch: int
