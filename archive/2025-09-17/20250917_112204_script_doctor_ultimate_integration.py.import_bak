    async def analyze_ultimate(self, script_path: Path, depth: str='transcendent', techniques: List[str]=None) -> UltimateAnalysisResult:
        """
        Análise Ultimate combinando todas as técnicas avançadas
        """
        if techniques is None:
            techniques = ['hierarchical', 'beat_detection', 'chain_of_thought', 'multi_agent', 'emotional']
        start_time = asyncio.get_event_loop().time()
        script_title = script_path.stem
        print(f'\n🎬 Ultimate Analysis: {script_title}')
        print(f'   Depth: {depth}')
        print(f"   Techniques: {', '.join(techniques)}")
        script_content = await self._extract_script_smart(script_path)
        if not script_content:
            print('❌ Failed to extract script content')
            return self._create_empty_result(script_title)
        if self.memory_harmony:
            self.memory_harmony.store(f'ultimate_analysis_{script_title}', script_content, layer=MemoryLayer.L0_QUANTUM, importance=1.0)
        if self.producermon:
            thought = self.producermon.think(f'Ultimate analysis of {script_title}')
            if thought.confidence > 0.8:
                self.producermon.execute_thought(thought)
        results = {'hierarchical_analysis': {}, 'beat_analysis': [], 'cot_analysis': {}, 'multi_agent_analysis': {}, 'emotional_arcs': {}}
        models_used = []
        tasks = []
        if 'hierarchical' in techniques:
            print('  📊 Running hierarchical analysis...')
            task = self._run_hierarchical_analysis(script_content)
            tasks.append(('hierarchical', task))
        if 'multi_agent' in techniques:
            print('  👥 Running multi-agent analysis...')
            task = self._run_multi_agent_analysis(script_content)
            tasks.append(('multi_agent', task))
        if tasks:
            parallel_results = await asyncio.gather(*[task for _, task in tasks])
            for (technique, _), result in zip(tasks, parallel_results):
                results[f'{technique}_analysis'] = result
                models_used.extend(result.get('models_used', []))
        if 'beat_detection' in techniques:
            print('  🎯 Running beat detection...')
            results['beat_analysis'] = await self._run_beat_detection(script_content)
        if 'chain_of_thought' in techniques:
            print('  🧠 Running chain-of-thought analysis...')
            results['cot_analysis'] = await self._run_cot_analysis(script_content)
        if 'emotional' in techniques:
            print('  💝 Running emotional arc analysis...')
            results['emotional_arcs'] = await self._run_emotional_analysis(script_content)
        if 'consciousness' in techniques:
            print('  🧠 Running autonomous consciousness analysis...')
            results['consciousness_analysis'] = await self._run_consciousness_analysis(script_content)
        if 'character_network' in techniques:
            print('  🕸️ Running character network analysis...')
            results['character_network'] = await self._run_character_network_analysis(script_content)
        if 'pacing' in techniques:
            print('  ⏱️ Running pacing analysis...')
            results['pacing_analysis'] = await self._run_pacing_analysis(script_content)
        if 'cliche_detection' in techniques:
            print('  🎭 Running cliche detection...')
            results['cliche_detection'] = await self._run_cliche_detection(script_content)
        scores = self._calculate_ultimate_scores(results)
        priority_fixes = await self._generate_priority_fixes(results, script_content)
        comparable_films = await self._find_comparable_films(results)
        processing_time = asyncio.get_event_loop().time() - start_time
        ultimate_result = UltimateAnalysisResult(script_title=script_title, analysis_timestamp=datetime.now(), hierarchical_analysis=results['hierarchical_analysis'], beat_analysis=results['beat_analysis'], cot_analysis=results['cot_analysis'], multi_agent_analysis=results['multi_agent_analysis'], emotional_arcs=results['emotional_arcs'], overall_score=scores['overall'], structural_score=scores['structural'], character_score=scores['character'], dialogue_score=scores['dialogue'], market_score=scores['market'], priority_fixes=priority_fixes, strengths=results.get('strengths', []), comparable_films=comparable_films, processing_time=processing_time, models_used=list(set(models_used)), harmony_score=self.memory_harmony.metrics['harmony_score'] if self.memory_harmony else 1.0)
        await self._save_ultimate_analysis(ultimate_result)
        self._update_stats(ultimate_result, techniques)
        if self.memory_harmony:
            await self.memory_harmony.harmonize()
        print(f'\n✅ Ultimate analysis complete!')
        print(f"   Overall Score: {scores['overall']:.1f}/10")
        print(f'   Processing Time: {processing_time:.1f}s')
        print(f'   Harmony Score: {ultimate_result.harmony_score:.0%}')
        return ultimate_result

    def _extract_script_smart(self, script_path: Path) -> Optional[str]:
        """Extração inteligente usando Cinema Analyzer se disponível"""
        if self.cinema_analyzer:
            content = self.cinema_analyzer.extract_pdf_content_advanced(script_path)
            return content.get('text', '')
        else:
            try:
                import pdfplumber
                with pdfplumber.open(script_path) as pdf:
                    text_parts = []
                    for i, page in enumerate(pdf.pages[:30]):
                        page_text = page.extract_text()
                        if page_text:
                            text_parts.append(page_text)
                    return '\n'.join(text_parts)
            except Exception as e:
                print(f'Extraction error: {e}')
                return None

