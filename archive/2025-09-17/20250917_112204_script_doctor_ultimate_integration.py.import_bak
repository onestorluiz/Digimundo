    def _run_cliche_detection(self, script_content: str) -> Dict[str, Any]:
        """Run cliche detection analysis"""
        try:
            cliches = self.cliche_detector.detect_cliches(script_content)
            return {'cliche_count': len(cliches.get('detected_cliches', [])), 'cliche_types': cliches.get('cliche_types', {}), 'originality_score': cliches.get('originality_score', 0), 'detected_cliches': cliches.get('detected_cliches', []), 'creative_alternatives': cliches.get('alternatives', [])}
        except Exception as e:
            print(f'⚠️ Cliche detection error: {e}')
