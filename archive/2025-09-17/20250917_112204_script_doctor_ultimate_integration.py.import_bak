            print(f'  • {model}')
        print(f'\n📊 Analysis Statistics:')
        print(f"  • Analyses Completed: {self.stats['analyses_completed']}")
        print(f"  • Total Processing Time: {self.stats['total_processing_time']:.1f}s")
        print(f"  • Techniques Used: {', '.join(self.stats['techniques_used'])}")
        if self.stats['average_scores']:
            print(f'\n📈 Average Scores:')
            for key, score in self.stats['average_scores'].items():
                print(f'  • {key.title()}: {score:.1f}/10')
        if self.memory_harmony:
            harmony_stats = self.memory_harmony.get_statistics()
            print(f"\n🎵 Memory Harmony: {harmony_stats['harmony_score']:.0%}")
