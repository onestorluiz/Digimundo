class OllamaAdvancedClient:
    """Cliente Ollama otimizado para técnicas avançadas"""

    def __init__(self):
        self.base_url = 'http://localhost:11434'
        self.models = self._discover_models()
        self.optimized_configs = self._get_optimized_configs()

    def _discover_models(self) -> List[str]:
        """Descobre modelos disponíveis"""
        try:
            result = subprocess.run(['ollama', 'list'], capture_output=True, text=True)
            models = []
            for line in result.stdout.split('\n')[1:]:
                if line.strip():
                    model_name = line.split()[0]
                    models.append(model_name)
            return models
        except:
            return ['llama2:latest']

    def _get_optimized_configs(self) -> Dict[str, Dict]:
        """Configurações otimizadas por tipo de análise"""
        return {'hierarchical': {'temperature': 0.3, 'top_p': 0.9, 'repeat_penalty': 1.1, 'num_predict': 2048}, 'beat_detection': {'temperature': 0.2, 'top_p': 0.8, 'repeat_penalty': 1.2, 'num_predict': 1024}, 'chain_of_thought': {'temperature': 0.4, 'top_p': 0.9, 'repeat_penalty': 1.0, 'num_predict': 3072}, 'multi_agent': {'temperature': 0.3, 'top_p': 0.85, 'repeat_penalty': 1.1, 'num_predict': 1536}, 'creative': {'temperature': 0.7, 'top_p': 0.95, 'repeat_penalty': 1.0, 'num_predict': 2048}}

    async def generate(self, prompt: str, analysis_type: str='hierarchical', model: str=None) -> str:
        """Geração otimizada baseada no tipo de análise"""
        import aiohttp
        if not model:
            model = self._select_best_model(analysis_type)
        config = self.optimized_configs.get(analysis_type, self.optimized_configs['hierarchical'])
        payload = {'model': model, 'prompt': prompt, 'stream': False, 'options': config}
        try:
            async with aiohttp.ClientSession() as session:
                async with session.post(f'{self.base_url}/api/generate', json=payload) as response:
                    if response.status == 200:
                        result = await response.json()
                        return result.get('response', '')
                    else:
                        return f'Error: HTTP {response.status}'
        except Exception as e:
            return f'Error: {e}'

    def _select_best_model(self, analysis_type: str) -> str:
        """Seleciona melhor modelo para tipo de análise"""
        model_preferences = {'hierarchical': ['deepseek-r1:32b', 'deepseek-r1:7b', 'llama3.1:8b'], 'beat_detection': ['scripturemon-cpu:latest', 'producermon:latest'], 'chain_of_thought': ['deepseek-r1:7b', 'mistral:instruct'], 'multi_agent': ['llama3.1:8b', 'qwen2.5-coder:7b'], 'creative': ['llama3.2:3b', 'scripturemon-ptbr:latest']}
        preferences = model_preferences.get(analysis_type, ['llama3.1:8b'])
        for preferred in preferences:
            if preferred in self.models:
                return preferred
        return self.models[0] if self.models else 'llama2:latest'

@dataclass
class UltimateAnalysisResult:
    """Resultado completo da análise ultimate"""
    script_title: str
    analysis_timestamp: datetime
    hierarchical_analysis: Dict[str, Any]
    beat_analysis: List[Dict[str, Any]]
    cot_analysis: Dict[str, Any]
    multi_agent_analysis: Dict[str, Any]
    emotional_arcs: Dict[str, Any]
    overall_score: float
    structural_score: float
    character_score: float
    dialogue_score: float
    market_score: float
    priority_fixes: List[str]
    strengths: List[str]
    comparable_films: List[str]
    processing_time: float
    models_used: List[str]
    harmony_score: float

