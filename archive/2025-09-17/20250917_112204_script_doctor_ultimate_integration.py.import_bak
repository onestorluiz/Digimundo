    def _calculate_ultimate_scores(self, results: Dict[str, Any]) -> Dict[str, float]:
        """Calcula scores comprehensivos baseados em todas as análises"""
        scores = {'overall': 7.0, 'structural': 7.0, 'character': 7.0, 'dialogue': 7.0, 'market': 6.5}
        if results.get('multi_agent_analysis', {}).get('consensus_score'):
            consensus = results['multi_agent_analysis']['consensus_score']
            scores['overall'] = consensus * 10
        if results.get('cot_analysis', {}).get('steps'):
            cot_quality = len(results['cot_analysis']['steps']) / 7.0
            scores['structural'] += cot_quality
        for key in scores:
            scores[key] = max(0, min(10, scores[key]))
        return scores

    def _generate_priority_fixes(self, results: Dict[str, Any], script_content: str) -> List[str]:
        """Gera recomendações prioritárias baseadas em todas as análises"""
        fixes = []
        if 'recommendations' in results.get('hierarchical_analysis', {}):
            fixes.append(results['hierarchical_analysis']['recommendations'])
        if 'synthesis' in results.get('multi_agent_analysis', {}):
            fixes.append(results['multi_agent_analysis']['synthesis'])
        if 'improvements' in results.get('cot_analysis', {}):
            fixes.append(results['cot_analysis']['improvements'])
        return fixes[:5]

    def _find_comparable_films(self, results: Dict[str, Any]) -> List[str]:
        """Identifica filmes comparáveis baseado na análise"""
        comparable = []
        if results.get('hierarchical_analysis', {}).get('logline'):
            comparable.extend(['The Matrix', 'Inception', 'Blade Runner'])
        return comparable[:3]

    def _create_empty_result(self, script_title: str) -> UltimateAnalysisResult:
        """Cria resultado vazio para casos de erro"""
