    def _save_ultimate_analysis(self, result: UltimateAnalysisResult):
        """Salva análise ultimate completa"""
        timestamp = datetime.now().strftime('%Y%m%d_%H%M%S')
        filename = f'Ultimate_Analysis_{result.script_title}_{timestamp}.json'
        config = get_config()
        filepath = Path(config.get_output_path(filename, 'analysis'))
        analysis_data = {'script_title': result.script_title, 'timestamp': result.analysis_timestamp.isoformat(), 'processing_time': result.processing_time, 'harmony_score': result.harmony_score, 'scores': {'overall': result.overall_score, 'structural': result.structural_score, 'character': result.character_score, 'dialogue': result.dialogue_score, 'market': result.market_score}, 'analyses': {'hierarchical': result.hierarchical_analysis, 'beat_analysis': result.beat_analysis, 'chain_of_thought': result.cot_analysis, 'multi_agent': result.multi_agent_analysis, 'emotional_arcs': result.emotional_arcs}, 'recommendations': {'priority_fixes': result.priority_fixes, 'strengths': result.strengths, 'comparable_films': result.comparable_films}, 'metadata': {'models_used': result.models_used, 'techniques_used': list(self.stats['techniques_used'])}}
        with open(filepath, 'w') as f:
            json.dump(analysis_data, f, indent=2)
        print(f'  ✓ Ultimate analysis saved: {filename}')

    def _update_stats(self, result: UltimateAnalysisResult, techniques: List[str]):
        """Atualiza estatísticas do sistema"""
        self.stats['analyses_completed'] += 1
        self.stats['total_processing_time'] += result.processing_time
        if not self.stats['average_scores']:
            self.stats['average_scores'] = {'overall': result.overall_score, 'structural': result.structural_score, 'character': result.character_score, 'dialogue': result.dialogue_score, 'market': result.market_score}
        else:
            count = self.stats['analyses_completed']
            for key in self.stats['average_scores']:
                current_avg = self.stats['average_scores'][key]
                new_score = getattr(result, f'{key}_score')
                self.stats['average_scores'][key] = (current_avg * (count - 1) + new_score) / count

