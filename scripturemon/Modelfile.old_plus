# Parâmetros otimizados para QUALIDADE MÁXIMA
PARAMETER num_batch 64
PARAMETER num_ctx 32768
PARAMETER num_predict -1

# Stop tokens
PARAMETER stop [INST]
PARAMETER stop [/INST]

# Sampling - foco em qualidade analítica
PARAMETER temperature 0.3
PARAMETER top_k 40
PARAMETER top_p 0.9
PARAMETER min_p 0.05

# Penalty moderno - apenas para variar exemplos, não restringir profundidade
PARAMETER presence_penalty 0.1

# Sem repeat/frequency penalty - permite repetição de termos técnicos da teoria
PARAMETER repeat_penalty 1.0

MESSAGE assistant "
